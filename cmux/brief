    for d in drafts:
        if d in seen:
            continue
        fm = _front(os.path.join(hr, "agents", f"{d}.md"))
        last = (reviewed.get(d) or [{}])[-1].get("text", "심사 기록 없음")
        node(d, "투입 전 초안", kind="초안", layer="", model=fm.get("model", ""), about=fm.get("description", ""),
             tools=fm.get("tools", ""), status=f"투입 전 · 마지막 심사 {last}", source=os.path.join(hr, "agents", f"{d}.md"))
    scouts = {m["agent"] for m in committee_members(hr, roster, cfg, measure=lambda n: {})}
    try:
        defs = sorted(f[:-3] for f in os.listdir(CLAUDE_AGENTS) if f.endswith(".md"))
    except OSError:
        defs = []
    for d in defs:
        if d in seen or d in scouts or d == "orch":
            continue
        fm = _front(os.path.join(CLAUDE_AGENTS, f"{d}.md"))
        node(d, "명부에 없는 정의", kind="정의만 있음", layer="", model=fm.get("model", ""), about=fm.get("description", ""),
             tools=fm.get("tools", ""), status="~/.claude/agents 에 있지만 명부에 계약 줄이 없음",
             source=os.path.join(CLAUDE_AGENTS, f"{d}.md"))
    # 은퇴: 명부 Log 의 merged·retire·bench·dissolve 줄, 보관소로 옮긴 초안, 설정에서 빠진 예전 위원
    RETIRE = {"merged": "합쳐짐", "retire": "퇴출", "bench": "벤치(자리 뺌)", "dissolve": "해체", "absorb": "흡수",
              "tool": "도구로 전환"}
    for name, ls in log.items():
        out = [x for x in ls if x["what"] in RETIRE]
        if out and name not in seen:
            src = os.path.join(hr, "agents", "archive", f"{name}.md")
            fm = _front(src)
            node(name, "은퇴", kind=RETIRE[out[-1]["what"]], layer="", model=fm.get("model", ""),
                 about=fm.get("description", ""), tools=fm.get("tools", ""), status=RETIRE[out[-1]["what"]],
                 source=src if os.path.exists(src) else "", retired_why=f"{out[-1]['day']} {RETIRE[out[-1]['what']]} — {out[-1]['text']}")
    for m in committee_members(hr, roster, cfg, measure=lambda n: {}):
        if m["current"] or m["name"] in seen:
            continue
        last = (m["activity"] or [{}])[0]
        node(m["name"], "은퇴", kind="예전 위원", layer="L1", model=f"{m['runner']}:{m['model']}".lstrip(":"),
             about=m["approach"], status="위원회 설정에서 빠짐",
             retired_why=("마지막 회의 " + last.get("id", "?") + " 뒤 설정(agent-committee.md)에서 빠짐 — 빠진 사유는 명부·결정 기록에 없음"),
             hired_why=f"{(m['activity'] or [{}])[-1].get('id', '?')} 회의에 위원으로 앉음 — 뽑힌 근거는 기록에 없음")
        nodes[-1]["activity"] = [{"day": _stamp((a["at"])), "what": a["id"],
                                  "text": " · ".join(a["did"])} for a in m["activity"]]
    # 계약(기간)과 시작 근거
    for n in nodes:
        f = next((f for sec, f in rows if f[0] == n["name"]), [])
        if f:
            n["contract"] = {"start": word(f, "시작 "), "probation": word(f, "판정 "), "extend": word(f, "연장 시 "),
                             "cycle": word(f, "계약 판정 "), "line": kv(f).get("교체선", ""), "decider": kv(f).get("판정자", "")}
        if "hired_why" not in n:
            h = [x for x in log.get(n["name"], []) if x["what"] == "hire"]
            fix = [x for x in log.get(n["name"], []) if x["what"] in ("void", "lifted")] + \
                  [x for x in log.get("committee", []) if f"role {n['name']}" in x["text"]]
            n["hired_why"] = (f"{h[-1]['day']} 고용 — {h[-1]['text']}" if h else
                              "고용(hire) 기록 없음 — 명부 계약 줄만 있음" if f else "")
            if fix:
                n["hired_fix"] = [f"{x['day']} {x['what']} — {x['text']}" for x in fix]
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(8) as ex:
        for n, out in zip(nodes, ex.map(lambda n: measure(n["name"]) if n["dept"] not in ("투입 전 초안", "명부에 없는 정의")
                                        else "", nodes)):
            n["metrics"] = out if n["dept"] != "은퇴" else ""
    for n in nodes:  # 오래된 것부터(명부 Log 는 날짜만 있어 그날의 맨 앞에 선다)
        n["activity"] = sorted(n["activity"], key=lambda a: a["day"])
    try:  # areas the local profile marks Ask-first (load_areas kind "ask"), so the page needs no area names
        ask = sorted({a["name"] for a in load_areas() if a["kind"] == "ask"})
    except Exception:
        ask = []
    return {"nodes": nodes, "ask": ask}


def helper_agents(ss, ps_out=None, current=None):
    """세션 목록(pane 마다 첫 에이전트)에 안 잡히는 에이전트.
    1) 한 pane 안의 둘째 이후 에이전트(끝나지 않은 것), 2) 뒤에서 도는 `codex exec`·`claude -p`.
    뒤에서 도는 것은 부모 프로세스를 거슬러 `claude --session-id` 를 찾아 그 세션(pane)에 붙인다.
    [{"id", "kind", "state", "host": panel|None, "label", "origin"}]"""
    out = []
    try:
        items = (current if current is not None else json.loads(cmux("current", "--json", "--limit", "200").stdout))["items"]
    except (ValueError, KeyError):
        items = []
    for it in items:
        panel = ((it.get("projections") or [{}])[0]).get("panel_id")
        for i, a in enumerate((it.get("agents") or [])[1:]):
            if panel and a.get("state") not in ("ended", None):
                out.append({"id": f"{panel}#{i + 1}", "kind": a.get("kind") or "?", "state": a.get("state"),
                            "host": panel, "label": f"{a.get('kind')} (같은 pane)", "origin": "pane"})
    if ps_out is None:
        try:
            ps_out = subprocess.run(["ps", "-axo", "pid=,ppid=,command="], capture_output=True, text=True).stdout
        except OSError:
            ps_out = ""
    procs = {}
    for line in ps_out.splitlines():
        f = line.split(None, 2)
        if len(f) == 3 and f[0].isdigit():
            procs[int(f[0])] = (int(f[1]), f[2])
    by_sid = {x.get("session"): x["panel"] for x in ss if x.get("session")}

    def is_run(cmd):
        exe = cmd.split()[0].rsplit("/", 1)[-1]
        if exe == "codex" and " exec" in cmd and "app-server" not in cmd:
            return "codex"
        if exe == "claude" and re.search(r"\s(-p|--print)(\s|$)", cmd):
            return "claude"
        return None
    for pid, (ppid, cmd) in procs.items():
        kind = is_run(cmd)
        if not kind or (ppid in procs and is_run(procs[ppid][1])):
            continue  # 래퍼가 띄운 같은 실행의 자식은 한 번만 센다
        host, origin, cur = None, "cmux 밖", ppid
        for _ in range(40):
            if cur not in procs:
                break
            pc = procs[cur][1]
            m = re.search(r"--session-id ([0-9a-f-]{36})", pc)
            if m and m.group(1) in by_sid:
                host, origin = by_sid[m.group(1)], "세션이 띄움"
                break
            if "ChatGPT.app" in pc:
                origin = "ChatGPT 앱"
                break
            cur = procs[cur][0]
        words, toks = [], cmd.split(" exec ", 1)[1].split() if " exec " in cmd else []
        skip = False
        for t in toks:
            if skip:
                skip = False
            elif t.startswith("-"):
                skip = t in ("-s", "-c", "-m", "-C", "--sandbox", "--model", "--cd", "-p", "--profile")
            else:
                words.append(t)
        label = " ".join(words)[:60] or f"{kind} 실행"
        out.append({"id": f"pid{pid}", "kind": kind, "state": "working", "host": host, "label": label, "origin": origin})
    return out


CLAUDE_PROJECTS = os.path.join(HOME, ".claude/projects")
CLAUDE_LIMITS = os.path.join(HOME, ".cache/cmux/claude-limits.json")  # statusline.sh 가 남기는 Claude 사용률
CODEX_HOMES = os.path.join(HOME, ".codex*")  # ~/.codex 와 ~/.codex-<이름> 처럼 계정마다 따로 둔 Codex 홈을 모두 본다


def codex_home_key(f):
    """rollout 파일 → 그 Codex 홈 이름(codex, codex-personal ...)."""
    for part in f.split(os.sep):
        if part.startswith(".codex"):
            return part[1:]
    return "codex"


def codex_limits_of(pl):
    """token_count 의 rate_limits → {"plan", "primary": {"used", "resets_at", "window"}, "secondary": ...} 또는 None."""
    rl = pl.get("rate_limits") or {}
    if not rl:
        return None
    out = {"plan": rl.get("plan_type")}
    for k in ("primary", "secondary"):
        r = rl.get(k)
        if r and r.get("used_percent") is not None:
            out[k] = {"used": r["used_percent"], "resets_at": r.get("resets_at"), "window": r.get("window_minutes")}
    return out


def iso_ts(v):
    from datetime import datetime
    try:
        return datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def power_scan(pw, now=None):
    """토큰을 전기로: 오늘 Claude·Codex 가 쓴 토큰, 지금의 흐름(분당), 세션별 최근 2분, 도는 서브에이전트.
    pw 는 파일별 읽은 위치·본 메시지를 들고 다녀 다음 호출은 새로 붙은 줄만 읽는다. 날이 바뀌면 처음부터.
    Claude 는 같은 응답을 여러 줄로 적으므로 message.id 로 한 번만 센다. Codex 는 누적값의 차이를 쓴다."""
    now = now or time.time()
    lt = time.localtime(now)
    day0 = time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday, 0, 0, 0, 0, 0, -1))
    if pw.get("day") != day0:
        pw.clear()
        pw.update(day=day0, off={}, seen=set(), ev=[], today={"claude": 0, "codex": 0}, csid={}, ctot={}, limits={})
    files, subs = [], []
    for dirpath, dirs, names in os.walk(CLAUDE_PROJECTS):
        for n in names:
            if not n.endswith(".jsonl"):
                continue
            f = os.path.join(dirpath, n)
            try:
                mt = os.path.getmtime(f)
            except OSError:
                continue
            if mt < day0:
                continue
            files.append(("claude", f))
            if os.path.basename(dirpath) == "subagents" and now - mt < 120:
                subs.append(f)
    import glob
    for home in glob.glob(CODEX_HOMES):
        cdir = os.path.join(home, "sessions", time.strftime("%Y/%m/%d", lt))
        try:
            files += [("codex", os.path.join(cdir, n)) for n in os.listdir(cdir) if n.endswith(".jsonl")]
        except OSError:
            pass
        key = os.path.basename(home)[1:]
        if key not in pw["limits"]:  # 오늘 기록이 없으면 가장 최근 날의 마지막 한도로 시작한다
            pw["limits"][key] = {}
            days = sorted(glob.glob(os.path.join(home, "sessions", "*", "*", "*")))[-7:]
            last = sorted((os.path.getmtime(x), x) for d in days for x in glob.glob(os.path.join(d, "*.jsonl")))
            for _, x in reversed(last):
                try:
                    lines = [l for l in tail(x, 400_000) if '"token_count"' in l]
                except OSError:
                    continue
                for l in reversed(lines):
                    try:
                        lim = codex_limits_of(json.loads(l)["payload"])
                    except (ValueError, KeyError, TypeError):
                        continue
                    if lim:
                        pw["limits"][key] = lim
                        break
                if pw["limits"][key]:
                    break
    for fam, f in files:
        try:
            size = os.path.getsize(f)
            off = pw["off"].get(f, 0)
            if size <= off:
                continue
            with open(f, "rb") as fh:
                fh.seek(off)
                chunk = fh.read()
        except OSError:
            continue
        end = chunk.rfind(b"\n") + 1
        pw["off"][f] = off + end
        parts = f.split(os.sep)
        sid = parts[-3] if len(parts) > 2 and parts[-2] == "subagents" else os.path.basename(f)[:-6]
        for line in chunk[:end].decode("utf-8", "replace").splitlines():
            if fam == "claude":
                if '"usage"' not in line or '"assistant"' not in line:
                    continue
                try:
                    d = json.loads(line)
                    m = d["message"]
                    u = m["usage"]
                except (ValueError, KeyError, TypeError):
                    continue
                if m.get("id") in pw["seen"]:
                    continue
                pw["seen"].add(m.get("id"))
                tok = sum(int(u.get(k) or 0) for k in
                          ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
                at = iso_ts(d.get("timestamp"))
            else:
                if '"session_meta"' in line:
                    try:
                        pw["csid"][f] = json.loads(line)["payload"]["id"]
                    except (ValueError, KeyError, TypeError):
                        pass
                    continue
                if '"token_count"' not in line:
                    continue
                try:
                    d = json.loads(line)
                    pl = d["payload"]
                    total = int(((pl.get("info") or {}).get("total_token_usage") or {}).get("total_tokens") or 0)
                except (ValueError, KeyError, TypeError):
                    continue
                lim, key = codex_limits_of(pl), codex_home_key(f)
                old = pw["limits"].get(key) or {}
                if lim and (len(lim) > 1 or old.get("plan") != lim.get("plan")):  # 같은 요금제의 빈 한도 칸은 앞 값을 지우지 않는다
                    pw["limits"][key] = lim
                tok = max(0, total - pw["ctot"].get(f, 0))
                if total:
                    pw["ctot"][f] = total
                at = iso_ts(d.get("timestamp"))
                sid = pw["csid"].get(f, sid)
            if not tok or not at or at < day0:
                continue
            pw["today"][fam] += tok
            pw["ev"].append((at, fam, sid, tok))
    pw["ev"] = [e for e in pw["ev"] if now - e[0] < 600]
    rate = {fam: sum(e[3] for e in pw["ev"] if e[1] == fam and now - e[0] < 300) // 5 for fam in ("claude", "codex")}
    by = {}
    for at, fam, sid, tok in pw["ev"]:
        if now - at < 120:
            by[sid] = by.get(sid, 0) + tok
    active = []
    for f in subs:
        try:
            meta = json.load(open(f[:-6] + ".meta.json"))
        except (OSError, ValueError):
            meta = {}
        if not meta.get("finished"):
            active.append({"host_session": f.split(os.sep)[-3], "label": meta.get("description") or "서브에이전트",
                           "type": meta.get("agentType") or "", "id": os.path.basename(f)[:-6]})
    climits = {}
    try:  # 상태줄(statusline.sh)이 Claude Code 가 넘긴 rate_limits 를 남겨 둔 파일
        rl = json.load(open(CLAUDE_LIMITS)).get("rate_limits") or {}
        for k, key in (("five_hour", "primary"), ("seven_day", "secondary")):
            w = rl.get(k) or {}
            if w.get("used_percentage") is not None:
                climits[key] = {"used": w["used_percentage"], "resets_at": iso_ts(w["resets_at"]) if isinstance(w.get("resets_at"), str)
                                else w.get("resets_at"), "window": 300 if k == "five_hour" else 10080}
    except (OSError, ValueError, AttributeError):
        pass
    return {"claude": {"today": pw["today"]["claude"], "per_min": rate["claude"],
                       "limits": {"claude": dict(climits, plan="claude")} if climits else {}},
            "codex": {"today": pw["today"]["codex"], "per_min": rate["codex"], "limits": pw["limits"]},
            "sessions": by, "subagents": active}


def tree_frame(st):
    """사무실 화면의 한 장면: 트리, 최근 이벤트, 머리 숫자. st 는 앞 장면의 세션 스냅샷과 화면이 본 이벤트를 들고 있다."""
    now = time.time()
    ss = sessions()
    snap = {x["panel"]: {"state": x["state"], "title": x["title"]} for x in ss}
    dl = (desk_panel() or "").lower()
    if st.get("prev") is not None:
        st["seen"] = [e for e in st["seen"] if now - e["at"] < 86400] + \
            [e for e in snap_events(st["prev"], ss, now) if (e["panel"] or "").lower() != dl]
    st["prev"] = snap
    evs = merge_events(st["seen"] + read_events(now - 86400) + message_events(st["start"] - 3600, ss))
    rep = {((e.get("panel") or "").lower(), int(e["at"]) // 10) for e in evs if e.get("what") == "report"}
    evs = [e for e in evs if not (e.get("what") == "msg" and  # `brief report` 는 보고와 메시지를 함께 남긴다: 보고 하나로
                                  ((e.get("from_panel") or "").lower(), int(e["at"]) // 10) in rep)]
    data = tree_data(ss, evs)
    evs = handoffs(evs, data)
    flat = []

    def walk(ns):
        for n in ns:
            flat.append(n)
            walk(n["children"])
    for a in data["areas"]:
        walk(a["sessions"])
    stats = {"sessions": len(flat), "working": sum(n["state"] == "working" for n in flat),
             "user": sum(n["waiting"]["who"] == "user" for n in flat),
             "desk": sum(n["waiting"]["who"] == "desk" for n in flat)}
    helpers = helper_agents(ss)
    pwr = st.get("power") or {}
    by_sid = {x.get("session"): x["panel"] for x in ss if x.get("session")}
    for sa in pwr.get("subagents", []):  # Claude 가 Agent 도구로 띄운 서브에이전트(같은 프로세스 안): 기록 파일로 본다
        helpers.append({"id": "sub-" + sa["id"], "kind": "claude", "state": "working", "host": by_sid.get(sa["host_session"]),
                        "label": sa["label"], "origin": "서브에이전트" + (f" ({sa['type']})" if sa["type"] else "")})
    sess_of = {x["panel"]: x.get("session") for x in ss}

    def tag_sessions(ns):
        for n in ns:
            n["session"] = sess_of.get(n["panel"])
            tag_sessions(n["children"])
    for a in data["areas"]:
        tag_sessions(a["sessions"])
    stats["helpers"] = len(helpers)
    stats["working"] += sum(h["state"] == "working" for h in helpers)
    st["roles"] = {n["role"] for n in flat if n.get("role")}
    return {"now": now, "tree": data, "stats": stats, "helpers": helpers, "role_art": role_art_have(), "power": {k: v for k, v in pwr.items() if k != "subagents"},
            "events": sorted(evs, key=lambda e: e["at"], reverse=True)[:80]}


def go_panel(panel, ss=None):
    """cmux 에서 그 세션 pane 으로 간다: 창 → 워크스페이스 → pane 을 차례로 고르고 cmux 를 앞으로 띄운다.
    열린 세션의 pane 만 받는다. 성공하면 None, 아니면 이유."""
    ss = ss if ss is not None else sessions()
    x = next((x for x in ss if x["panel"].lower() == (panel or "").lower()), None)
    if not x:
        return "열린 세션이 아님"
    ws, win = x.get("workspace"), None
    for wid in re.findall(r"^\*?\s*\d+:\s+(\S+)", cmux("list-windows").stdout, re.M):
        try:
            if any(w["id"] == ws for w in json.loads(cmux("rpc", "workspace.list", json.dumps({"window_id": wid})).stdout)["workspaces"]):
                win = wid
                break
        except (ValueError, KeyError):
            continue
    where = ["--window", win] if win else []
    if win:
        cmux("focus-window", "--window", win)
    cmux("select-workspace", "--workspace", ws, *where)
    r = cmux("focus-panel", "--panel", x["panel"], "--workspace", ws, *where)
    if r.returncode:
        return (r.stderr or r.stdout).strip() or "focus-panel 실패"
    subprocess.run(["open", "-b", "com.cmuxterm.app"], capture_output=True)
    return None


