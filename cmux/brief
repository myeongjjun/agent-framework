def input_box(s):
    """(입력 칸의 보내지 않은 글, 프롬프트 제안, cmux 입력 상태, 읽지 못한 까닭). 데스크가 넣은 글은 둘 다 아니다.
    Claude 세션에서 cmux 가 입력 칸을 비었다고 보면 화면의 글은 제안이다(11-24: 끝난 세션 4개가 제안 때문에 안 닫힘).
    선택 대화상자(dialog)의 '❯' 는 고르는 줄이지 친 글이 아니다. 칸이 좁아 글을 못 읽으면 cmux 가 draft 라고 할 때만
    친 글로 보고, 상태도 모르면 대화 기록으로 가른다: 마지막 답 뒤에 사용자 입력이 있으면 쓰는 중으로 보고, 없으면
    친 글로 세지 않는다('…' 를 글로 내보이지 않고 "입력 칸을 읽을 수 없음"을 남긴다).
    상태를 못 읽거나 Claude 가 아니면 읽은 화면의 글을 사용자가 친 글로 본다(쓰던 글을 닫지 않는 쪽)."""
    st = input_state(s)
    if st == "dialog":
        return "", "", st, ""
    d, w = input_draft(s)
    if st == "empty" and s.get("agent") == "claude":
        return "", d if d and not d.startswith(OURS) else "", st, ""
    if w and w < NARROW_BOX and d and set(d) <= set("… ."):
        why = f"입력 칸을 읽을 수 없음(폭 {w}칸)"
        if st == "draft":
            return f"(친 글이 있으나 {why})", "", st, why
        t = turns(s)
        if t["input"] > t["active"]:
            return f"({why}: 마지막 답 뒤에 사용자 입력이 있음)", "", st, why
        return "", "", st, why
    if not d or d.startswith(OURS):
        return "", "", st, ""
    return d, "", st, ""


def closing_snapshot(s):
    """데스크가 pane 을 닫기 직전에 도구가 찍는 사실: 입력 칸의 보내지 않은 글(과 cmux 입력 상태, 프롬프트 제안),
    미응답 질문, cwd 의 git. 데스크의 판단이 아니라 닫힌 뒤 `brief audit` 이 쓰는 증거다."""
    out = close_check(s)
    d, sug, st, why = input_box(s)
    out["input"] = st or "unknown"  # 이 키가 있는 기록만 제안과 친 글을 가른 것이다(audit 이 옛 기록과 구분)
    if why:
        out["unreadable"] = why
    if d:
        out["unsent"] = d[:200]
    if sug:
        out["suggested"] = sug[:200]
    return out


HELD_MIN = float(os.environ.get("BRIEF_HELD_MIN", "60"))  # 끝난 세션을 이보다 오래 열어 두면 '끝났는데 열어 둠'
NOTHING_LEFT = re.compile(r"남은 (일|것|작업)[은이]?\s*없|할 일[은이]?\s*(없|끝났|다 했)|nothing (is )?left|remaining:\s*none", re.I)
# 사용자가 그 세션에 끝내라고 한 말(그 뒤의 not-ready 는 사용자가 남은 일을 접은 것이다. 11-23)
USER_STOP = re.compile(r"(작업|여기서|이제|그만).{0,6}(종료|끝내|끝|마무리|접)|종료해|끝내자|끝내|마무리해|여기까지|그만하|닫아도|"
                       r"\bwrap up\b|\bstop here\b|\bwe'?re done\b", re.I)


def asks(text):
    """답의 마지막 두 줄이 사용자에게 묻는 말인지(그 줄, 없으면 None)."""
    if text == "(AskUserQuestion)":
        return text
    lines = [l.strip() for l in (text or "").strip().splitlines() if l.strip()][-2:]
    asked = [l for l in lines if QUESTION.search(l)]
    return asked[-1][:160] if asked else None


def session_until(x, until):
    """닫히기 전까지의 대화 기록에서: 마지막 done-report 상태, 마지막 답이 질문으로 끝났고 그 뒤 입력이 없는지,
    세션이 고친 파일, 세션이 만든 커밋, 세션이 일한 폴더, 그리고 끝났는데 열어 둔 구간(held).

    끝남: ready 보고를 낸 뒤(그 뒤 사용자의 후속 요청에 답한 턴도 묻는 말로 끝나지 않으면 끝난 상태로 돌아간다),
    또는 답이 '남은 일 없음'을 말할 때, 또는 사용자가 끝내라고 한 뒤의 보고. 끝난 때부터 다음 사용자 입력(없으면
    until, 그것도 없으면 지금)까지가 HELD_MIN 분을 넘으면 held 에 (시작, 끝) 을 남긴다. 데스크·sib 가 넣은 글은
    사용자 입력이 아니라 이 구간을 끊지 않는다."""
    out = {"report": None, "report_at": 0, "question": None, "files": set(), "commits": set(), "cwds": set(),
           "held": [], "report_after_stop": False}
    path = transcript(x)
    if not path:
        return None
    codex = x.get("agent") == "codex"
    last_text, last_at, input_at = None, 0, 0
    ready_seen, fin, fin_since, poked, stop = False, False, 0, False, False
    for line in tail(path, 20_000_000):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        t = epoch(o.get("timestamp"))
        if until and t > until:
            break  # 닫힌 뒤(다시 열려 이어진 대화)는 보지 않는다
        if o.get("cwd"):
            out["cwds"].add(o["cwd"])
        if codex:
            p = o.get("payload") or {}
            if p.get("type") == "turn_context" and p.get("cwd"):
                out["cwds"].add(p["cwd"])
            user = p.get("type") == "message" and p.get("role") == "user"
            agent = (p.get("type") == "message" and p.get("role") == "assistant") or p.get("type") in (
                "function_call", "custom_tool_call", "function_call_output", "custom_tool_call_output")
            blocks = p.get("content") if isinstance(p.get("content"), list) else []
            text = " ".join(c.get("text", "") for c in blocks if isinstance(c, dict))
            if p.get("type", "").endswith("_output"):
                out["commits"].update(COMMIT_OUT.findall(str(p.get("output", ""))))
                agent = False
            ask = False
        else:
            if o.get("isSidechain") or o.get("type") not in ("user", "assistant"):
                continue
            c = (o.get("message") or {}).get("content")
            blocks = c if isinstance(c, list) else [{"type": "text", "text": str(c or "")}]
            results = [b for b in blocks if isinstance(b, dict) and b.get("type") == "tool_result"]
            for b in results:
                rc = b.get("content")
                rc = " ".join(y.get("text", "") for y in rc if isinstance(y, dict)) if isinstance(rc, list) else str(rc or "")
                out["commits"].update(COMMIT_OUT.findall(rc))
            user = (o["type"] == "user" and not results and not o.get("isMeta") and not o.get("isCompactSummary")
                    and (o.get("origin") or {}).get("kind", "human") == "human")
            agent = o["type"] == "assistant"
            text = " ".join(b.get("text", "") for b in blocks if isinstance(b, dict) and b.get("type") == "text")
            ask = False
            for b in blocks:
                if agent and isinstance(b, dict) and b.get("type") == "tool_use":
                    inp = b.get("input") or {}
                    if b.get("name") in EDIT_TOOLS and inp.get("file_path"):
                        out["files"].add(inp["file_path"])
                    if b.get("name") == "AskUserQuestion":
                        ask = True
        if agent:
            m = DONE_REPORT.findall(line)  # 글이든 `brief report` 명령이든 세션이 낸 보고
            if m:
                out["report"], out["report_at"] = m[-1], t
                out["report_after_stop"] = stop
                ready_seen = m[-1] == "ready" or stop  # 사용자가 끝내라고 한 뒤의 not-ready 도 끝난 것이다
                fin = fin and ready_seen
            said = "(AskUserQuestion)" if ask and not text.strip() else text
            if said.strip():
                last_text, last_at = said, t
                if asks(said):
                    fin = False
                elif ready_seen or NOTHING_LEFT.search(said):
                    if not (fin and poked):  # 완료 보고 요청에 답한 것은 끝난 시각을 미루지 않는다
                        fin_since = t
                    fin = True
            elif fin and not poked:
                fin_since = t  # 끝난 뒤에도 도구를 더 쓰면 그 끝까지는 일한 것이다
        elif user:
            body = PASTE_TAG.sub("", text).strip()
            if body and not body.startswith("<") and not body.startswith("# AGENTS.md"):
                input_at = t
                if "done-request:" in body:
                    poked = True  # 데스크의 완료 보고 요청은 끝난 상태를 끊지 않는다
                    continue
                if any(h in body for h in HANDOFF):
                    fin, poked = False, False  # 데스크·sib 가 새 일을 넘겼다: 열어 둔 것이 아니라 다시 쓴 것이다
                    continue
                if fin and t - fin_since >= HELD_MIN * 60:
                    out["held"].append((fin_since, t))
                fin, poked, stop = False, False, bool(USER_STOP.search(body))
    if fin:
        end = until or time.time()
        if end - fin_since >= HELD_MIN * 60:
            out["held"].append((fin_since, end))
    if out["report"] and input_at > out["report_at"]:
        out["report"] = None  # 보고 뒤에 사용자가 다시 입력했다: 그 보고는 지금 상태가 아니다
        out["stale"] = True
    if last_text and last_at > input_at:
        out["question"] = asks(last_text)
    return out


def git_left(info, cwd):
    """세션이 고친 파일 중 지금도 미커밋인 것, 세션이 만든 커밋 중 어느 원격 브랜치에도 없는 것."""
    def top(d):
        d = os.path.expanduser(d or "")
        while d and not os.path.isdir(d):
            d = os.path.dirname(d)
        if not d:
            return None
        r = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else None
    repos = {t for t in map(top, {cwd, *info["cwds"], *(os.path.dirname(f) for f in info["files"])}) if t}
    dirty = []
    for t in repos:  # 세션이 고친 파일만 묻는다(큰 저장소 전체를 훑으면 20초가 넘는다)
        rt = os.path.realpath(t) + os.sep
        mine = sorted(f for f in info["files"] if os.path.realpath(f).startswith(rt))
        if not mine:
            continue
        r = subprocess.run(["git", "-C", t, "status", "--porcelain", "--", *mine], capture_output=True, text=True)
        got = [os.path.realpath(os.path.join(t, l[3:].split(" -> ")[-1].strip('"'))) + ("/" if l.endswith("/") else "")
               for l in r.stdout.splitlines() if len(l) > 3]
        dirty += [f for f in mine if any(os.path.realpath(f) == g or (g.endswith("/") and os.path.realpath(f).startswith(g))
                                         for g in got)]
    unpushed = []
    for sha in sorted(info["commits"]):
        for t in repos:
            if subprocess.run(["git", "-C", t, "cat-file", "-e", sha + "^{commit}"], capture_output=True).returncode:
                continue
            if not subprocess.run(["git", "-C", t, "remote"], capture_output=True, text=True).stdout.strip():
                break  # 원격이 없는 저장소: push 할 곳이 없다
            r = subprocess.run(["git", "-C", t, "branch", "-r", "--contains", sha], capture_output=True, text=True)
            if r.returncode == 0 and not r.stdout.strip():
                unpushed.append(sha[:7])
            break
    return dirty, unpushed


def audit_one(rec):
    """닫힘 기록 하나를 판정한다. verdict: left(일이 남은 채 닫음) / unreported(보고 없이 닫음, 남은 것은 못 찾음) / ok.
    by: desk(데스크가 검토 기록을 남기고 닫음) / user(검토 없이 닫힘: 사용자나 세션이 닫음)."""
    info = session_until(rec, rec.get("at"))
    chk = rec.get("check") or {}
    reasons, notes = [], []
    if info is None:
        notes.append("대화 기록 없음")
        info = {"report": None, "question": chk.get("question"), "files": set(), "commits": set(), "cwds": set(), "held": []}
    rep = info["report"]
    if info.get("stale"):
        notes.append("보고 뒤 사용자 입력이 있어 그 보고는 보지 않음")
    if rep == "not-ready" and info.get("report_after_stop"):
        notes.append("not-ready 보고는 사용자가 끝내라고 한 뒤의 것")
    elif rep == "not-ready":
        reasons.append("마지막 보고가 not-ready")
    cq = chk.get("question")  # 닫을 때 찍은 질문도 지금의 규칙으로 다시 본다(옛 규칙의 오탐을 끌고 오지 않게)
    q = info["question"] or (cq if cq and asks(cq) else None)
    if q:
        reasons.append(f"답 없는 질문 \"{q[:80]}\"")
    unsent = chk.get("unsent")
    if not unsent and rec.get("verified"):  # 닫을 때 찍은 화면이 없던 기록(11-23 이전): 데스크가 적은 입력 칸의 글
        m = UNSENT_NOTE.search(rec["verified"])
        unsent = m and m.group(1)
    if unsent and (chk.get("input") == "dialog" or set(unsent) <= set("… .")):  # 11-24 이전: 대화상자 줄·좁은 칸의 '…'
        notes.append(f"입력 칸의 '{unsent[:60]}' 는 친 글이 아님(" + ("선택 대화상자" if chk.get("input") == "dialog"
                                                              else "입력 칸을 읽을 수 없음: pane 이 좁음") + ")")
        unsent = None
    if chk.get("unreadable"):
        notes.append(chk["unreadable"])
    if unsent and "input" in chk:  # 닫을 때 cmux 입력 상태로 제안과 가른 글(상태를 못 읽었으면 친 글로 남긴 것)
        reasons.append(f"보내지 않은 글 '{unsent[:60]}'")
    elif unsent:  # 11-24 이전 기록: 제안과 친 글을 가르지 못하고 찍은 글이라 일이 남은 근거로 쓰지 않는다
        notes.append(f"입력 칸의 글 '{unsent[:60]}'(프롬프트 제안일 수 있음: 닫을 때 입력 상태를 찍지 않은 기록)")
    if chk.get("suggested"):
        notes.append(f"프롬프트 제안 '{chk['suggested'][:60]}'(사용자가 친 글 아님)")
    dirty, unpushed = git_left(info, rec.get("cwd"))
    git = ([f"세션이 고친 파일 미커밋 {len(dirty)}"] if dirty else []) + ([f"세션의 커밋 미push {len(unpushed)}"] if unpushed else [])
    if rep == "ready":
        notes += git  # 보고가 대조를 거쳤으면 push·남긴 파일은 사용자에게 넘긴 것이다(L14)
    else:
        reasons += git
    verdict = "left" if reasons else ("ok" if rep or info.get("stale") else "unreported")
    return {"panel": rec.get("panel"), "at": rec.get("at"), "title": rec.get("title"), "by": "desk" if rec.get("verified") else "user",
            "verdict": verdict, "report": rep, "reasons": reasons, "notes": notes, "files": dirty[:5], "unpushed": unpushed,
            "held": [[int(a), int(b)] for a, b in info["held"]], "v": AUDIT_V}


def audit_key(rec):
    return f"{rec.get('panel')}:{rec.get('at')}"


# 호출자가 닫은 일꾼 pane: `sib kill` 이 닫을 때 남긴 줄(slug, panel, workdir, at). 그 pane 의 닫힘은 사용자도 데스크도
# 아닌 호출자(위원회·그림 일꾼을 띄운 도구나 세션)가 닫은 것이다.
SIB_KILLED = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "sib/killed.jsonl")
CALLER_WINDOW = 900  # pane id 를 못 남긴 줄은 같은 폴더에서 이 초 안에 닫힌 기록과 맞춘다


def sib_kills():
    try:
        return [json.loads(l) for l in open(SIB_KILLED) if l.strip()]
    except (OSError, ValueError):
        return []


def caller_of(rec, kills):
    """그 닫힘 기록을 닫은 호출자의 `sib kill` 줄(없으면 None): pane id 가 같거나, id 없이 같은 폴더에서 바로 닫힌 것."""
    panel = (rec.get("panel") or "").lower()
    cwd = os.path.realpath(os.path.expanduser(rec.get("cwd") or "")) if rec.get("cwd") else None
    for k in kills:
        if k.get("panel"):
            if k["panel"].lower() == panel:
                return k
        elif cwd and k.get("workdir") and os.path.realpath(k["workdir"]) == cwd \
                and abs(int(k.get("at", 0)) - int(rec.get("at", 0))) <= CALLER_WINDOW:
            return k
    return None


def audit_counts(res, live=()):
    """판정 목록 하나에서 세는 숫자들. `brief audit` 머리줄, 보드, 보드 추이가 모두 이것으로 센다(한 번, 같은 방법).
    호출자가 닫은 일꾼 pane 은 사용자·데스크의 '일이 남은 채'·'보고 없이' 에 넣지 않고 따로 센다."""
    mine = [a for a in res if a.get("by") != "caller"]
    desk = [a for a in res if a.get("by") == "desk"]
    held = sum(bool(a.get("held")) for a in res)
    return {"closed": len(res), "caller": len(res) - len(mine),
            "left": sum(a["verdict"] == "left" for a in mine), "noreport": sum(a["verdict"] == "unreported" for a in mine),
            "closed_desk": len(desk), "wrong_close": sum(a["verdict"] == "left" for a in desk),
            "closed_noreport": sum(a["verdict"] == "unreported" for a in desk),
            "held": held, "held_open": held + len(live)}


def audit(day=None, fresh=False, recs=None):
    """그날(05시 기준) 닫힌 세션을 판정한다. 판정은 AUDIT 에 남겨 두고(fresh 면 다시 판정) 목록으로 돌려준다."""
    if recs is None:
        try:
            recs = [json.loads(l) for l in open(CLOSED) if l.strip()]
        except (OSError, ValueError):
            recs = []
    if day:
        recs = [r for r in recs if board_day(r.get("at", 0)) == day]
    try:
        cache = json.load(open(AUDIT))
    except (OSError, ValueError):
        cache = {}
    out, changed, kills = [], False, sib_kills()
    for r in recs:
        if (r.get("title") or "") == "orch" or (r.get("verified") is None and "check" not in r):
            continue  # 데스크 자신의 pane, 기록만 남긴 완료(--keep)
        k = audit_key(r)
        if fresh or cache.get(k, {}).get("v") != AUDIT_V:
            try:
                cache[k] = audit_one(r)
            except Exception as e:  # 한 건이 깨져도 나머지는 판정한다
                cache[k] = {"panel": r.get("panel"), "at": r.get("at"), "title": r.get("title"), "verdict": "error",
                            "by": "desk" if r.get("verified") else "user", "reasons": [], "notes": [str(e)[:120]]}
            changed = True
        a = cache[k]
        who = caller_of(r, kills) if a.get("by") != "desk" else None  # 데스크가 검토하고 닫은 것은 데스크의 닫힘이다
        out.append(dict(a, by="caller", caller=who.get("slug") or "?") if who else a)
    if changed:
        os.makedirs(os.path.dirname(AUDIT), exist_ok=True)
        with open(AUDIT + ".tmp", "w") as f:
            json.dump(cache, f, ensure_ascii=False)
        os.replace(AUDIT + ".tmp", AUDIT)
    return out


def audit_line(a):
    """판정 한 건을 사람이 읽는 한 줄로."""
    head = {"left": "일이 남은 채 닫음", "unreported": "보고 없이 닫음(남은 것은 못 찾음)", "ok": "문제 없음",
            "error": "판정 실패"}[a["verdict"]]
    who = {"desk": "데스크가 닫음", "caller": f"호출자가 닫음(sib kill {a.get('caller', '?')})"}.get(a["by"], "검토 없이 닫힘")
    rest = "; ".join(a["reasons"] + a.get("notes", []))
    held = ("\n    끝났는데 열어 둠: " + held_text(a["held"])) if a.get("held") else ""
    return f"{head} · {who}" + (f" — {rest}" if rest else "") + held


def held_text(spans):
    """끝났는데 열어 둔 구간들을 한 줄로: '3시간 17분 (17:53→21:10)'."""
    def dur(sec):
        h, m = divmod(int(sec) // 60, 60)
        return f"{h}시간 {m}분" if h else f"{m}분"
    def hm(t, ref):
        same = time.localtime(t)[:3] == time.localtime(ref)[:3]
        return time.strftime("%H:%M" if same else "%m-%d %H:%M", time.localtime(t))
    return ", ".join(f"{dur(b - a)} ({hm(a, b)}→{hm(b, b)})" for a, b in spans)


def held_open(ss=None):
    """지금 열려 있는 세션 중 끝났는데 HELD_MIN 분 넘게 열려 있는 것: [(세션, 구간들)]. 데스크 자신은 뺀다."""
    out = []
    desk = (desk_panel() or "").lower()
    for x in ss if ss is not None else sessions():
        if x["panel"].lower() == desk or x.get("state") != "idle":
            continue
        try:
