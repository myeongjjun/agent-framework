def role_fates(roster_text, drafts):
    """역할마다 회의 뒤 어떻게 됐는지: 명부 Roles 의 상태, 아니면 Log 의 마지막 hire/merged/reject/retire, 아니면 초안."""
    fate, sec = {}, ""
    for ln in roster_text.splitlines():
        if ln.startswith("## "):
            sec = ln[3:].strip()
            continue
        f = [x.strip() for x in ln[2:].split("|")] if ln.startswith("- ") else []
        if sec == "Roles" and f:
            st = next((x[3:].strip() for x in f if x.startswith("상태:")), "?")
            fate[f[0]] = f"투입 · {st}"
        elif sec == "Log" and len(f) > 2 and f[1] not in fate and f[2] in ("merged", "reject", "retire", "dissolve", "tool"):
            fate[f[1]] = {"merged": "합쳐짐", "reject": "사용자 거절", "retire": "퇴출", "dissolve": "해체", "tool": "도구로 전환"}[f[2]] \
                + (f" — {f[3]}" if len(f) > 3 else "")
    for d in drafts:
        fate.setdefault(d, "초안 · 투입 전")
    return fate


def committee_archive(hr=None, roster=None):
    """사무실 '기록 보관소': 끝난 위원회 회의를 새것부터. 회의실은 회의가 끝나면 사라지지만 이 기록은 남는다."""
    hr, roster = hr or HR, roster or ROSTER_MD
    try:
        rtext = open(roster).read()
    except OSError:
        rtext = ""
    try:
        drafts = [f[:-3] for f in os.listdir(os.path.join(hr, "agents")) if f.endswith(".md")]
    except OSError:
        drafts = []
    fates = role_fates(rtext, drafts)
    out = []
    try:
        names = sorted(f for f in os.listdir(hr) if f.endswith(".json"))
    except OSError:
        names = []
    for name in names:
        m = re.match(r"(quorum|eval|pilot-panel|failed-convene\d*)-(\d{4}-\d\d-\d\d)", name)
        if not m:
            continue
        try:
            d = json.load(open(os.path.join(hr, name)))
            at = os.path.getmtime(os.path.join(hr, name))
        except (OSError, ValueError):
            continue
        kind = m.group(1)
        mem = [{"name": s.get("name"), "model": s.get("model") or s.get("runner") or "",
                "error": s.get("error") or ""} for s in d.get("members") or d.get("scouts") or []]
        items = []
        if kind == "eval":
            for role, r in (d.get("results") or {}).items():
                c = r.get("counts") or {}
                items.append({"role": role, "result": RESULT_KO.get(r.get("result"), r.get("result") or "?"),
                              "detail": f"hire {c.get('hire', 0)} · revise {c.get('revise', 0)} · reject "
                                        f"{c.get('reject', 0)}", "fate": fates.get(role, "")})
            what, topic = "초안 심사", ", ".join(d.get("results") or {}) or "?"
        else:
            for c in d.get("candidates") or []:
                role = c.get("role") or c.get("kind")
                items.append({"role": role, "result": RESULT_KO.get(c.get("result"), c.get("result") or "?"),
                              "detail": f"{c.get('kind')} · 지지 {c.get('support', 0)} ({', '.join(c.get('backers') or [])})",
                              "fate": fates.get(role, "")})
            what = "시험 회의" if kind == "pilot-panel" else "새 에이전트 발굴"
            topic = f"기간 {' ~ '.join(d.get('period') or [])}"
        failed = not items and all(x["error"] for x in mem)
        if kind.startswith("failed") or failed:
            what += " (실패)"
        md = name[:-5] + ".md"
        out.append({"id": d.get("id") or name[:-5], "at": at, "what": what, "topic": topic, "members": mem,
                    "items": items, "failed": kind.startswith("failed") or failed,
                    "md": md if os.path.exists(os.path.join(hr, md)) else None})
    out += roster_records(hr, rtext, fates, {m["id"]: m["at"] for m in out})
    out.sort(key=lambda x: x["at"], reverse=True)
    return out


REC_KO = {"hire": "투입", "merged": "합쳐짐", "tool": "도구로 전환", "retire": "퇴출", "bench": "벤치(자리 뺌)",
          "dissolve": "해체", "lifted": "보류 해제", "reject": "사용자 거절"}


def roster_records(hr, rtext, fates, meeting_at):
    """기록 보관소에 회의 말고 '그 뒤 일'도 남긴다: 명부 Log 의 투입(hire)·합쳐짐·도구 전환·퇴출·보류 해제 줄.
    명부 줄에는 날짜만 있으므로 시각은 영역 Decision log 에서 그 역할을 말한 by:user 줄의 시각을 쓰고, 없으면
    근거 회의가 끝난 시각 바로 뒤에 놓고 time_known=False 로 표시한다(추측한 시각을 사실처럼 보이지 않게)."""
    import datetime as _dt
    year = _dt.datetime.now().year
    try:
        dlog = [ln for ln in open(AREAS_MD) if re.match(r"- \d\d-\d\d \d\d:\d\d \|", ln)]
    except OSError:
        dlog = []
    out, sec = [], ""
    for ln in rtext.splitlines():
        if ln.startswith("## "):
            sec = ln[3:].strip()
            continue
        f = [x.strip() for x in ln[2:].split("|")] if ln.startswith("- ") else []
        if sec != "Log" or len(f) < 3 or f[2] not in REC_KO:
            continue
        role = f[1]
        if f[2] == "lifted":
            m = re.search(r"role ([\w.-]+)", ln)
            role = m.group(1) if m else role
        text = " | ".join(f[3:])
        at, known = None, False
        hits = [d for d in dlog if d[2:7] == f[0] and role in d and "by:user" in d]
        word = {"hire": r"설치|투입"}.get(f[2], r"합|도구|퇴출|벤치|해체|보류|거절")
        hits = [d for d in hits if re.search(word, d)] or hits[:1]
        if hits:
            at = _dt.datetime.strptime(f"{year}-{hits[0][2:13]}", "%Y-%m-%d %H:%M").timestamp()
            known = True
        if at is None:
            refs = [meeting_at[r] for r in re.findall(r"(?:eval|quorum)-\d{4}-\d\d-\d\d(?:-\d+)?", text) if r in meeting_at]
            day = _dt.datetime.strptime(f"{year}-{f[0]}", "%Y-%m-%d").timestamp()
            at = (max(refs) + 1) if refs else day + 12 * 3600
        out.append({"id": f"명부 · {role}", "at": at, "time_known": known, "what": REC_KO[f[2]], "topic": role,
                    "members": [], "record": True, "failed": False, "md": None,
                    "items": [{"role": role, "result": REC_KO[f[2]], "detail": text, "fate": fates.get(role, "")}]})
    return out


