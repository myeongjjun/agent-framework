def _front(path):
    """에이전트 정의의 frontmatter 몇 줄(description, model, tools)."""
    out = {}
    try:
        for i, ln in enumerate(open(path)):
            if i and ln.startswith("---"):
                break
            k, _, v = ln.partition(":")
            if k in ("description", "model", "tools"):
                out[k] = v.strip().strip('"')
    except OSError:
        pass
    return out


def _stamp(t):
    """기록 시각을 이 기기의 시간대로(사무실의 모든 시각은 기기 시간대: 기록 줄도 그 시간대로 쓰인다)."""
    import datetime as _dt
    return _dt.datetime.fromtimestamp(t).strftime("%m-%d %H:%M")


def org_chart(hr=None, roster=None, cfg=None, measure=None):
    """사무실 '조직도': 지금 이 기기에서 일하는 에이전트 전체. 위원회 위원도 에이전트 하나로 같은 칸에 놓고 부서만 가른다.
    부서: 데스크 · 영역(명부 Roles 의 영역, 영역 담당이 있으면 그 밑) · 위원회 · 투입 전 초안 · 명부에 없는 정의.
    칸마다 이력(모델·층·설명·원본·상태·판정일), 지표(agent-scout measure 그대로), 활동(명부 Log 줄과 위원회 기록)."""
    hr, roster = hr or HR, roster or ROSTER_MD
    if measure is None:
        def measure(n):
            try:
                r = subprocess.run([os.path.join(REPO, "bin", "agent-scout"), "measure", n], capture_output=True,
                                   text=True, timeout=30)
                return r.stdout.strip() if r.returncode == 0 else ""
            except (OSError, subprocess.SubprocessError):
                return ""
    try:
        rtext = open(roster).read()
    except OSError:
        rtext = ""
    area_names = {}
    try:
        for ln in open(AREAS_MD):
            m = re.match(r"## ([A-Z])\. (.+)", ln)
            if m:
                area_names[m.group(1)] = f"{m.group(1)}. {m.group(2).strip()}"
    except OSError:
        pass
    sec, rows, log = "", [], {}
    for ln in rtext.splitlines():
        if ln.startswith("## "):
            sec = ln[3:].strip()
            continue
        if not ln.startswith("- "):
            continue
        f = [x.strip() for x in ln[2:].split("|")]
        if sec == "Log" and len(f) > 2:
            log.setdefault(f[1], []).append({"day": f[0], "what": f[2], "text": " | ".join(f[3:])})
        elif sec in ("Roles", "Standing", "Committee"):
            rows.append((sec, f))
    archive = committee_archive(hr, roster)
    reviewed = {}
    for mt in archive:
        for it in mt["items"]:
            reviewed.setdefault(it["role"], []).append({"day": _stamp((mt["at"])),
                                                       "what": mt["what"], "text": f"{mt['id']}: {it['result']} · {it['detail']}"})
    nodes, seen = [], set()

    def node(name, dept, **kw):
        n = {"name": name, "dept": dept, "activity": reviewed.get(name, []) + log.get(name, [])}
        n.update(kw)
        nodes.append(n)
        seen.add(name)
        return n

    def kv(f):
        return {x.split(":", 1)[0].strip(): x.split(":", 1)[1].strip() for x in f if ":" in x and not x.startswith("/")}

    def word(f, w):
        return next((x[len(w):].strip() for x in f if x.startswith(w)), "")

    for sec, f in rows:
        k = kv(f)
        base = {"status": k.get("상태", ""), "since": word(f, "시작 "), "next": word(f, "판정 ") or k.get("판정", ""),
                "decider": k.get("판정자", ""), "source": k.get("원본", ""), "metric_cmd": k.get("지표", "")}
        if sec == "Roles":
            fm = _front(os.path.join(CLAUDE_AGENTS, f"{f[0]}.md"))
            area = f[3] if len(f) > 3 else ""
            dept = area_names.get(area, area) or "영역 없음"
            node(f[0], dept, kind="역할", layer=f[2] if len(f) > 2 else "", model=fm.get("model", ""),
                 about=fm.get("description", ""), tools=fm.get("tools", ""), **base)
        elif sec == "Standing":
            if f[0] == "desk":
                fm = _front(os.path.join(CLAUDE_AGENTS, "orch.md"))
                node("desk", "데스크", kind="데스크 (orch)", layer=f[2], model=fm.get("model", ""),
                     about=fm.get("description", ""), tools=fm.get("tools", ""), **base)
            else:
                a = f[0].split(":", 1)[-1]
                node(f[0], area_names.get(a, a), kind="영역 담당", layer=f[2], model="opus (claude -p, 도구 없음)", head=True,
                     about=("상주 pane 이 아닌 호출형 판단자(`brief lead`, docs/area-lead-design.md). 그 영역 세션이 사용자에게 "
                            "판단을 물으면 데스크가 질문을 넘기고, 한 번 실행되어 끝난다. ① 영역 프로파일(~/.config/cmux/orch-areas.md 의 "
                            f"{area_names.get(a, a)} 절)의 권한표에서 그 종류(배치·답·닫기·커밋·규칙)가 user 면 거절 ② 먼저 묻는 영역·바깥 일·"
                            "보안·되돌릴 수 없는 일·계약을 건드리면 모델 없이 사용자에게 넘김 ③ 아니면 도구 없는 모델이 그 영역의 범위·"
                            "결정 기록·교훈만 보고 결정과 근거를 냄 ④ 권한이 decide 면 Decision log 에 by:lead 로 남기고 데스크가 세션에 "
                            "전달, advise 면 권고만. 실체는 모델이 아니라 그 영역 프로파일이다"), tools="없음", **base)
    for m in committee_members(hr, roster, cfg, measure=lambda n: {}):
        if not m["current"]:
            continue
        fm = _front(os.path.join(CLAUDE_AGENTS, f"{m['agent']}.md")) if m["agent"] != "-" else {}
        act = [{"day": _stamp((a["at"])), "what": a["id"], "text": " · ".join(a["did"])}
               for a in m["activity"]]
        node(m["name"], "위원회", kind="심판" if m["name"] == "judge" else "위원", layer="L1",
             model=f"{m['runner']}:{m['model']}", file_model=fm.get("model", ""), about=m.get("about") or m["approach"],
             approach=m["approach"], evidence=m["evidence"], rounds=m["rounds"], agree=m["agree"], tools=fm.get("tools", ""),
             status=m.get("roster", ""), since=m.get("since", ""), next=m.get("next", ""), decider="user",
             source=os.path.join(REPO, "agents", f"{m['agent']}.md") if m["agent"] != "-" else COMMITTEE_CFG,
             metric_cmd=f"agent-scout measure {m['name']}", head=m["name"] == "judge")
        nodes[-1]["activity"] = act + log.get(m["name"], [])
        if m["agent"] != "-":
            try:
                g = subprocess.run(["git", "-C", REPO, "log", "--diff-filter=A", "--format=%h %ad %s", "--date=format:%m-%d %H:%M",
                                    "--", f"agents/{m['agent']}.md"], capture_output=True, text=True, timeout=10).stdout.strip()
            except (OSError, subprocess.SubprocessError):
                g = ""
            if g:
                nodes[-1]["hired_why"] = (f"{g.splitlines()[-1]} — 위원회 설정(agent-committee.md)에 한 줄로 들어옴. 고용 투표는 없음 "
                                          f"(위원은 설정으로 앉는다). 접근: {m['approach']}")
    try:
        drafts = sorted(f[:-3] for f in os.listdir(os.path.join(hr, "agents")) if f.endswith(".md"))
    except OSError:
