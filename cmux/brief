def committee_members(hr=None, roster=None, cfg=None, measure=None):
    """기록 보관소의 '위원' 탭: 지금 위원(설정)과 예전 위원(기록에만 남은 이름)마다
    이력(모델·접근·증거·시작), 지표(agent-scout measure), 그동안 활동(앉은 회의와 그 회의에서 한 일)."""
    hr, roster, cfg = hr or HR, roster or ROSTER_MD, cfg or COMMITTEE_CFG
    try:
        ctext = open(cfg).read()
    except OSError:
        ctext = ""
    mem, judge, sec = {}, "", ""
    for ln in ctext.splitlines():
        if ln.startswith("## "):
            sec = ln[3:].strip()
        elif sec == "Members" and ln.startswith("| ") and not ln.startswith(("| member", "|---")):
            f = [x.strip() for x in ln.strip("|").split("|")]
            if len(f) >= 8:
                mem[f[0]] = {"name": f[0], "runner": f[1], "agent": f[2], "model": f[3], "approach": f[4],
                             "evidence": f[5], "status": f[6], "rounds": f[7] or "propose,evaluate", "current": True}
        elif sec == "Judge" and ln.startswith("- judge:"):
            judge = ln.split(":", 1)[1].split("#")[0].strip()
    if judge:
        mem["judge"] = {"name": "judge", "runner": judge.split(":")[0], "agent": "-", "model": judge.split(":")[-1],
                        "approach": "위원 밖에서 제안·심사 근거를 블라인드 채점하고, 근거가 약한 통과는 보류한다",
                        "evidence": "회의 기록", "status": "on", "rounds": "채점", "current": True}
    try:
        rtext = open(roster).read()
    except OSError:
        rtext = ""
    sec = ""
    for ln in rtext.splitlines():
        if ln.startswith("## "):
            sec = ln[3:].strip()
        elif sec == "Committee" and ln.startswith("- "):
            f = [x.strip() for x in ln[2:].split("|")]
            if f[0] in mem:
                kv = {x.split(":", 1)[0].strip(): x.split(":", 1)[1].strip() for x in f if ":" in x}
                st = {x.split(" ", 1)[0]: x.split(" ", 1)[1] for x in f if x.startswith(("시작 ", "판정 "))}
                mem[f[0]].update({"roster": kv.get("상태", ""), "since": st.get("시작", ""), "next": st.get("판정", "")})
    for m in mem.values():
        try:
            for ln in open(os.path.join(REPO, "agents", f"{m['agent']}.md")):
                if ln.startswith("description:"):
                    m["about"] = ln.split(":", 1)[1].strip().strip('"')
                    break
        except OSError:
            pass
    acts = {}
    try:
        names = sorted(f for f in os.listdir(hr) if f.endswith(".json"))
    except OSError:
        names = []
    for name in names:
        k = re.match(r"(quorum|eval|pilot-panel|failed-convene\d*)-", name)
        if not k:
            continue
        try:
            d = json.load(open(os.path.join(hr, name)))
            at = os.path.getmtime(os.path.join(hr, name))
        except (OSError, ValueError):
            continue
        mid = d.get("id") or name[:-5]
        seats = d.get("members") or d.get("scouts") or []
        for s in seats:
            n = s.get("name")
            if n not in mem:
                mem[n] = {"name": n, "runner": s.get("runner") or "", "agent": s.get("agent") or "", "current": False,
                          "model": s.get("model") or "", "approach": s.get("approach") or "", "evidence": s.get("evidence") or "",
                          "status": "이전 위원", "rounds": ""}
            did = []
            if s.get("error"):
                did.append("답하지 못함")
            if k.group(1) == "eval":
                for role, r in (d.get("results") or {}).items():
                    for rv in r.get("reviews") or []:
                        if rv.get("member") == n:
                            ko = lambda v: {"hire": "채용"}.get(v) or RESULT_KO.get(v, v)
                            did.append(f"{role}: {ko(rv.get('verdict'))} (최종 {ko(r.get('result'))}, 근거 점수 {rv.get('grounded', '-')}/2"
                                       + ("" if rv.get("counted", True) else ", 안 셈") + ")")
            else:
                cands = {c.get("kind"): c for c in d.get("candidates") or []}
                grades = {(g.get("member"), g.get("kind")): g for g in (d.get("judge") or {}).get("grades") or []}
                for p in (d.get("proposals") or {}).get(n) or []:
                    c, g = cands.get(p.get("kind")) or {}, grades.get((n, p.get("kind"))) or {}
                    did.append(f"제안 {p.get('role') or p.get('kind')} → {RESULT_KO.get(c.get('result'), c.get('result') or '-')}"
                               + (f" (심판 근거 {g.get('evidence')}·적합 {g.get('fit')})" if g else ""))
                for v in (d.get("votes") or {}).get(n) or []:
                    did.append(f"투표 {v.get('kind')}: {v.get('vote')}")
            acts.setdefault(n, []).append({"id": mid, "at": at, "did": did or ["(기록 없음)"]})
    for n, m in mem.items():
        m["activity"] = sorted(acts.get(n, []), key=lambda a: a["at"], reverse=True)
        if n == "judge":
            m["activity"] = [{"id": a["id"], "at": a["at"], "did": ["채점"]} for a in
                             committee_archive(hr, roster) if not a["failed"]]
        ev = [x for a in m["activity"] for x in a["did"] if "(최종 " in x]
        same = [x for x in ev if x.split(": ", 1)[1].split(" ")[0] == x.split("(최종 ")[1].split(",")[0]]
        m["agree"] = f"{len(same)}/{len(ev)}" if ev else ""
        if measure is not None:
            m["metrics"] = measure(n)
        else:
            try:
                r = subprocess.run([os.path.join(REPO, "bin", "agent-scout"), "measure", n, "--json"],
                                   capture_output=True, text=True, timeout=20)
                m["metrics"] = json.loads(r.stdout) if r.returncode == 0 else {}
            except (OSError, ValueError, subprocess.SubprocessError):
                m["metrics"] = {}
    return sorted(mem.values(), key=lambda m: (not m["current"], m["name"] == "judge", m["name"]))


