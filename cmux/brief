def any_pane(panel):
    """cmux 가 에이전트를 모르는 pane(재시작 전부터 떠 있던 세션 등)도 panel id 로 찾는다. 없으면 None."""
    try:
        items = json.loads(cmux("current", "--json", "--limit", "200").stdout)["items"]
    except (ValueError, KeyError):
        return None
    for it in items:
        proj = (it.get("projections") or [{}])[0]
        if (proj.get("panel_id") or "").lower() == panel.lower():
            return {"panel": proj["panel_id"], "workspace": proj.get("workspace_id"), "title": it.get("label", ""),
                    "cwd": (it.get("cwd") or "").replace(HOME, "~"), "agent": None, "state": None, "session": None}
    return None


def resolve(ref, unlisted=False):
    """번호(TODO 목록) 또는 panel id → (panel, workspace, title).
    unlisted: 세션 목록에 없는 pane 도 panel id 로 받는다(`brief send`)."""
    plan = load_plan()
    if ref == "here":
        ref = os.environ.get("CMUX_PANEL_ID") or sys.exit("brief: cmux pane 안이 아닙니다 (CMUX_PANEL_ID 없음)")
    if ref.isdigit():
        i = int(ref) - 1
        if not 0 <= i < len(plan["items"]):
            sys.exit(f"brief: 목록에 {ref}번이 없습니다 (총 {len(plan['items'])}개)")
        ref = plan["items"][i]["panel"]
    ss = sessions()
    for s in ss:
        if s["panel"].lower() == ref.lower():
            return s
    if unlisted and (p := any_pane(ref)):
        return p
    hits = [s for s in ss if ref.lower() in s["title"].lower()]
    if len(hits) == 1:
        return hits[0]
    if hits:
        sys.exit("brief: 여러 세션이 맞습니다. 더 길게 적어 주세요:\n" + "\n".join("  " + s["title"] for s in hits))
    sys.exit("brief: 그 세션의 pane 을 찾지 못했습니다 (닫혔을 수 있음): " + ref)


