            cols = shutil.get_terminal_size((120, 40)).columns
            working = sum(1 for x in ss if x["state"] == "working")
            head = (f"{spin[k % 4]} 에이전트 제어 구조  {time.strftime('%H:%M:%S')}  · 세션 {len(snap) - (1 if dl in {p.lower() for p in snap} else 0)}"
                    f" · 일하는 중 {working} · 오늘 이벤트 {sum(1 for e in evs if now - e['at'] < 86400)}  (Ctrl-C 로 닫기)")
            body = [("\033[1m" + head + "\033[0m") if color else head, ""] + \
                tree_lines(data, evs, now, color, cols) + [""] + event_lines(evs, now, color, 12, cols)
            sys.stdout.write("\033[H" + "".join(l + "\033[K\n" for l in body) + "\033[J")
            sys.stdout.flush()
            k += 1
            if frames and k >= frames:
                return
            time.sleep(interval)
    except KeyboardInterrupt:
        return


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "show"
    if cmd == "lead":  # 영역 담당 호출(따로 둔 스크립트, 도움말도 그쪽)
        lead = os.path.join(os.path.dirname(os.path.realpath(__file__)), "brief-lead")
        os.execv(sys.executable, [sys.executable, lead, *argv[2:]])
    if cmd in ("-h", "--help", "help") or any(a in ("-h", "--help") for a in argv[2:3]):
        print(__doc__)  # 도움말: 보고·메모로 보내거나 목록을 바꾸지 않는다(11-23: `brief report --help` 가 보고로 나감)
        return
    if cmd == "sessions":
        ss = sessions()
        for g in teams(ss):  # collab 묶음에 속한 세션에 이름을 붙여 준다
            for m in g["members"]:
                for s in ss:
                    if s["panel"] == m["panel"]:
                        s["collab"] = g["name"]
        rc, fx = recaps(ss), facts(ss)
        for x in ss:
            if x["panel"].lower() in rc:
                x["recap"] = rc[x["panel"].lower()]
            x.update(fx.get(x["panel"].lower(), {}))
        print(json.dumps(ss, ensure_ascii=False, indent=1))
    elif cmd == "note" and len(argv) > 2:  # 목표 밖의 발견을 데스크에 넘긴다(고치지 않고)
        text = " ".join(argv[2:]).strip()
        me, s = me_session()
        os.makedirs(os.path.dirname(NOTES), exist_ok=True)
        with open(NOTES, "a") as f:
            f.write(json.dumps({"at": int(time.time()), "panel": s.get("panel") or me, "title": s.get("title", ""),
                                "cwd": s.get("cwd") or os.getcwd().replace(HOME, "~"), "text": text},
                               ensure_ascii=False) + "\n")
        log_event("note", s.get("panel") or me, s.get("title", ""), text=text[:100])
        patrol(False)
        print("데스크에 넘김: " + text + " (이 세션은 본래 일을 계속하세요)")
    elif cmd == "report" and len(argv) > 2:  # 데스크에 보고. 주소는 지금 찾고, 못 보내도 기록이 남는다
        text = sys.stdin.read() if argv[2:] == ["-"] else " ".join(argv[2:])
        if not text.strip():
            sys.exit("brief: 보고 내용이 비었습니다")
        report(text.strip())
    elif cmd == "send" and len(argv) > 3:  # 데스크가 세션에 일·결정을 넘긴다
        s = resolve(argv[2], unlisted=True)
        text = sys.stdin.read() if argv[3:] == ["-"] else " ".join(argv[3:])
        if not text.strip():
            sys.exit("brief: 보낼 글이 비었습니다")
        ok, line = send(s, text.strip())
        print(f"{line} — {s['title'] or s['panel']}")
        if not ok:
            sys.exit(1)
    elif cmd == "desk":  # 데스크(orch) panel id. 없으면 exit 1
        d = desk_panel()
        if not d:
            sys.exit(1)
        print(d)
    elif cmd == "tree":  # 에이전트 제어 구조: 사용자 → 데스크 → 영역 → 세션, 실시간 이벤트
        tree_cmd(argv[2:])
    elif cmd == "teams":
        print(json.dumps(teams(), ensure_ascii=False, indent=1))
    elif cmd == "plan":
        items = json.load(sys.stdin)
        known = {s["panel"].lower(): s for s in sessions()}
        plan = {"at": int(time.time()), "items": []}
        for it in items:
            s = known.get(str(it.get("panel", "")).lower())
            if not s:
                sys.exit("brief: 모르는 panel 입니다 (brief sessions 의 panel 값을 쓰세요): " + str(it.get("panel")))
            plan["items"].append({"panel": s["panel"], "workspace": s["workspace"],
                                  "title": s["title"], "do": str(it.get("do", "")).strip(), "done": False})
        save_plan(plan)
        print(f"TODO {len(plan['items'])}개를 Sessions 패널에 올렸습니다.")
    elif cmd == "add" and len(argv) > 3:
        s = resolve(argv[2])
        plan = load_plan()
        if any(it["panel"] == s["panel"] and not it["done"] for it in plan["items"]):
            sys.exit("brief: 이미 목록에 있는 세션입니다: " + s["title"])
        plan["at"] = int(time.time())
        plan["items"].append({"panel": s["panel"], "workspace": s["workspace"],
                              "title": s["title"], "do": " ".join(argv[3:]).strip(), "done": False})
        save_plan(plan)
        print(f"{len(plan['items'])}번으로 추가: {s['title']}")
    elif cmd in ("go", "ping") and len(argv) > 2:
        s = resolve(" ".join(argv[2:]).strip())
        if cmd == "go":
            r = cmux("select-workspace", "--workspace", s["workspace"])
            r2 = cmux("focus-panel", "--panel", s["panel"], "--workspace", s["workspace"])
            if r.returncode or r2.returncode:
                sys.exit("brief: 이동 실패: " + (r.stderr + r2.stderr).strip())
        r = flash(s)
        if r.returncode:
            sys.exit("brief: 깜빡이기 실패: " + r.stderr.strip())
        print(("이동: " if cmd == "go" else "핑: ") + s["title"])
    elif cmd == "done" and len(argv) > 2:
        rest, note = argv[2:], None
        if "--verified" in rest:  # --verified "<검토 기록>"
            k = rest.index("--verified")
            if k + 1 >= len(rest) or not rest[k + 1].strip() or rest[k + 1].startswith("--"):
                sys.exit('brief: --verified 뒤에 검토 기록을 붙여 주세요. 예: --verified "git status 깨끗, PR #12 확인"')
            note, rest = rest[k + 1], rest[:k] + rest[k + 2:]
        flags = [a for a in rest if a.startswith("--")]
        ref = " ".join(a for a in rest if not a.startswith("--")).strip()
        undo = "--undo" in flags
        final = undo or note is not None or "--now" in flags  # 검토를 거쳤거나(--verified) 내가 건너뛰었을 때(--now)만 끝낸다
        plan = load_plan()
        s = None
        if ref.isdigit():
            i = int(ref) - 1
            if not 0 <= i < len(plan["items"]):
                sys.exit(f"brief: 목록에 {ref}번이 없습니다")
            idx, title = [i], plan["items"][i]["title"]
            if not undo:
                s = next((x for x in sessions() if x["panel"] == plan["items"][i]["panel"]), None)
        else:
            s = resolve(ref)
            idx = [n for n, it in enumerate(plan["items"]) if it["panel"] == s["panel"] and it["done"] == undo]
            title = s["title"]
        if not final:  # 완료 표시 전에 세션의 보고를 받아 데스크가 대조한다
            ok, why = request_close(s) if s else (False, "보고 요청 생략: 이미 닫힌 세션입니다 (데스크가 직접 확인 후 --verified)")
            for i in idx:
                plan["items"][i]["review"] = True
            if idx:
                save_plan(plan)
            print(f"완료 검토 요청 보냄: {title} — {why} (세션이 보고하면 데스크가 대조한 뒤 완료 처리합니다)" if ok else why)
            render()
            return
        if not undo and s and "--keep" not in flags and "--drop-unsent" not in flags \
                and s["panel"].lower() != os.environ.get("CMUX_PANEL_ID", "").lower():
            d, _, _, why = input_box(s)  # 사용자가 그 pane 에 쓰는 중인 글이 있으면 닫지 않는다(11-23: 두 pane 의 쓰던 글을 닫아 버림)
            if why and not d:
                print(f"참고: {title} — {why}. 마지막 답 뒤 사용자 입력이 없어 쓰던 글이 없다고 봅니다")
            if d:
                sys.exit(f"닫지 않음: {title} 의 입력 칸에 보내지 않은 글이 있습니다(사용자가 쓰는 중일 수 있음):\n  '{d[:300]}'\n"
                         "그 글이 세션에 할 일을 더하는지 보고, 사용자가 쓰다 만 글이 아니라고 확인했을 때만 "
                         "--drop-unsent 를 붙여 다시 부르세요(글은 닫힘 기록에 남습니다)")
        if idx:
            save_plan(plan)
            print(("되돌림: " if undo else "완료: ") + title + (f" (검토: {note})" if note else ""))
        if undo:
            pass
        elif "--keep" in flags or not s:
            if s:
                log_closed(s, note, False)
            print("세션은 열어 둡니다" if s else "세션은 이미 닫혀 있습니다")
        else:
            why = close_session(s, "--force" in flags, note)
            print(why or "세션 닫음: " + title + " (기록·다시 열기: brief closed)")
        render()
    elif cmd == "patrol" and "--input" in argv:  # 사용자 입력 신호(UserPromptSubmit)
        input_signal(argv)
    elif cmd == "patrol" and "--input-check" in argv:
        k = argv.index("--input-check")
        patrol(False, (argv[k + 1], float(argv[k + 2])))
    elif cmd == "patrol":
        patrol("--read" in argv)
    elif cmd == "answered":  # Desk 패널이 읽는다(P12)
        try:
            print(json.dumps(answered(), ensure_ascii=False, separators=(",", ":")))
        except Exception:
            print("[]")
    elif cmd == "doc":  # 가장 최근 데스크 문서의 절대 경로 (mod 가 읽는다. 세션의 cwd 와 무관해야 한다)
        d = os.path.join(DESK_DIR, "Desk")
        docs = sorted(f for f in os.listdir(d) if re.fullmatch(r"\d+\.md", f)) if os.path.isdir(d) else []
        if docs:
            print(os.path.join(d, docs[-1]))
    elif cmd == "board":
        if "--set" in argv:
            k = argv.index("--set")
            day = argv[argv.index("--day") + 1] if "--day" in argv else board_day()
            board_set([a for a in argv[k + 1:] if "=" in a], day)
            print(board_trend(7))
            return
        if "--trend" in argv:
            k = argv.index("--trend")
            print(board_trend(int(argv[k + 1]) if len(argv) > k + 1 and argv[k + 1].isdigit() else 14))
            return
        rows = board(log="--log" in argv)
        if "--json" in argv:
            print(json.dumps(rows, ensure_ascii=False))
        else:
            for r in rows:
                print(("! " if r["warn"] else "  ") + r["k"] + ": " + r["text"])
    elif cmd == "view":
        print(desk_view(force=True) or "이미 열려 있습니다")
    elif cmd == "review":
        review(float(argv[2]) if len(argv) > 2 else 1)
    elif cmd == "audit":  # 닫기 검사: 데스크가 아닌 도구가 닫힌 세션을 다시 판정한다
        day = argv[argv.index("--day") + 1] if "--day" in argv else board_day()
        res = audit(day, fresh="--fresh" in argv)
        live = held_open() if day == board_day() else []  # 지금 열려 있는 것은 오늘만 본다
        if "--json" in argv:
            print(json.dumps(res + [{"panel": x["panel"], "title": x["title"], "verdict": "open", "by": "desk",
                                     "held": [[int(a), int(b)] for a, b in h]} for x, h in live], ensure_ascii=False))
            return
        n = audit_counts(res, live)
        print(f"{day} 닫힘 {n['closed']}건 · 일이 남은 채 닫음 {n['left']} (데스크 {n['wrong_close']})"
              f" · 보고 없이 닫음 {n['noreport']} (데스크 {n['closed_noreport']})"
              f" · 끝났는데 열어 둠 {n['held_open']} (지금 열림 {len(live)}, 기준 {HELD_MIN:g}분)"
              f" · 호출자가 닫은 일꾼 {n['caller']} · 규칙 v{AUDIT_V}")
        for x, h in live:
            print(f"! 지금 열림  {x['title']}\n    끝났는데 열어 둠: {held_text(h)} · 닫기: brief done {x['panel']}")
        recs = {audit_key(r): r for r in (json.loads(l) for l in open(CLOSED) if l.strip())} if res else {}
        for a in sorted(res, key=lambda a: (a["verdict"] != "left", not a.get("held"), a["verdict"] != "unreported", a["at"])):
            if (a["verdict"] == "ok" or a["by"] == "caller") and not a.get("held") and "--all" not in argv:
                continue
            rec = recs.get(audit_key(a), {})
            print(f"{'! ' if (a['verdict'] == 'left' and a['by'] != 'caller') or a.get('held') else '  '}"
                  f"{time.strftime('%m-%d %H:%M', time.localtime(a['at']))}  {a['title']}"
                  f"\n    {audit_line(a)}" + (f"\n    {resume_cmd(rec)}" if resume_cmd(rec) else ""))
    elif cmd == "closed":
        try:
            recs = [json.loads(l) for l in open(CLOSED) if l.strip()]
        except (OSError, ValueError):
            recs = []
        try:
            mark = json.load(open(CLOSED_MARK))
        except (OSError, ValueError):
            mark = {}
        if "--ack" in argv:  # 데스크가 보고에 넣은 뒤: 마지막 --unreported 로 본 것까지 보고한 것으로 친다
            mark["reported"] = max(mark.get("reported", 0), mark.get("seen", 0))
            with open(CLOSED_MARK, "w") as f:
                json.dump(mark, f)
            print("보고함으로 표시: " + time.strftime("%m-%d %H:%M", time.localtime(mark["reported"])) + " 까지")
            return
        unrep = "--unreported" in argv
        if unrep:  # 아직 보고에 들어가지 않은 기록 전부. 본 지점은 --ack 가 확정한다
            recs = [r for r in recs if r["at"] > mark.get("reported", 0)]
            if recs:
                mark["seen"] = max(r["at"] for r in recs)
                os.makedirs(os.path.dirname(CLOSED_MARK), exist_ok=True)
                with open(CLOSED_MARK, "w") as f:
                    json.dump(mark, f)
        else:
            recs = recs[-10:]
        try:  # 닫기 검사(brief audit)의 판정: 데스크의 검토 기록과 따로, 일이 남은 채 닫혔는지
            au = {audit_key(a): a for a in audit(recs=recs)}
        except Exception:
            au = {}
        for rec in reversed(recs):
            how = ("검토: " + rec["verified"]) if rec.get("verified") else "검토 없이 닫음"
            if not rec.get("closed", True):
                how += " · pane 은 열어 둠"
            warn = False
            if "check" in rec:
                c = rec["check"]
                got = [f"{name} {c[k]}" for k, name in (("uncommitted", "미커밋"), ("unpushed", "미push")) if k in c]
                got += [f"미응답 질문 \"{c['question']}\""] if c.get("question") else []
                warn = not rec.get("verified") and bool(c.get("uncommitted") or c.get("unpushed") or c.get("question"))
                how += " · 닫힐 때 대조: " + (", ".join(got) or "git 저장소 아님, 질문 없음")
            a = au.get(audit_key(rec))
            if a and a["verdict"] != "ok":
                how += "\n    검사: " + audit_line(a)
                warn = warn or a["verdict"] == "left"
            print(f"{'! ' if warn else ''}{time.strftime('%m-%d %H:%M', time.localtime(rec['at']))}  {rec['title']}\n    {how}\n    {resume_cmd(rec)}")
        if not recs:
            print("(보고 안 한 닫힌 세션 없음)" if unrep else "(닫은 세션 기록 없음)")
    elif cmd == "show":
        plan = load_plan()
        for n, it in enumerate(plan["items"], 1):
            print(f"{n}. [{'x' if it['done'] else ' '}] {it['title']} — {it['do']}")
        if not plan["items"]:
            print("(TODO 목록 없음)")
    elif cmd == "render":
        render()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
