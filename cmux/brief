def board_day(now=None):
    return time.strftime("%Y-%m-%d", time.localtime((now or time.time()) - 5 * 3600))  # 05시 이전은 전날


def board_history():
    try:
        return [json.loads(l) for l in open(BOARD_LOG) if l.strip()]
    except (OSError, ValueError):
        return []


def board_write(hist):
    os.makedirs(os.path.dirname(BOARD_LOG), exist_ok=True)
    tmp = BOARD_LOG + ".tmp"
    with open(tmp, "w") as f:
        for h in hist:
            f.write(json.dumps(h, ensure_ascii=False) + "\n")
    os.replace(tmp, BOARD_LOG)


def board_log(metrics, force=False):
    """오늘 줄을 지금 값으로 바꿔 쓴다(그날의 마지막 값이 남는다). orch 가 직접 적은 값(manual)은 지킨다."""
    hist, day, now = board_history(), board_day(), int(time.time())
    cur = next((h for h in hist if h.get("day") == day), None)
    if cur and not force and now - cur.get("at", 0) < 1800:
        return
    if cur is None:
        cur = {"day": day}
        hist.append(cur)
    cur.update({k: v for k, v in metrics.items() if k not in cur.get("manual", [])}, at=now)
    board_write(hist)


def board_set(pairs, day):
    """orch 가 센 값을 그날 줄에 적는다: brief board --set corrections=3 roundtrips=1.8 [--day YYYY-MM-DD]"""
    hist = board_history()
    cur = next((h for h in hist if h.get("day") == day), None)
    if cur is None:
        cur = {"day": day, "at": int(time.time())}
        hist.append(cur)
        hist.sort(key=lambda h: h["day"])
    for kv in pairs:
        k, _, v = kv.partition("=")
        if k not in SERIES:
            sys.exit(f"brief: 모르는 지표입니다: {k} (쓸 수 있는 것: {', '.join(SERIES)})")
        cur[k] = float(v) if "." in v else int(v)
        cur["manual"] = sorted(set(cur.get("manual", [])) | {k})  # 도구가 다시 세어 덮지 않는다
    board_write(hist)


def spark(key, hist, days=7):
    """최근 며칠의 값을 작은 막대로. 이틀치가 안 되면 빈 문자열."""
    vals = [h[key] for h in hist[-days:] if isinstance(h.get(key), (int, float))]
    if len(vals) < 2:
        return ""
    lo, hi = min(vals), max(vals)
    return f" · {len(vals)}일 " + "".join(SPARK[int((v - lo) / (hi - lo) * 7) if hi > lo else 0] for v in vals)


def desk_decisions():
    """오늘 데스크 문서의 `## 결정 필요` 건수. 문서가 없으면 None."""
    d = os.path.join(DESK_DIR, "Desk")
    docs = sorted(f for f in os.listdir(d) if re.fullmatch(r"\d+\.md", f)) if os.path.isdir(d) else []
    if not docs:
        return None
    n, on = 0, False
    for line in open(os.path.join(d, docs[-1])):
        if line.startswith("#"):
            on = line.lstrip("# ").startswith("결정 필요")
        elif on and re.match(r"\s*(\d+\.|[-*])\s+\S", line) and "없음" not in line[:8]:
            n += 1
    return n


BULLET = re.compile(r"^\s*(?:[-*]|\d+\.)\s+")


def latest_doc():
    """가장 최근 데스크 문서의 경로. 없으면 None."""
    d = os.path.join(DESK_DIR, "Desk")
    docs = sorted(f for f in os.listdir(d) if re.fullmatch(r"\d+\.md", f)) if os.path.isdir(d) else []
    return os.path.join(d, docs[-1]) if docs else None


def doc_decisions(path):
    """`## 결정 필요`의 줄을 Desk 패널(brief-mod 의 parseDesk)과 같은 기준·순서로 읽는다. [(줄, TODO 번호 또는 0)]"""
    out, on = [], False
    try:
        lines = open(path).read().splitlines()
    except OSError:
        return []
    for line in lines:
        h = re.match(r"^#{1,3}\s+(.*)$", line)
        if h:
            title = h.group(1).strip()
            if title.startswith("타임라인"):
                break
            on = title.startswith("결정 필요")
            continue
        if not on or not BULLET.match(line):
            continue
        text = re.sub(r"\*\*|`", "", BULLET.sub("", line)).strip()
        if text and text != "없음":
            m = re.search(r"\((\d+)번\)", text)
            out.append((text, int(m.group(1)) if m else 0))
    return out


def decision_panels(path=None):
    """`결정 필요`에 걸린 세션의 panel(소문자) 집합. 결정 줄의 "(N번)" 을 TODO 목록으로 바꾼다."""
    path = path or latest_doc()
    items = load_plan()["items"]
    return {items[n - 1]["panel"].lower() for _, n in (doc_decisions(path) if path else []) if 0 < n <= len(items)}


def answered(ss=None):
    """P12: 결정 줄마다 그 줄이 올라온 뒤 그 세션 pane 에 사용자 입력이 있었는지.
    올라온 때 = brief 가 그 줄을 처음 본 때의 문서 수정 시각(RAISED 에 남긴다. 문서에서 빠진 줄은 지운다).
    [{"i": 문서 순서, "n": TODO 번호, "answered": True, "input_at": "MM-DD HH:MM"}]"""
    path = latest_doc()
    if not path:
        return []
    rows = doc_decisions(path)
    try:
        seen = json.load(open(RAISED))
    except (OSError, ValueError):
        seen = {}
    mtime = os.path.getmtime(path)
    raised = {t: seen.get(t, mtime) for t, _ in rows}
    if raised != seen:
        os.makedirs(os.path.dirname(RAISED), exist_ok=True)
        json.dump(raised, open(RAISED + ".tmp", "w"), ensure_ascii=False)
        os.replace(RAISED + ".tmp", RAISED)
    items = load_plan()["items"]
    if any(0 < n <= len(items) for _, n in rows):
        live = {x["panel"].lower(): x for x in (ss if ss is not None else sessions())}
    else:
        live = {}
    seen_input, out = {}, []
    for i, (text, n) in enumerate(rows):
        r = {"i": i, "n": n}
        x = live.get(items[n - 1]["panel"].lower()) if 0 < n <= len(items) else None
        if x:
            if x["panel"] not in seen_input:
                seen_input[x["panel"]] = turns(x)["input"]
            t = seen_input[x["panel"]]
            if t > raised[text]:
                r.update(answered=True, input_at=hhmm(t))
        out.append(r)
    return out


ASKED = os.path.join(HOME, ".local/share/cmux/asked.json")  # 날짜 -> 그날 사용자에게 넘긴 결정(제목 -> 종류)
# 데스크가 묻지 않고 해야 하는 일(orch.md 의 Do it, then report)을 사용자에게 넘긴 줄. 종류 -> 알아보는 말.
AVOIDABLE = {
    "배치": re.compile(r"띄울지|배치할지|맡길지|다시 열지|세션을 (하나 )?띄우|새 세션에 맡기"),
    "닫기": re.compile(r"닫을지|데스크가 (대조한 뒤 |대조해 )?닫|닫지 않습니다|끝났다고 (말씀|하시)|끝난 일인지"),
}

# 제목이 이런 일이면 사용자에게 넘기는 것이 맞다(바깥으로 나가는 일, 트래커, 지우기): 닫기 문구가 붙어 있어도 세지 않는다.
OUTWARD = re.compile(r"push|보내|넘길지|알릴지|전할지|티켓|Jira|DB|삭제|sudo|권한|비밀")


def desk_asks(path):
    """데스크 문서에서 사용자에게 넘긴 것: `결정 필요`의 모든 줄과, `진행 중`에서 대조를 마치고도 사용자의 말을
    기다리며 열어 둔 세션 줄. [(제목, 종류)] — 종류는 데스크가 스스로 할 수 있었던 일이면 AVOIDABLE 의 키, 아니면 ''."""
    out, sec = [], ""
    for line in open(path):
        if line.startswith("#"):
            sec = line.lstrip("# ").strip()
            continue
        if not re.match(r"\s*(\d+\.|[-*])\s+\S", line) or "없음" in line[:8]:
            continue
        body = re.sub(r"^\s*(\d+\.|[-*])\s+", "", line).strip()
        title = body.split(" — ")[0].strip("* ")
        kind = "" if OUTWARD.search(title) else \
            next((k for k, rx in AVOIDABLE.items() if rx.search(title if k == "배치" else body)), "")
        if sec.startswith("결정 필요"):
            out.append((title, kind))
        elif sec.startswith("진행 중") and kind == "닫기":
            out.append((title, kind))
    return out


def asked_today(day):
    """오늘 데스크 문서에 한 번이라도 올라온 넘긴 결정을 모은다(문서 윗부분은 다시 쓰여 사라지므로 볼 때마다 더한다).
    {제목: 종류}. 문서가 없으면 None."""
    d = os.path.join(DESK_DIR, "Desk")
    doc = os.path.join(d, time.strftime("%y%m%d", time.strptime(day, "%Y-%m-%d")) + ".md")
    try:
        allx = json.load(open(ASKED))
    except (OSError, ValueError):
        allx = {}
    seen = allx.get(day, {})
    if os.path.exists(doc):
        new = {re.sub(r"\s+", " ", t): k for t, k in desk_asks(doc)}
        if any(t not in seen for t in new):
            seen.update({t: k for t, k in new.items() if t not in seen})
            allx = {d: v for d, v in allx.items() if d >= time.strftime("%Y-%m-%d", time.localtime(time.time() - 60 * 86400))}
            allx[day] = seen
            os.makedirs(os.path.dirname(ASKED), exist_ok=True)
            with open(ASKED + ".tmp", "w") as f:
                json.dump(allx, f, ensure_ascii=False)
            os.replace(ASKED + ".tmp", ASKED)
    elif not seen:
        return None
    return seen


def board(log=False):
    """에이전트 전체의 지표 몇 줄: 세션, 오늘 완료(검토 여부), 두 개선 루프(orch 교훈, 차단 훅).
    각 줄은 {k: 이름, text: 값, warn: 살펴봐야 하면 true}. 하루 한 줄씩 BOARD_LOG 에 쌓아 추이를 붙인다."""
    now, rows, m = time.time(), [], {}
    hist = board_history()
    day = board_day(now)
    try:
        asked = asked_today(day)
    except (OSError, ValueError):
        asked = None
    if asked is not None:
        av = [k for k in asked.values() if k]
        cur = next((h for h in hist if h.get("day") == day), {})
        m.update(asked=len(asked), avoidable=len(av))
        shown = {k: cur[k] if k in cur.get("manual", []) else m[k] for k in ("asked", "avoidable")}
        kinds = " · ".join(f"{k} {av.count(k)}" for k in AVOIDABLE if av.count(k))
        rows.append({"k": "사용자에게 넘김", "text": f"오늘 {shown['asked']}건 · 데스크가 할 수 있었던 것 {shown['avoidable']}"
                     + (f" ({kinds})" if kinds else "") + spark("avoidable", hist), "warn": shown["avoidable"] > 0})
    ss = sessions()
    work = sum(x["state"] == "working" for x in ss)
    cut = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now - 86400))  # last_activity 는 UTC ISO 문자열
    stale = sum((x.get("last_activity") or cut) < cut for x in ss)
    codex = sum(x["agent"] == "codex" for x in ss)
    m.update(sessions=len(ss), working=work, stale=stale)
    rows.append({"k": "세션", "text": f"{len(ss)}개 · 일하는 중 {work} · 하루 넘게 멈춤 {stale}"
                 + (f" · Codex {codex}" if codex else "") + spark("stale", hist), "warn": False})
    try:
        recs = [json.loads(l) for l in open(CLOSED) if l.strip()]
    except (OSError, ValueError):
        recs = []
    today = [r for r in recs if time.strftime("%Y-%m-%d", time.localtime(r["at"] - 5 * 3600)) == day]
    ver = sum(bool(r.get("verified")) for r in today)
    items = load_plan().get("items", [])
    rev = sum(bool(it.get("review")) and not it.get("done") for it in items)
    dec = desk_decisions()
    m.update(done=len(today), unverified=len(today) - ver, reviewing=rev,
             todo_left=sum(not it.get("done") for it in items))
    if dec is not None:
        m["decisions"] = dec
    rows.append({"k": "오늘 완료", "text": f"{len(today)}건 (검토 거침 {ver} · 검토 없이 {len(today) - ver}) · 검토 중 {rev}"
                 f" · TODO {m['todo_left']}/{len(items)}" + spark("unverified", hist), "warn": len(today) > ver})
    try:  # 닫기 검사: 데스크가 아닌 도구가 오늘 닫힌 세션을 다시 판정한 결과(brief audit)
        n = audit_counts(audit(day))
        left, norep = n["wrong_close"], n["closed_noreport"]
        m.update(closed_desk=n["closed_desk"], wrong_close=left, closed_noreport=norep, audit_v=AUDIT_V)
        rows.append({"k": "닫기 검사", "text": f"데스크가 닫음 {n['closed_desk']} · 일이 남은 채 닫음 {left} · 보고 없이 닫음 {norep}"
                     + spark("wrong_close", hist) + (" (brief audit)" if left or norep else ""), "warn": left > 0 or norep > 0})
    except Exception:
        pass
    try:  # 끝났는데 열어 둠: 완료 보고나 '남은 일 없음' 뒤 HELD_MIN 분 넘게 열어 둔 세션(오늘 닫힌 것 + 지금 열린 것)
        late = audit_counts(audit(day))["held"]
        live = held_open(ss)
        m.update(held_open=late + len(live))
        names = ", ".join(f"{x['title'][:24]} {held_text(h).split(' (')[0]}" for x, h in live[:3])
        rows.append({"k": "끝났는데 열어 둠", "text": f"{late + len(live)}건 (닫힌 것 {late} · 지금 열림 {len(live)}"
                     + (f": {names}" if names else "") + f") · 기준 {HELD_MIN:g}분" + spark("held_open", hist),
                     "warn": late + len(live) > 0})
    except Exception:
        pass
    if dec is not None:
        rows.append({"k": "결정 대기", "text": f"{dec}건" + spark("decisions", hist), "warn": False})
    ls = md_sections(LESSONS)
    if ls:
        les = ls.get("교훈", [])
        ok = sum(int(m) for l in les for m in re.findall(r"ok:(\d+)", l))
        miss = sum(int(m) for l in les for m in re.findall(r"miss:(\d+)", l))
        prop = len(ls.get("제안", []))
        ws = md_sections(WRITING)
        at = time.strftime("%m-%d", time.localtime(os.path.getmtime(os.path.realpath(LESSONS))))
        m.update(lessons=len(les), ok=ok, miss=miss, proposals=prop)
        last = next((h for h in reversed(hist) if "corrections" in h), None)
        rows.append({"k": "개선: orch", "text": f"교훈 {len(les)} (지킴 {ok} · 어김 {miss}) · 제안 {prop}"
                     f" · 글쓰기 조정 {len(ws.get('조정', []))} · 피드백 {len(ws.get('피드백', []))} · 고친 날 {at}"
                     + (f" · 고쳐 말함 {last['corrections']}회({last['day'][5:]})" + spark("corrections", hist) if last else ""),
                     "warn": prop > 0 or miss > 0})
    try:
        st = json.load(open(os.path.join(GUARD, "state.json")))
        last = st.get("last_report") or {}
        rep = json.load(open(os.path.join(GUARD, "reports", last["id"] + ".json")))
        vs = rep["scorecard"]["versions"]
        pct = lambda v, key: f"{v[key] * 100:.1f}%"
        cons = rep.get("concerns") or []
        bad = sum(c[0] == "심각" for c in cons)
        seen = bool(last.get("reviewed_at"))
        rows.append({"k": "개선: 차단 훅", "text": f"{last['id']} · 잘못 막음 {pct(vs[0], 'wrong_block_rate')}→{pct(vs[-1], 'wrong_block_rate')}"
                     f" · 놓침 {pct(vs[0], 'miss_rate')}→{pct(vs[-1], 'miss_rate')} · 우려 {len(cons)}(심각 {bad})"
                     + (" · 멈춤" if st.get("paused") else "") + (" · 확인함" if seen else " · 리포트 미확인(/guard-review)"),
                     "warn": bad > 0 or not seen or bool(st.get("paused"))})
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        pass
    try:
        board_log(m, force=log)
    except OSError:
        pass
    return rows


AUDIT_SERIES = ("closed_desk", "wrong_close", "closed_noreport", "held_open")  # `brief audit` 이 세는 열


def board_trend(days):
    """날짜별 표. 닫기 검사 열(AUDIT_SERIES)은 적어 둔 값이 아니라 지금 규칙의 `brief audit` 으로 다시 센 값이다:
    판정 규칙이 바뀌면 적어 둔 값과 다시 센 값이 갈라지므로, 다른 날은
    적어 둔 값과 그 규칙 버전을 표 아래에 남긴다."""
    hist = [dict(h) for h in board_history()[-days:]]
    if not hist:
        return "(기록 없음)"
    today, notes = board_day(), []
    for h in hist:
        try:
            n = audit_counts(audit(h["day"]), held_open() if h["day"] == today else ())
        except Exception:
            continue
        diff = [f"{SERIES[k]} {h[k]}→{n[k]}" for k in AUDIT_SERIES if k in h and h[k] != n[k]]
        if diff and h["day"] != today:  # 오늘 줄은 마지막 기록 뒤의 닫힘만큼 다른 것이 당연하다
            notes.append(f"  {h['day'][5:]} 적어 둔 값(규칙 {'v' + str(h['audit_v']) if 'audit_v' in h else '버전 기록 없음'})"
                         f" → 다시 셈: {', '.join(diff)}")
        h.update({k: n[k] for k in AUDIT_SERIES})
    keys = [k for k in SERIES if any(k in h for h in hist)]
    out = [f"닫기 검사 열({', '.join(SERIES[k] for k in AUDIT_SERIES)})은 brief audit 규칙 v{AUDIT_V} 로 다시 센 값", *notes,
           "날짜   " + " ".join(f"{SERIES[k]:>6}" for k in keys)]
    for h in hist:
        out.append(h["day"][5:] + "  " + " ".join(f"{h.get(k, '-'):>{6 + len(SERIES[k])}}" for k in keys))
    return "\n".join(out)


def patrol(read, inp=None):
    """순찰. 턴 끝(Stop)과 pane 닫힘(surface.closed)과 사용자 입력(UserPromptSubmit)이 동시에 부를 수 있어
    한 번에 하나만 돈다(닫힌 세션이 두 번 기록되지 않게). inp: (panel, 입력 신호 시각) — 사용자 입력 신호."""
    with patrol_lock():
        _patrol(read, inp)


def event_panel():
    """cmux 자동화가 넘긴 이벤트의 surface_id(= panel id). 없으면 None."""
    try:
        ev = json.loads(os.environ.get("CMUX_AUTOMATION_EVENT_JSON") or "{}")
    except ValueError:
        return None
    return ev.get("surface_id") or (ev.get("payload") or {}).get("surface_id")


def input_signal(argv):
    """`brief patrol --input [panel]`: 자동화는 곧 끝내고, 대화 기록이 쓰일 시간을 두고 따로 확인한다."""
    k = argv.index("--input")
    panel = argv[k + 1] if len(argv) > k + 1 and not argv[k + 1].startswith("-") else event_panel()
    if not panel:
        return
    if INPUT_WAIT <= 0:
        patrol(False, (panel, time.time()))
        return
    subprocess.Popen(["/bin/sh", "-c", f"sleep {INPUT_WAIT}; exec \"$0\" patrol --input-check \"$1\" \"$2\"",
                      os.path.realpath(__file__), panel, str(int(time.time()))],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class patrol_lock:
    """순찰과 보고 파일 쓰기를 한 번에 하나로 묶는 잠금."""
    def __enter__(self):
        import fcntl
        os.makedirs(os.path.dirname(PATROL), exist_ok=True)
        self.f = open(PATROL + ".lock", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *a):
        self.f.close()


def load_reports():
