def art_step(seen, now=None):
    """역할 그림을 스스로 늘린다: 사무실에 보이는 역할 중 그림이 없는 것을 Codex pane 하나에 맡기고(sib spawn --codex,
    한 번에 하나), 답 파일이 검사를 통과하면 ROLE_ART 에 올리고 pane 을 닫는다. 같은 역할은 하루에 한 번만 맡긴다.
    작업 폴더(ROLE_ART/jobs/<slug>)가 sib 의 미리 신뢰 목록에 없으면 pane 을 띄우지 않고 state.json 의 untrusted 에
    이유를 남긴다(install 이 ~/.local/share/cmux/office-art/jobs/* 를 목록에 넣는다). seen: {역할: description}. 끄기: BRIEF_OFFICE_ART=0."""
    import shutil
    if os.environ.get("BRIEF_OFFICE_ART", "1") == "0":
        return None
    now = now or time.time()
    path = os.path.join(ROLE_ART, "state.json")
    try:
        st = json.load(open(path))
    except (OSError, ValueError):
        st = {}
    tried, job, have = st.setdefault("tried", {}), st.get("job"), role_art_have()
    sib = os.environ.get("BRIEF_SIB") or shutil.which("sib") or os.path.join(HOME, ".local/bin/sib")
    if job:
        for r in job["roles"]:
            f = os.path.join(job["dir"], r + ".svg")
            if r not in have and os.path.exists(f) and not art_ok(f):
                shutil.copyfile(f, os.path.join(ROLE_ART, r + ".svg.tmp"))
                os.replace(os.path.join(ROLE_ART, r + ".svg.tmp"), os.path.join(ROLE_ART, r + ".svg"))
                have[r] = int(now)
        if all(r in have for r in job["roles"]) or now - job["at"] > float(os.environ.get("BRIEF_ART_TIMEOUT", "1200")):
            subprocess.run([sib, "kill", job["slug"]], capture_output=True, text=True)
            st["job"] = job = None
    if not job:
        want = sorted(r for r in seen if r not in have and (r not in tried or now - tried[r] > 86400))[:6]
        slug = f"{OFFICE_ART_PREFIX}{int(now) % 100000}"
        d = os.path.join(ROLE_ART, "jobs", slug)
        if want:  # 빈 pane 은 Codex 신뢰 화면에서 멈춘다: sib 가 미리 신뢰하는 폴더가 아니면 띄우지 않고 내일 다시 본다
            os.makedirs(os.path.dirname(d), exist_ok=True)
            t = subprocess.run([sib, "trusted", d], capture_output=True, text=True, timeout=30)
            st["untrusted"] = None if t.returncode == 0 else (t.stderr or t.stdout).strip() or "sib trusted failed"
            if st["untrusted"]:
                for r in want:
                    tried[r] = now
                want = []
        if want:
            os.makedirs(d, exist_ok=True)
            open(os.path.join(d, "task.md"), "w").write(ART_TASK.replace("{roles}", "\n".join(
                f"- `{r}`: {seen[r] or '(no description)'}" for r in want)))
            p = subprocess.run([sib, "spawn", slug, "--codex", "--no-report", "--workdir", d, "--new-workspace", "--", ART_ASK],
                               capture_output=True, text=True, timeout=180)
            for r in want:  # 띄우지 못했으면 10분 뒤에 다시(sib 가 가끔 출력 없이 끝난다)
                tried[r] = now if p.returncode == 0 else now - 86400 + 600
            if p.returncode == 0:
                st["job"] = job = {"slug": slug, "dir": d, "roles": want, "at": now}
            else:  # 실패해도 워크스페이스·빈 셸이 남을 수 있다
                subprocess.run([sib, "kill", slug], capture_output=True, text=True)
    os.makedirs(ROLE_ART, exist_ok=True)
    json.dump(st, open(path + ".tmp", "w"), ensure_ascii=False)
    os.replace(path + ".tmp", path)
    return job


def tree_serve(port):
    """사무실 화면 서버(127.0.0.1). 장면은 뒤에서 계속 만들고 요청에는 마지막 장면을 준다.
    BRIEF_TREE_IDLE 초(기본 900) 동안 아무도 /data 를 묻지 않으면 스스로 끝난다(창을 손으로 닫아도 남지 않게)."""
    import threading
    from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
    st = {"prev": None, "seen": [], "start": time.time()}
    box = {"json": None, "asked": time.time()}
    idle = float(os.environ.get("BRIEF_TREE_IDLE", "900"))
    ready = threading.Event()

    def loop():
        while True:
            try:
                box["json"] = json.dumps(tree_frame(st), ensure_ascii=False).encode()
            except Exception as e:  # 한 장면이 깨져도 서버는 산다
                box["json"] = box["json"] or json.dumps({"error": str(e)}).encode()
            ready.set()
            if time.time() - box["asked"] > idle:
                os._exit(0)
            time.sleep(0.5)

    class H(BaseHTTPRequestHandler):
        def do_GET(self):
            path = self.path.split("?")[0]
            if path == "/data":
                box["asked"] = time.time()
                ready.wait(30)
                body, ctype = box["json"] or b"{}", "application/json; charset=utf-8"
            elif path == "/archive":  # 기록 보관소: 끝난 위원회 회의
                body, ctype = json.dumps(committee_archive(), ensure_ascii=False).encode(), "application/json; charset=utf-8"
            elif path == "/org":  # 조직도: 지금 일하는 에이전트 전체
                body, ctype = json.dumps(org_chart(), ensure_ascii=False).encode(), "application/json; charset=utf-8"
            elif path.startswith("/archive/"):  # 회의록 원문(hr 폴더의 .md 만)
                name = path[9:]
                if "/" in name or name.startswith(".") or not name.endswith(".md"):
                    self.send_error(404)
                    return
                try:
                    body = open(os.path.join(HR, name), "rb").read()
                except OSError:
                    self.send_error(404)
                    return
                ctype = "text/plain; charset=utf-8"
            else:
                role = path.startswith("/role-art/")
                name = ("index.html" if path in ("/", "/index.html") else path[5:] if path.startswith("/art/")
                        else path[10:] if role else "")
                try:
                    if "/" in name or name.startswith(".") or not name or (role and not name.endswith(".svg")):
                        raise OSError
                    base = ROLE_ART if role else os.path.join(OFFICE, "art" if path.startswith("/art/") else "")
                    body = open(os.path.join(base, name), "rb").read()
                except OSError:
                    self.send_error(404)
                    return
                ctype = {"html": "text/html; charset=utf-8", "svg": "image/svg+xml"}.get(name.rsplit(".", 1)[-1],
                                                                                     "application/octet-stream")
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):  # 사무실에서 직원을 누르면 그 세션 pane 으로 간다
            if self.path.split("?")[0] != "/go":
                self.send_error(404)
                return
            try:
                n = int(self.headers.get("Content-Length") or 0)
                panel = json.loads(self.rfile.read(min(n, 4096)) or b"{}").get("panel")
            except (ValueError, AttributeError):
                panel = None
            err = go_panel(panel) if isinstance(panel, str) else "panel 없음"
            body = (err or "ok").encode()
            self.send_response(400 if err else 200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass

    def art_loop():  # 보이는 역할 중 그림이 없는 것을 Codex pane 에 맡기고 받아 온다(art_step)
        while True:
            try:
                roles = agent_roles()
                art_step({r: roles.get(r, "") for r in st.get("roles", ()) if r in roles})
            except Exception:
                pass
            time.sleep(float(os.environ.get("BRIEF_ART_INTERVAL", "20")))

    def power_loop():  # 처음 한 번은 오늘 기록을 다 읽어 느리므로 장면과 따로 돈다
        pw = {}
        while True:
            try:
                st["power"] = power_scan(pw)
            except Exception:
                pass
            time.sleep(3)

    srv = ThreadingHTTPServer(("127.0.0.1", port), H)
    threading.Thread(target=loop, daemon=True).start()
    threading.Thread(target=power_loop, daemon=True).start()
    threading.Thread(target=art_loop, daemon=True).start()
    print(f"사무실: http://127.0.0.1:{srv.server_address[1]}/", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


CHROME = os.environ.get("BRIEF_CHROME", "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")


def tree_popup():
    """켜기/끄기: 사무실 창(서버 + 주소창 없는 Chrome 앱 창)이 떠 있으면 둘 다 끄고, 없으면 띄운다."""
    import signal
    import socket
    try:
        old = json.load(open(TREE_POPUP))
    except (OSError, ValueError):
        old = {}
    alive = []
    for pid in (old.get("browser"), old.get("server")):
        try:
            os.kill(pid, 0)
            alive.append(pid)
        except (TypeError, OSError):
            pass
    if old:
        os.remove(TREE_POPUP)
    if alive:
        for pid in alive:
            try:
                os.killpg(pid, signal.SIGTERM)
            except OSError:
                pass
        print("사무실 창을 닫았습니다 (끔)")
        return
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    srv = subprocess.Popen([os.path.realpath(__file__), "tree", "--serve", "--port", str(port)], **quiet)
    end = time.time() + float(os.environ.get("BRIEF_TREE_WAIT", "8"))
    while time.time() < end:  # 서버가 귀를 열 때까지
        try:
            socket.create_connection(("127.0.0.1", port), 0.3).close()
            break
        except OSError:
            time.sleep(0.2)
    url = f"http://127.0.0.1:{port}/"
    if os.path.exists(CHROME):  # 별도 프로필이라 이 창만의 프로세스가 생기고, 그것을 끄면 창이 닫힌다
        br = subprocess.Popen([CHROME, f"--app={url}", "--user-data-dir=" + os.path.join(HOME, ".cache/cmux/brief-office-chrome"),
                               "--window-size=1500,950", "--no-first-run", "--no-default-browser-check",
                               "--no-proxy-server", "--disable-background-timer-throttling",  # 가려져도 1초마다 묻게
                               "--disable-backgrounding-occluded-windows", "--disable-renderer-backgrounding"], **quiet)
        bpid = br.pid
    else:
        subprocess.run(["open", url])
        bpid = None
    os.makedirs(os.path.dirname(TREE_POPUP), exist_ok=True)
    json.dump({"server": srv.pid, "browser": bpid, "url": url}, open(TREE_POPUP, "w"))
    print(f"사무실 창을 열었습니다 (켬): {url}  다시 부르면 닫습니다")


