def input_draft(s):
    """pane 입력 칸에 남은 글(제출 안 된 것)과 입력 칸의 폭. Claude 화면의 마지막 '❯' 줄부터 아래 테두리까지.
    폭은 그 아래 테두리(─) 의 길이다. 없거나 못 읽으면 ("", 0)."""
    r = cmux("read-screen", "--surface", s["panel"], "--workspace", s.get("workspace") or "", "--lines", "40")
    if r.returncode:
        return "", 0
    d, on, w = "", False, 0
    for l in r.stdout.splitlines():
        t = l.strip()
        if t.startswith("❯"):
            d, on, w = "", True, 0
        elif on and t.startswith("─"):
            on, w = False, len(t)
        if on:
            d += " " + t
    d = " ".join(d.replace(" ", " ").lstrip(" ❯").split())
    return ("" if re.fullmatch(r'Try ".*"', d) else d), w


def input_state(s):
    """cmux 가 본 그 pane 입력 칸의 상태: "draft"(친 글이 있음), "empty", "dialog" 등. 못 읽으면 None.
    화면 글자에는 색이 없어 Claude Code 의 프롬프트 제안(흐린 글씨)과 사용자가 친 글이 똑같이 보인다.
    cmux 는 둘을 가른다: 제안만 떠 있으면 "empty", 친 글이 있으면 "draft"(11-24 확인)."""
    r = cmux("rpc", "surface.input_state", json.dumps({"surface_id": s["panel"], "workspace_id": s.get("workspace") or ""}))
    try:
        j = json.loads(r.stdout)
    except ValueError:
        return None
    return j.get("state") if (j.get("surface_id") or "").lower() == s["panel"].lower() else None


