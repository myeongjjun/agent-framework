def in_transcript(s, text, since, wait=6):
    """입력창에 넣은 글이 세션의 대화 기록에 들어갔는지: "user"(턴 입력이 됨), "queued"(일하는 중이라 Claude 가
    대기열에 넣음), None. 좁은 pane 은 일하는 중 표시(spinner·esc to interrupt)를 그리지 않아 화면만으로는
    제출을 확인 못 할 때가 있다(11-23 시험: 폭 12자·높이 24줄)."""
    path = transcript(s)
    needle = json.dumps(text[:30], ensure_ascii=False)[1:-1]
    for _ in range(int(wait * 2)):
        for line in reversed(tail(path, 400_000) if path else []):
            if needle not in line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if epoch(o.get("timestamp")) < since - 1:
                break
            if o.get("type") == "user":
                return "user"
            if o.get("type") == "queue-operation" and o.get("operation") == "enqueue":
                return "queued"
        time.sleep(0.5)
    return None


def send(s, text):
    """데스크가 세션에 글을 넘긴다. (전달됐는지, 결과 한 줄). 결과 줄의 첫 단어: 전달됨 / 대기열 / 전달 못 함.

    전달기는 하나다: pane-deliver(`sib send`·`/pane-msg` 와 같은 것, docs/agent-control-one-path.md 5절 3단계).
    그 pane 의 입력창에 직접 넣으므로 받는 세션이 틀릴 수 없다. cmux 메시지(`cmux agent message`)는 쓰지 않는다:
    cmux 는 pane 이 아니라 워크스페이스에 등록된 에이전트를 깨워, 한 pane 에 보낸 글을 같은 워크스페이스의
    다른 에이전트가 읽고 답할 수 있다. 재시작 전부터 떠 있던 세션에는 아예 닿지 않는다.
    쉬는 세션: 넣고 턴 시작을 확인한다. 일하는 중(cmux 상태 또는 화면): 입력 대기열(--queue)에 넣는다(지금 턴이
    끝나면 읽힘). 승인 화면: 넣지 않는다(사용자의 답이 먼저). 긴 글은 pane-deliver 가 파일에 쓰고 경로 한 줄만
    넣는다(11-20·11-21: 폭 12자 pane). 화면으로 제출을 확인 못 하면 대화 기록에서 확인한다."""
    if not any(text.startswith(h) for h in HANDOFF):
        text = "desk-message: " + text  # 대화 기록에서 데스크가 넘긴 일로 찾는 표시(started)
    if s["panel"].lower() == (os.environ.get("CMUX_PANEL_ID") or "").lower():
        return False, "전달 못 함: 자기 자신의 pane 입니다"
    if not DELIVER:
        return False, "전달 못 함: pane-deliver.sh 가 없습니다(L1 install 확인)"

    def deliver(*flags):
        """(rc, 무엇이 확인됐는지). rc: 0 입력됨, "queued" 대기열, 그 밖은 pane-deliver 의 종료 코드.
        rc 5 라도 대화 기록에 들어갔으면 0(입력) 또는 "queued" 로 본다."""
        since = time.time()
        ours = [a for h in OURS for a in ("--ours", h)]  # 입력 칸에 남은 데스크의 글은 지우고 다시 넣는다(11-23)
        r = subprocess.run([DELIVER, "--surface", s["panel"], "--workspace", s["workspace"], *ours, *flags, "--", text],
                           capture_output=True, text=True)
        out = r.stdout.splitlines()
        f = next((l[6:] for l in out if l.startswith("FILE: ")), "")
        note = f" (긴 글은 {f} 에 쓰고 경로를 넣음)" if f else ""
        if any(l.startswith("CLEARED: ") for l in out):
            note += " (입력 칸에 남아 있던 데스크의 보내지 않은 글을 지우고 넣음)"
        if r.returncode == 7:
            d, sug, st, why = input_box(s)  # 좁은 칸의 '…'·대화상자 줄·제안은 쓰던 글이 아니다: 그대로 말한다
            if st == "dialog":
                return 7, "선택 대화상자가 열려 있어 넣지 않았습니다(사용자의 답이 먼저)"
            if why:
                return 7, why + ": 넣지 않았습니다(pane 을 넓히거나 화면을 직접 확인하세요)"
            if sug:
                return 7, f"입력 칸에 프롬프트 제안 '{sug[:60]}' 이 떠 있어 넣지 않았습니다(사용자가 친 글 아님)"
            return 7, "입력 칸에 사용자가 쓰던 글이 있어 넣지 않았습니다: " + (r.stderr.split("not ours:", 1)[-1].strip())
        typed = next((l[7:] for l in out if l.startswith("TYPED: ")), text)
        if r.returncode == 0 and any(l.startswith("QUEUED: ") for l in out):
            got = in_transcript(s, typed, since)
            seen = "대화 기록에서 확인했습니다" if got else "대화 기록에서는 아직 확인 못 함"
            return "queued", f"세션이 일하는 중이라 그 pane 의 입력 대기열에 넣었습니다(지금 턴이 끝나면 읽힘, {seen})" + note
        if r.returncode == 5:
            got = in_transcript(s, typed, since)
            if got == "user":
                return 0, "입력창에 넣었고 대화 기록에 입력으로 들어간 것을 확인했습니다(화면으로는 확인 못 함)" + note
            if got == "queued":
                return "queued", "세션이 일하는 중이라 Claude 가 입력 대기열에 넣었습니다(지금 턴이 끝나면 읽힘)" + note
        if r.returncode == 0:
            return 0, "입력창에 넣고 턴 시작을 확인했습니다" + note
        return r.returncode, ((r.stderr or r.stdout).strip() or f"pane-deliver rc={r.returncode}") + note

    rc, why = deliver("--queue") if s.get("state") == "working" else deliver()
    if rc == 4:  # cmux 는 쉰다고 했지만 화면은 일하는 중
        rc, why = deliver("--queue")
    if rc in (0, "queued"):
        return True, ("전달됨: " if rc == 0 else "대기열: ") + why
    if rc == 6:
        return False, "전달 못 함: pane 이 없습니다"
    if rc == 3:
        return False, "전달 못 함: 승인 대기 화면입니다. 사용자가 그 화면에 답한 뒤 다시 보내세요"
    return False, "전달 못 함: " + why


def request_close(s):
    """세션에 완료 보고를 요청한다. 세션은 보고만 하고 닫지 않는다: 데스크가 보고를 실제와 대조한 뒤
    `brief done <panel> --verified "<기록>"` 으로 완료 처리한다. 못 보냈으면 이유를 돌려준다.

    요청은 `brief send` 와 같은 길(send)로 보낸다: 쉬는 세션은 입력창에 직접 넣어 바로 턴을 시작시키고
    (cmux 메시지 대기열은 멈춘 세션에 끝내 도착하지 않는다. 11-16: 4건 모두 queued), 긴 요청은 파일 경로 한 줄로
    들어간다. 반환: (보냈는지, 결과 줄)."""
    me = (os.environ.get("CMUX_PANEL_ID") or "").lower()
    desk = desk_panel()  # 주소는 글에 넣지 않는다: 글이 입력 칸에 며칠 남아도 답할 때 `brief report` 가 그때의 데스크를 찾는다
    to = "`brief report \"<reply>\"`" if not desk or desk.lower() != s["panel"].lower() else "this pane"
    text = ("done-request: this session's task looks finished (the user called it done, or it has been idle for hours and "
            "the desk is closing finished sessions). Reply `ready` only if nothing the user asked for is left; otherwise "
            "`not-ready` and the pane stays open. Findings outside the task do not count as remaining: register each with "
            "`brief note \"<one line>\"` and leave them. Before it is recorded as done and the pane is closed, the desk "
            "agent cross-checks your report against reality, so report facts, not memory: run `git status` (and "
            "`git log -3 --oneline`) in every directory this session created or edited files in. "
            f"Reply to {to} in this shape, then stay open (the desk closes the pane after checking; do not close it "
            "yourself): `done-report: ready|not-ready` then one line each: did: <what was done and the result> / "
            "artifacts: <absolute paths, commits, links> / uncommitted: <paths per directory, or none> · unpushed: "
            "<commits, or none> / running: <background jobs, pending answers, or none> / remaining: <what is left of "
            "this task, or none>")
    if s["panel"].lower() == me:  # 자기 자신: 입력창에 넣으면 지금 턴과 엉킨다. 출력으로 돌려준다
        print(text)
        return True, "자기 자신: 요청을 위에 출력했습니다"
    ok, line = send(s, text)
    if ok:
        return True, line
    return False, ("보고 요청 못 보냄: " + line.removeprefix("전달 못 함: ")
                   + ". 데스크가 화면과 작업 폴더를 직접 확인한 뒤 --verified 로 완료 처리하세요")


def log_closed(s, note, closed, check=None):
    """완료 기록: 무엇이 언제 어떻게 검토되어 끝났는지. `brief closed` 가 보여 준다.
    check 는 검토 없이 닫힌 pane 을 도구가 닫힌 자리에서 대조한 결과다(close_check)."""
    rec = {k: s.get(k) for k in ("panel", "title", "cwd", "agent", "session")} | {"at": int(time.time()), "closed": closed}
    if note is not None:
        rec["verified"] = note
    if check is not None:
        rec["check"] = check
    os.makedirs(os.path.dirname(CLOSED), exist_ok=True)
    with open(CLOSED, "a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    return rec


def closed_record(panel, session):
    """그 pane(또는 세션)의 최근 이틀 완료 기록. 없으면 None."""
    try:
        recs = [json.loads(l) for l in open(CLOSED) if l.strip()]
    except (OSError, ValueError):
        return None
    cut = time.time() - 2 * 86400
    return next((r for r in reversed(recs) if r.get("at", 0) >= cut and (
        (r.get("panel") or "").lower() == panel.lower() or (session and r.get("session") == session))), None)


def close_check(s):
    """검토 없이 닫힌 세션을 닫힌 자리에서 대조한다(P4): cwd 의 미커밋·미push, 마지막 답의 미응답 질문."""
    out = git_facts(s.get("cwd"))
    q = turns(s)["question"]
    if q:
        out["question"] = q
    return out


def close_session(s, force, note=None):
    """세션의 pane 을 닫고 기록을 남긴다. 닫지 않았으면 이유(문자열)를 돌려준다."""
    own = s["panel"].lower() == os.environ.get("CMUX_PANEL_ID", "").lower()  # 세션이 스스로 닫는 경우
    if s["state"] != "idle" and not force and not own:
        return f"닫지 않음: 세션이 {s['state']} 상태입니다 (그래도 닫으려면 --force)"
    snap = closing_snapshot(s)  # 닫기 전에 도구가 찍는 증거(입력 칸·질문·git): `brief audit` 이 데스크와 따로 판정한다
    r = cmux("rpc", "surface.list", json.dumps({"workspace_id": s["workspace"]}))
    try:
        alone = len(json.loads(r.stdout).get("surfaces", [])) <= 1
    except ValueError:
        alone = False
    if alone:  # 마지막 pane 이면 빈 워크스페이스가 남지 않게 워크스페이스째 닫는다
        r = cmux("close-workspace", "--workspace", s["workspace"], "--force")
    else:
        r = cmux("close-surface", "--surface", s["panel"], "--workspace", s["workspace"], "--force")
    if r.returncode:
        return "닫기 실패: " + r.stderr.strip()
    log_closed(s, note, True, check=snap)
    return None


