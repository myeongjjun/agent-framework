        return []


def report(text):
    """데스크에 보고를 보낸다. 주소는 지금 찾고(글에 박힌 옛 id 를 쓰지 않는다), 보낸 이는 세션 제목으로 적는다
    (cmux 기본값은 워크스페이스 제목이라, 한 워크스페이스의 여러 세션이 같은 이름으로 찍혔다).
    보고는 먼저 REPORTS 에 남긴다: 데스크가 메시지를 읽으면 순찰이 지우고, 데스크가 없거나 그 사이 닫혔으면
    다음 데스크가 `brief patrol --read` 에서 받는다."""
    me, s = me_session()
    title = s.get("title") or os.path.basename(os.getcwd())
    rec = {"at": int(time.time()), "panel": s.get("panel") or me, "title": title,
           "cwd": s.get("cwd") or os.getcwd().replace(HOME, "~"), "text": text}
    desk = desk_panel()
    sent = False
    if desk and desk.lower() != me.lower():
        r = cmux("agent", "message", desk, "--from", title, "--json", "--",
                 f"{text}\n— from: {title} (panel {rec['panel'] or '?'})")
        try:
            rec["msg"], rec["desk"], sent = json.loads(r.stdout)["id"], desk.lower(), r.returncode == 0
        except (ValueError, KeyError, TypeError):
            pass
    with patrol_lock():
        os.makedirs(os.path.dirname(REPORTS), exist_ok=True)
        with open(REPORTS, "a") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    if sent:
        print(f"데스크에 보냄 ({title}). 이 pane 은 열어 두세요")
    else:
        patrol(False)  # 데스크가 순찰을 읽는 중이면 깨운다
        print("데스크에 바로 못 보냄: 보고를 기록했고, 데스크가 다음 순찰이나 시작할 때 읽습니다. 이 pane 은 열어 두세요")


def _patrol(read):
    try:
        board()  # 지표의 오늘 줄을 갱신(30분에 한 번만 쓴다)
    except Exception:
        pass
    try:
        st = json.load(open(PATROL))
    except (OSError, ValueError):
        st = None
    ss = sessions()
    desk = (desk_panel() or "").lower()
    now = int(time.time())
    snap = {x["panel"]: {"state": x["state"], "at": x["last_activity"], "title": x["title"],
                         "cwd": x["cwd"], "agent": x["agent"], "session": x["session"]}
            for x in ss}
    first = st is None
    st = st or {"snap": {}, "pending": {}, "notified": 0}
    if not first:  # 지난 기록과 비교해 변화를 쌓는다. 같은 세션의 같은 변화는 하나로 합친다.
        for panel, cur in snap.items():
            if panel.lower() == desk:
                continue
            old = st["snap"].get(panel)
            if old is None:
                st["pending"][panel + ":new"] = {"panel": panel, "title": cur["title"], "what": "new", "at": now}
            elif cur["state"] != "working" and (old["state"] == "working" or old["at"] != cur["at"]):
                st["pending"][panel + ":turn_ended"] = {"panel": panel, "title": cur["title"], "what": "turn_ended", "at": now}
        for panel, old in st["snap"].items():
            if panel not in snap and panel.lower() != desk:
                st["pending"] = {k: v for k, v in st["pending"].items() if v["panel"] != panel}
                ev = {"panel": panel, "title": old["title"], "what": "closed", "at": now}
                rec = closed_record(panel, old.get("session"))
                if rec is None:  # 데스크 검토 없이 닫혔다(사용자가 pane 을 닫음): 그 자리에서 대조해 남긴다
                    old = {"panel": panel, "title": old["title"], "cwd": old.get("cwd"), "agent": old.get("agent"),
                           "session": old.get("session"), "state": "closed"}
                    rec = log_closed(old, None, True, check=close_check(old))
                ev["check"] = rec.get("check") if not rec.get("verified") else None
                ev["verified"] = rec.get("verified")
                st["pending"][panel + ":closed"] = ev
    st["snap"] = snap
    try:
        notes = [json.loads(l) for l in open(NOTES) if l.strip()]
    except (OSError, ValueError):
        notes = []
    reports = load_reports()
    inbox = {m.get("id"): m for m in messages()} if any(r.get("msg") for r in reports) else {}
    unsent = [r for r in reports if r.get("desk") != desk or not inbox.get(r.get("msg"))]
    if read:
        rc, plan, fx = recaps(ss), load_plan(), facts(ss, desk)
        num = {it["panel"]: n for n, it in enumerate(plan["items"], 1) if not it["done"]}
        live = {x["panel"]: x for x in ss}
        out = []
        for ev in sorted(st["pending"].values(), key=lambda e: e["at"]):
            x = live.get(ev["panel"], {})
            row = {"ev": ev["what"], "panel": ev["panel"], "title": ev["title"], "state": x.get("state", "closed"),
                   "todo": num.get(ev["panel"]), "recap": rc.get(ev["panel"].lower())}
            if ev["what"] == "new":
                row["cwd"] = x.get("cwd")
            if ev["what"] == "closed":  # 닫힐 때 대조한 기록(검토를 거쳐 닫혔으면 그 검토)
                row.update(check=ev.get("check"), verified=ev.get("verified"))
            elif x:
                row.update(fx.get(ev["panel"].lower(), {}))
            out.append({k: v for k, v in row.items() if v is not None})
        for n in notes:  # 세션이 목표 밖에서 발견해 데스크에 넘긴 일
            out.append({k: v for k, v in {"ev": "note", "panel": n.get("panel"), "title": n.get("title"),
                                          "cwd": n.get("cwd"), "note": n.get("text")}.items() if v})
        if notes:
            open(NOTES, "w").close()
        keep = []
        for r in reports:  # `brief report` 의 보고 중 데스크가 메시지로 읽지 못한 것
            m = inbox.get(r.get("msg"))
            if m and m.get("read_at"):
                continue  # 데스크가 메시지로 읽었다
            if m and r.get("desk") == desk and m.get("state") in ("queued", "delivered"):
                keep.append(r)  # 지금 데스크가 곧 읽는다(두 번 받지 않게 다음 순찰로 미룬다)
                continue
            out.append({k: v for k, v in {"ev": "report", "panel": r.get("panel"), "title": r.get("title"),
                                          "cwd": r.get("cwd"), "report": r.get("text")}.items() if v})
        if reports:
            with open(REPORTS, "w") as f:
                f.writelines(json.dumps(r, ensure_ascii=False) + "\n" for r in keep)
        st["pending"] = {}
        st["desk"] = desk  # 순찰을 읽은 데스크만 깨운다(이 기능을 모르는 예전 데스크는 건드리지 않는다)
        for row in out:  # 한 줄에 한 건(JSONL)
            print(json.dumps(row, ensure_ascii=False, separators=(",", ":")))
    elif (st["pending"] or notes or unsent) and desk and st.get("desk") == desk:
        wait = st["notified"] + PATROL_MIN - now
        if wait <= 0:
            r = cmux("agent", "message", desk, "--from", "orch-patrol", "--",
                     f"patrol {len(st['pending']) + len(notes) + len(unsent)}")
            if r.returncode == 0:
                st["notified"] = now
        elif now >= st.get("retry", 0):  # 아직 이르면, 때가 됐을 때 한 번 더 돌도록 예약한다
            st["retry"] = now + int(wait) + 5
            subprocess.Popen(["/bin/sh", "-c", f"sleep {int(wait) + 5}; exec \"$0\" patrol", os.path.realpath(__file__)],
                             start_new_session=True, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.makedirs(os.path.dirname(PATROL), exist_ok=True)
    tmp = PATROL + ".tmp"
    json.dump(st, open(tmp, "w"), ensure_ascii=False)
    os.replace(tmp, PATROL)


def review(days):
    import glob, collections
    proj = os.path.join(HOME, ".claude/projects", re.sub(r"[^A-Za-z0-9]", "-", DESK_DIR))
    since = time.time() - days * 86400
    used = collections.Counter()
    one = lambda t, n: " ".join(str(t).split())[:n]
    for path in sorted(glob.glob(proj + "/*.jsonl"), key=os.path.getmtime):
        if os.path.getmtime(path) < since:
            continue
        rows, last_a = [], ""
        for line in open(path, errors="ignore"):
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if o.get("isSidechain"):
                continue
            try:
                ts = time.strftime("%m-%d %H:%M", time.localtime(
                    __import__("calendar").timegm(time.strptime(o.get("timestamp", "")[:19], "%Y-%m-%dT%H:%M:%S"))))
            except ValueError:
                ts = ""
            c = (o.get("message") or {}).get("content")
            if isinstance(c, list):
                c = " ".join(x.get("text", "") for x in c if isinstance(x, dict) and x.get("type") == "text")
            if o.get("type") == "assistant" and c and c.strip():
                last_a = one(c, 260)
            elif o.get("type") == "system" and o.get("subtype") == "local_command":
                m = re.search(r"<command-name>(/\S+)</command-name>", str(o.get("content", "")))
                out = re.search(r"<local-command-stdout>(.*?)</local-command-stdout>", str(o.get("content", "")), re.S)
                if m:
                    used[m.group(1)] += 1
                    rows.append(f"{ts} C {m.group(1)}")
                elif out and rows and rows[-1].split(" ")[2:3] == ["C"]:
                    rows[-1] += " -> " + one(out.group(1), 120)
            elif o.get("type") == "user" and isinstance(c, str) and c.strip():
                t = one(c, 300)
                if t.startswith(("<", "Base directory for this skill", "You are helping")) or "<command-name>" in t:
                    m = re.search(r"<command-name>(/\S+)</command-name>", t)
                    if m:
                        used[m.group(1)] += 1
                        rows.append(f"{ts} C {m.group(1)}")
                    continue
                if last_a:
                    rows.append(f"      A {last_a}")
                    last_a = ""
                rows.append(f"{ts} U {t}")
        if rows:
            print(f"== {os.path.basename(path)[:8]}")
            print("\n".join(rows))
    print("== used " + " ".join(f"{k}={v}" for k, v in used.most_common()))


def resume_cmd(rec):
    if not rec.get("session"):
        return ""
    tool = "codex resume " if rec.get("agent") == "codex" else "claude --resume "
    return f"cd {rec['cwd']} && {tool}{rec['session']}"


def me_session():
    """(이 pane 의 panel id, 그 세션 정보 또는 {})."""
    me = os.environ.get("CMUX_PANEL_ID", "")
    return me, next((x for x in sessions() if x["panel"].lower() == me.lower()), {}) if me else {}


def desk_panel():
    """데스크(☀ 워크스페이스)의 orch 세션 panel. 없으면 None."""
    if os.environ.get("BRIEF_DESK_PANEL"):  # 시험용 재정의
        return os.environ["BRIEF_DESK_PANEL"]
    try:
        wss = json.loads(cmux("list-workspaces", "--json").stdout).get("workspaces", [])
    except ValueError:
        return None
    desks = {w["id"] for w in wss if str(w.get("custom_title") or w.get("title") or "").startswith("☀")}
    cand = [x for x in sessions() if x["workspace"] in desks]
    home = DESK_DIR.replace(HOME, "~")  # 데스크 워크스페이스에 다른 세션이 섞여 있어도 orch(데일리 폴더)를 고른다
    return next((x["panel"] for x in cand if x["cwd"] == home), cand[0]["panel"] if cand else None)


DELIVER = os.environ.get("BRIEF_DELIVER") or next((p for p in (  # BRIEF_DELIVER: 시험용 재정의
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "skills", "pane-msg", "scripts", "pane-deliver.sh"),
    os.path.join(HOME, ".claude/skills/pane-msg/scripts/pane-deliver.sh")) if os.access(p, os.X_OK)), None)


def in_transcript(s, text, since, wait=6):
    """입력창에 넣은 글이 세션의 대화 기록에 들어갔는지: "user"(턴 입력이 됨), "queued"(일하는 중이라 Claude 가
    대기열에 넣음), None. 좁은 pane 은 일하는 중 표시(spinner·esc to interrupt)를 그리지 않아 화면만으로는
    제출을 확인 못 할 때가 있다(11-23 시험: 폭 12자·높이 24줄)."""
    path = transcript(s)
    needle = json.dumps(text[:30], ensure_ascii=False)[1:-1]
    for _ in range(int(wait * 2)):
        for line in reversed(tail(path, 400_000) if path else []):
            if needle not in line:
                continue
            try:
                o = json.loads(line)
            except ValueError:
                continue
            if epoch(o.get("timestamp")) < since - 1:
                break
            if o.get("type") == "user":
                return "user"
            if o.get("type") == "queue-operation" and o.get("operation") == "enqueue":
                return "queued"
        time.sleep(0.5)
    return None


def send(s, text):
    """데스크가 세션에 글을 넘긴다. (전달됐는지, 결과 한 줄). 결과 줄의 첫 단어: 전달됨 / 대기열 / 전달 못 함.

    쉬는 세션: 입력창에 직접 넣는다(pane-deliver). 턴이 시작된 것까지 확인되고, cmux 가 그 세션의 에이전트를
    아는지와 무관하다. cmux 메시지는 재시작 전부터 떠 있던 세션에 닿지 않는다(11-23: 5건 모두
    "No agent activity seen"). 긴 글은 pane-deliver 가 파일에 쓰고 경로 한 줄만 넣는다(11-20·11-21: 폭 12자 pane).
    화면으로 제출을 확인 못 하면 대화 기록에서 확인한다.
    일하는 중(cmux 상태 또는 화면) / 승인 화면: cmux 메시지로 보낸다(다음 단계에 읽힌다). cmux 가 그 pane 의
    에이전트를 모르면 메시지는 영영 대기열에 남으므로, 일하는 중이면 입력 대기열(--queue)에 넣는다."""
    if not any(text.startswith(h) for h in HANDOFF):
        text = "desk-message: " + text  # 대화 기록에서 데스크가 넘긴 일로 찾는 표시(started)
    if s["panel"].lower() == (os.environ.get("CMUX_PANEL_ID") or "").lower():
        return False, "전달 못 함: 자기 자신의 pane 입니다"
    if not DELIVER:
        return False, "전달 못 함: pane-deliver.sh 가 없습니다(L1 install 확인)"

    def deliver(*flags):
        """(rc, 무엇이 확인됐는지). rc 5 라도 대화 기록에 들어갔으면 0(입력) 또는 "queued" 로 본다."""
        since = time.time()
        r = subprocess.run([DELIVER, "--surface", s["panel"], "--workspace", s["workspace"], *flags, "--", text],
                           capture_output=True, text=True)
        f = next((l[6:] for l in r.stdout.splitlines() if l.startswith("FILE: ")), "")
        note = f" (긴 글은 {f} 에 쓰고 경로를 넣음)" if f else ""
        if r.returncode == 5:
            typed = next((l[7:] for l in r.stdout.splitlines() if l.startswith("TYPED: ")), text)
            got = in_transcript(s, typed, since)
            if got == "user":
                return 0, "입력창에 넣었고 대화 기록에 입력으로 들어간 것을 확인했습니다(화면으로는 확인 못 함)" + note
            if got == "queued":
                return "queued", "세션이 일하는 중이라 Claude 가 입력 대기열에 넣었습니다(지금 턴이 끝나면 읽힘)" + note
        if r.returncode == 0:
            return 0, "입력창에 넣고 턴 시작을 확인했습니다" + note
        return r.returncode, ((r.stderr or r.stdout).strip() or f"pane-deliver rc={r.returncode}") + note

    rc, why = (4, "") if s.get("state") == "working" else deliver()
    if rc in (0, "queued"):
        return True, ("전달됨: " if rc == 0 else "대기열: ") + why
    if rc == 6:
        return False, "전달 못 함: pane 이 없습니다"
    if rc not in (3, 4):  # 5: 입력 칸에 다 안 보임 / 제출 뒤 턴 시작 미확인(대화 기록에도 없음)
        return False, "전달 못 함: " + why
    screen = "승인 대기 화면" if rc == 3 else "일하는 중"
    m = cmux("agent", "message", s["panel"], "--json", "--", text)
    try:
        got = json.loads(m.stdout)
    except ValueError:
        got = {}
    if m.returncode == 0 and got.get("recipient_has_agent"):
        if got.get("state") in ("delivered", "read"):
            return True, f"전달됨: {screen}이라 cmux 메시지로 보냈고 세션에 닿았습니다 (id {got.get('id')})"
        return True, f"대기열: {screen}이라 cmux 메시지로 보냈습니다. 세션이 다음 단계에 읽습니다 (id {got.get('id')}, started 로 확인)"
    if got.get("id"):  # cmux 가 이 pane 의 에이전트를 모른다: 그 메시지는 닿지 않는다
        why = "cmux 가 이 pane 의 에이전트를 모릅니다(재시작 전부터 떠 있던 세션일 수 있음)"
    else:
        why = "cmux 메시지 실패: " + ((m.stderr or m.stdout).strip() or f"rc={m.returncode}")
    if rc == 3:
        return False, f"전달 못 함: {screen}입니다. {why}. 사용자가 그 화면에 답한 뒤 다시 보내세요"
    qrc, qwhy = deliver("--queue")
    if qrc in (0, "queued"):
        return True, f"대기열: {screen}이고 {why}. 입력 대기열에 넣었습니다(지금 턴이 끝나면 읽힘)"
    return False, f"전달 못 함: {screen}이고 {why}. 입력 대기열에도 못 넣음: {qwhy}"


def request_close(s):
    """세션에 완료 보고를 요청한다. 세션은 보고만 하고 닫지 않는다: 데스크가 보고를 실제와 대조한 뒤
    `brief done <panel> --verified "<기록>"` 으로 완료 처리한다. 못 보냈으면 이유를 돌려준다.

    요청은 `brief send` 와 같은 길(send)로 보낸다: 쉬는 세션은 입력창에 직접 넣어 바로 턴을 시작시키고
    (cmux 메시지 대기열은 멈춘 세션에 끝내 도착하지 않는다. 11-16: 4건 모두 queued), 긴 요청은 파일 경로 한 줄로
    들어간다. 반환: (보냈는지, 결과 줄)."""
    me = (os.environ.get("CMUX_PANEL_ID") or "").lower()
    desk = desk_panel()  # 주소는 글에 넣지 않는다: 글이 입력 칸에 며칠 남아도 답할 때 `brief report` 가 그때의 데스크를 찾는다
    to = "`brief report \"<reply>\"`" if not desk or desk.lower() != s["panel"].lower() else "this pane"
    text = ("done-request: this session's task looks finished (the user called it done, or it has been idle for hours and "
            "the desk is closing finished sessions). Reply `ready` only if nothing the user asked for is left; otherwise "
            "`not-ready` and the pane stays open. Findings outside the task do not count as remaining: register each with "
            "`brief note \"<one line>\"` and leave them. Before it is recorded as done and the pane is closed, the desk "
            "agent cross-checks your report against reality, so report facts, not memory: run `git status` (and "
            "`git log -3 --oneline`) in every directory this session created or edited files in. "
            f"Reply to {to} in this shape, then stay open (the desk closes the pane after checking; do not close it "
            "yourself): `done-report: ready|not-ready` then one line each: did: <what was done and the result> / "
            "artifacts: <absolute paths, commits, links> / uncommitted: <paths per directory, or none> · unpushed: "
            "<commits, or none> / running: <background jobs, pending answers, or none> / remaining: <what is left of "
            "this task, or none>")
    if s["panel"].lower() == me:  # 자기 자신: 입력창에 넣으면 지금 턴과 엉킨다. 출력으로 돌려준다
        print(text)
        return True, "자기 자신: 요청을 위에 출력했습니다"
    ok, line = send(s, text)
    if ok:
        return True, line
    return False, ("보고 요청 못 보냄: " + line.removeprefix("전달 못 함: ")
                   + ". 데스크가 화면과 작업 폴더를 직접 확인한 뒤 --verified 로 완료 처리하세요")


def log_closed(s, note, closed, check=None):
    """완료 기록: 무엇이 언제 어떻게 검토되어 끝났는지. `brief closed` 가 보여 준다.
    check 는 검토 없이 닫힌 pane 을 도구가 닫힌 자리에서 대조한 결과다(close_check)."""
    rec = {k: s.get(k) for k in ("panel", "title", "cwd", "agent", "session")} | {"at": int(time.time()), "closed": closed}
    if note is not None:
        rec["verified"] = note
    if check is not None:
        rec["check"] = check
    os.makedirs(os.path.dirname(CLOSED), exist_ok=True)
    with open(CLOSED, "a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    return rec


def closed_record(panel, session):
    """그 pane(또는 세션)의 최근 이틀 완료 기록. 없으면 None."""
    try:
        recs = [json.loads(l) for l in open(CLOSED) if l.strip()]
    except (OSError, ValueError):
        return None
    cut = time.time() - 2 * 86400
    return next((r for r in reversed(recs) if r.get("at", 0) >= cut and (
        (r.get("panel") or "").lower() == panel.lower() or (session and r.get("session") == session))), None)


def close_check(s):
    """검토 없이 닫힌 세션을 닫힌 자리에서 대조한다(P4): cwd 의 미커밋·미push, 마지막 답의 미응답 질문."""
    out = git_facts(s.get("cwd"))
    q = turns(s)["question"]
    if q:
        out["question"] = q
    return out


def close_session(s, force, note=None):
    """세션의 pane 을 닫고 기록을 남긴다. 닫지 않았으면 이유(문자열)를 돌려준다."""
    own = s["panel"].lower() == os.environ.get("CMUX_PANEL_ID", "").lower()  # 세션이 스스로 닫는 경우
    if s["state"] != "idle" and not force and not own:
        return f"닫지 않음: 세션이 {s['state']} 상태입니다 (그래도 닫으려면 --force)"
    r = cmux("rpc", "surface.list", json.dumps({"workspace_id": s["workspace"]}))
    try:
        alone = len(json.loads(r.stdout).get("surfaces", [])) <= 1
    except ValueError:
        alone = False
    if alone:  # 마지막 pane 이면 빈 워크스페이스가 남지 않게 워크스페이스째 닫는다
        r = cmux("close-workspace", "--workspace", s["workspace"], "--force")
    else:
        r = cmux("close-surface", "--surface", s["panel"], "--workspace", s["workspace"], "--force")
    if r.returncode:
        return "닫기 실패: " + r.stderr.strip()
    log_closed(s, note, True)
    return None


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "show"
    if cmd in ("-h", "--help", "help") or any(a in ("-h", "--help") for a in argv[2:3]):
        print(__doc__)  # 도움말: 보고·메모로 보내거나 목록을 바꾸지 않는다(11-23: `brief report --help` 가 보고로 나감)
        return
    if cmd == "sessions":
        ss = sessions()
        for g in teams(ss):  # collab 묶음에 속한 세션에 이름을 붙여 준다
            for m in g["members"]:
                for s in ss:
                    if s["panel"] == m["panel"]:
                        s["collab"] = g["name"]
        rc, fx = recaps(ss), facts(ss)
        for x in ss:
            if x["panel"].lower() in rc:
                x["recap"] = rc[x["panel"].lower()]
            x.update(fx.get(x["panel"].lower(), {}))
        print(json.dumps(ss, ensure_ascii=False, indent=1))
    elif cmd == "note" and len(argv) > 2:  # 목표 밖의 발견을 데스크에 넘긴다(고치지 않고)
        text = " ".join(argv[2:]).strip()
        me, s = me_session()
        os.makedirs(os.path.dirname(NOTES), exist_ok=True)
        with open(NOTES, "a") as f:
            f.write(json.dumps({"at": int(time.time()), "panel": s.get("panel") or me, "title": s.get("title", ""),
                                "cwd": s.get("cwd") or os.getcwd().replace(HOME, "~"), "text": text},
                               ensure_ascii=False) + "\n")
        patrol(False)
        print("데스크에 넘김: " + text + " (이 세션은 본래 일을 계속하세요)")
    elif cmd == "report" and len(argv) > 2:  # 데스크에 보고. 주소는 지금 찾고, 못 보내도 기록이 남는다
        text = sys.stdin.read() if argv[2:] == ["-"] else " ".join(argv[2:])
        if not text.strip():
            sys.exit("brief: 보고 내용이 비었습니다")
        report(text.strip())
    elif cmd == "send" and len(argv) > 3:  # 데스크가 세션에 일·결정을 넘긴다
        s = resolve(argv[2], unlisted=True)
        text = sys.stdin.read() if argv[3:] == ["-"] else " ".join(argv[3:])
        if not text.strip():
            sys.exit("brief: 보낼 글이 비었습니다")
        ok, line = send(s, text.strip())
        print(f"{line} — {s['title'] or s['panel']}")
        if not ok:
            sys.exit(1)
    elif cmd == "desk":  # 데스크(orch) panel id. 없으면 exit 1
        d = desk_panel()
        if not d:
            sys.exit(1)
        print(d)
    elif cmd == "teams":
        print(json.dumps(teams(), ensure_ascii=False, indent=1))
    elif cmd == "plan":
        items = json.load(sys.stdin)
        known = {s["panel"].lower(): s for s in sessions()}
        plan = {"at": int(time.time()), "items": []}
        for it in items:
            s = known.get(str(it.get("panel", "")).lower())
            if not s:
                sys.exit("brief: 모르는 panel 입니다 (brief sessions 의 panel 값을 쓰세요): " + str(it.get("panel")))
            plan["items"].append({"panel": s["panel"], "workspace": s["workspace"],
                                  "title": s["title"], "do": str(it.get("do", "")).strip(), "done": False})
        save_plan(plan)
        print(f"TODO {len(plan['items'])}개를 Sessions 패널에 올렸습니다.")
    elif cmd == "add" and len(argv) > 3:
        s = resolve(argv[2])
        plan = load_plan()
        if any(it["panel"] == s["panel"] and not it["done"] for it in plan["items"]):
            sys.exit("brief: 이미 목록에 있는 세션입니다: " + s["title"])
        plan["at"] = int(time.time())
        plan["items"].append({"panel": s["panel"], "workspace": s["workspace"],
                              "title": s["title"], "do": " ".join(argv[3:]).strip(), "done": False})
        save_plan(plan)
        print(f"{len(plan['items'])}번으로 추가: {s['title']}")
    elif cmd in ("go", "ping") and len(argv) > 2:
        s = resolve(" ".join(argv[2:]).strip())
        if cmd == "go":
            r = cmux("select-workspace", "--workspace", s["workspace"])
            r2 = cmux("focus-panel", "--panel", s["panel"], "--workspace", s["workspace"])
            if r.returncode or r2.returncode:
                sys.exit("brief: 이동 실패: " + (r.stderr + r2.stderr).strip())
        r = flash(s)
        if r.returncode:
            sys.exit("brief: 깜빡이기 실패: " + r.stderr.strip())
        print(("이동: " if cmd == "go" else "핑: ") + s["title"])
    elif cmd == "done" and len(argv) > 2:
        rest, note = argv[2:], None
        if "--verified" in rest:  # --verified "<검토 기록>"
            k = rest.index("--verified")
            if k + 1 >= len(rest) or not rest[k + 1].strip() or rest[k + 1].startswith("--"):
                sys.exit('brief: --verified 뒤에 검토 기록을 붙여 주세요. 예: --verified "git status 깨끗, PR #12 확인"')
            note, rest = rest[k + 1], rest[:k] + rest[k + 2:]
        flags = [a for a in rest if a.startswith("--")]
        ref = " ".join(a for a in rest if not a.startswith("--")).strip()
        undo = "--undo" in flags
        final = undo or note is not None or "--now" in flags  # 검토를 거쳤거나(--verified) 내가 건너뛰었을 때(--now)만 끝낸다
        plan = load_plan()
        s = None
        if ref.isdigit():
            i = int(ref) - 1
            if not 0 <= i < len(plan["items"]):
                sys.exit(f"brief: 목록에 {ref}번이 없습니다")
            idx, title = [i], plan["items"][i]["title"]
            if not undo:
                s = next((x for x in sessions() if x["panel"] == plan["items"][i]["panel"]), None)
        else:
            s = resolve(ref)
            idx = [n for n, it in enumerate(plan["items"]) if it["panel"] == s["panel"] and it["done"] == undo]
            title = s["title"]
        if not final:  # 완료 표시 전에 세션의 보고를 받아 데스크가 대조한다
            ok, why = request_close(s) if s else (False, "보고 요청 생략: 이미 닫힌 세션입니다 (데스크가 직접 확인 후 --verified)")
            for i in idx:
                plan["items"][i]["review"] = True
            if idx:
                save_plan(plan)
            print(f"완료 검토 요청 보냄: {title} — {why} (세션이 보고하면 데스크가 대조한 뒤 완료 처리합니다)" if ok else why)
            render()
            return
        for i in idx:
            plan["items"][i]["done"] = not undo
            plan["items"][i].pop("review", None)
        if idx:
            save_plan(plan)
            print(("되돌림: " if undo else "완료: ") + title + (f" (검토: {note})" if note else ""))
        if undo:
            pass
        elif "--keep" in flags or not s:
            if s:
                log_closed(s, note, False)
            print("세션은 열어 둡니다" if s else "세션은 이미 닫혀 있습니다")
        else:
            why = close_session(s, "--force" in flags, note)
            print(why or "세션 닫음: " + title + " (기록·다시 열기: brief closed)")
        render()
    elif cmd == "patrol":
        patrol("--read" in argv)
    elif cmd == "doc":  # 가장 최근 데스크 문서의 절대 경로 (mod 가 읽는다. 세션의 cwd 와 무관해야 한다)
        d = os.path.join(DESK_DIR, "Desk")
        docs = sorted(f for f in os.listdir(d) if re.fullmatch(r"\d+\.md", f)) if os.path.isdir(d) else []
        if docs:
            print(os.path.join(d, docs[-1]))
    elif cmd == "board":
        if "--set" in argv:
            k = argv.index("--set")
            day = argv[argv.index("--day") + 1] if "--day" in argv else board_day()
            board_set([a for a in argv[k + 1:] if "=" in a], day)
            print(board_trend(7))
            return
        if "--trend" in argv:
            k = argv.index("--trend")
            print(board_trend(int(argv[k + 1]) if len(argv) > k + 1 and argv[k + 1].isdigit() else 14))
            return
        rows = board(log="--log" in argv)
        if "--json" in argv:
            print(json.dumps(rows, ensure_ascii=False))
        else:
            for r in rows:
                print(("! " if r["warn"] else "  ") + r["k"] + ": " + r["text"])
    elif cmd == "view":
        print(desk_view(force=True) or "이미 열려 있습니다")
    elif cmd == "review":
        review(float(argv[2]) if len(argv) > 2 else 1)
    elif cmd == "closed":
        try:
            recs = [json.loads(l) for l in open(CLOSED) if l.strip()]
        except (OSError, ValueError):
            recs = []
        try:
            mark = json.load(open(CLOSED_MARK))
        except (OSError, ValueError):
            mark = {}
        if "--ack" in argv:  # 데스크가 보고에 넣은 뒤: 마지막 --unreported 로 본 것까지 보고한 것으로 친다
            mark["reported"] = max(mark.get("reported", 0), mark.get("seen", 0))
            with open(CLOSED_MARK, "w") as f:
                json.dump(mark, f)
            print("보고함으로 표시: " + time.strftime("%m-%d %H:%M", time.localtime(mark["reported"])) + " 까지")
            return
        unrep = "--unreported" in argv
        if unrep:  # 아직 보고에 들어가지 않은 기록 전부. 본 지점은 --ack 가 확정한다
            recs = [r for r in recs if r["at"] > mark.get("reported", 0)]
            if recs:
                mark["seen"] = max(r["at"] for r in recs)
                os.makedirs(os.path.dirname(CLOSED_MARK), exist_ok=True)
                with open(CLOSED_MARK, "w") as f:
                    json.dump(mark, f)
        else:
            recs = recs[-10:]
        for rec in reversed(recs):
            how = ("검토: " + rec["verified"]) if rec.get("verified") else "검토 없이 닫음"
            if not rec.get("closed", True):
                how += " · pane 은 열어 둠"
            warn = False
            if "check" in rec:
                c = rec["check"]
                got = [f"{name} {c[k]}" for k, name in (("uncommitted", "미커밋"), ("unpushed", "미push")) if k in c]
                got += [f"미응답 질문 \"{c['question']}\""] if c.get("question") else []
                warn = not rec.get("verified") and bool(c.get("uncommitted") or c.get("unpushed") or c.get("question"))
                how += " · 닫힐 때 대조: " + (", ".join(got) or "git 저장소 아님, 질문 없음")
            print(f"{'! ' if warn else ''}{time.strftime('%m-%d %H:%M', time.localtime(rec['at']))}  {rec['title']}\n    {how}\n    {resume_cmd(rec)}")
        if not recs:
            print("(보고 안 한 닫힌 세션 없음)" if unrep else "(닫은 세션 기록 없음)")
    elif cmd == "show":
        plan = load_plan()
        for n, it in enumerate(plan["items"], 1):
            print(f"{n}. [{'x' if it['done'] else ' '}] {it['title']} — {it['do']}")
        if not plan["items"]:
            print("(TODO 목록 없음)")
    elif cmd == "render":
        render()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
