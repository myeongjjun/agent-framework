def past_desk(spawner_ref, worker_ref, slug):
    """닫힌 spawner 가 데스크였는지. 데스크는 매일 새로 뜨므로 어제 데스크가 띄운 세션의 spawner 는 이제 없다.
    사실로 가린다: 데스크(DESK_DIR 에서 뜬 orch)의 대화 기록에 sib 출력(그 slug 와 띄운 pane 의 surface ref)이 있으면
    데스크다. 판정은 spawner ref 마다 캐시에 남긴다(오늘 데스크의 ref 는 tree_data 가 미리 적는다)."""
    if not spawner_ref:
        return False
    try:
        known = json.load(open(DESK_REFS))
    except (OSError, ValueError):
        known = {}
    if spawner_ref in known:
        return known[spawner_ref]
    proj = os.path.join(HOME, ".claude/projects", re.sub(r"[^A-Za-z0-9]", "-", DESK_DIR))
    hit = False
    try:
        for f in os.listdir(proj):
            if f.endswith(".jsonl") and worker_ref:
                t = open(os.path.join(proj, f), errors="replace").read()
                if worker_ref in t and slug in t:
                    hit = True
                    break
    except OSError:
        pass
    known[spawner_ref] = hit
    try:
        os.makedirs(os.path.dirname(DESK_REFS), exist_ok=True)
        json.dump(known, open(DESK_REFS + ".tmp", "w"))
        os.replace(DESK_REFS + ".tmp", DESK_REFS)
    except OSError:
        pass
    return hit


def remember_desk_ref(desk):
    """오늘 데스크의 surface ref 를 적어 둔다: 내일 이 데스크가 닫혀도 그것이 띄운 세션을 '데스크'로 읽게."""
    ref = SURF_REF.get((desk or "").lower())
    if not ref:
        return
    try:
        known = json.load(open(DESK_REFS))
    except (OSError, ValueError):
        known = {}
    if known.get(ref) is not True:
        known[ref] = True
        try:
            os.makedirs(os.path.dirname(DESK_REFS), exist_ok=True)
            json.dump(known, open(DESK_REFS + ".tmp", "w"))
            os.replace(DESK_REFS + ".tmp", DESK_REFS)
        except OSError:
            pass


def agent_roles():
    """에이전트 정의(역할) 이름 → description. ~/.claude/agents 와 이 레포의 agents/."""
    out = {}
    for d in (os.path.join(HOME, ".claude/agents"), os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "agents")):
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for n in names:
            if not n.endswith(".md") or n == "README.md" or n[:-3] in out:
                continue
            try:
                head = open(os.path.join(d, n)).read(4000)
            except OSError:
                continue
            m = re.search(r"^description:\s*(.+)$", head, re.M)
            out[n[:-3]] = (m.group(1).strip().strip('"') if m else "")
    return out


def agent_flags(ps_out=None):
    """세션이 어떤 에이전트 정의로 도는지(`claude --agent X`): {session id: X}. 프로세스 인자에서 읽는다."""
    if ps_out is None:
        try:
            ps_out = subprocess.run(["ps", "-axo", "command="], capture_output=True, text=True, timeout=10).stdout
        except (OSError, subprocess.SubprocessError):
            return {}
    out = {}
    for line in ps_out.splitlines():
        a, sid = re.search(r"\s--agent[ =](\S+)", line), re.search(r"\s--session-id[ =](\S+)", line)
        if a and sid:
            out[sid.group(1)] = a.group(1)
    return out


HR_RUN = os.path.join(HOME, ".local/share/cmux/hr/run")  # agent-scout 가 답을 받은 뒤 위원 task.md 를 옮겨 두는 곳
ROUND_KO = {"propose": "새 에이전트 발굴", "vote": "후보 찬반 투표", "evaluate": "초안 심사", "egrade": "심사 채점",
            "judge": "발굴 채점"}
_TOPIC = {}


def meeting_topic(member, rnd, run, workdir=""):
    """회의 주제: 위원이 받은 task.md 의 초안(`=== draft `X` ===`)·후보(`- idea `X``) 이름과 회의 종류.
    task.md 는 pane 의 workdir 에 있고, 답을 받은 뒤에는 HR 기록(hr/run/<날짜>-<위원>-<회의>-<pid>)으로 옮겨진다."""
    import glob
    key = (member, rnd, run)
    if _TOPIC.get(key):
        return _TOPIC[key]
    paths = [os.path.join(workdir, "task.md")] if workdir else []
    paths += [p for p in glob.glob(os.path.join(HR_RUN, f"*-{member}-{rnd}-*", "task.md"))
              if re.search(r"-(\d+)/task\.md$", p) and int(re.search(r"-(\d+)/task\.md$", p).group(1)) % 10000 == int(run)]
    names = []
    for p in paths:
        try:
            t = open(p, errors="replace").read()
        except OSError:
            continue
        for n in re.findall(r"=== draft `([^`]+)` ===|^- idea `([^`]+)`|draft `([^`]+)` —", t, re.M):
            n = next(x for x in n if x)
            if n not in names:
                names.append(n)
        break
    what = ROUND_KO.get(rnd, rnd)
    topic = what + (": " + ", ".join(names[:3]) + (f" 외 {len(names) - 3}" if len(names) > 3 else "") if names else "")
    if names or rnd == "propose":
        _TOPIC[key] = topic  # 이름을 찾았을 때만 기억한다(task.md 가 아직 안 쓰였을 수 있다)
    return topic


MEETING = re.compile(r"^scout-([a-z0-9]+)-([a-z]+)-(\d+)$")  # agent-scout 의 위원·심판 pane slug


def load_areas():
    """영역 프로파일(orch-areas.md 의 `## 영역`)과 먼저 묻는 영역(orch-local.md 의 Ask-first areas).
    [{"name", "kind": "profile"|"ask", "decides": 설명, "paths": [...], "words": [...]}] — ask 가 앞에 온다."""
    areas, ask = [], []
    cur = None
    try:
        for line in open(AREAS):
            h = re.match(r"^##\s+(.+?)\s*$", line)
            if h and not line.startswith("###"):
                cur = {"name": h.group(1), "kind": "profile", "paths": [], "perm": {}, "stage": None}
                areas.append(cur)
            elif cur and line.lstrip().startswith("- Covers:"):
                cur["paths"] += [os.path.expanduser(t.rstrip("/")) for t in re.findall(r"`([~/][^`]*)`", line)]
            elif cur and (m := re.match(r"^\|\s*(\w+)\s*\|\s*(\w+)\s*\|", line)) and m.group(1) not in ("kind",):
                cur["perm"][m.group(1)] = m.group(2)
            elif cur and (m := re.search(r"Stage:\s*(\d+)", line)) and cur["stage"] is None:
                cur["stage"] = m.group(1)
    except OSError:
        pass
    for a in areas:
        lv = set(a["perm"].values())
        if lv == {"decide"}:
            a["decides"] = "데스크가 결정"
        elif lv and lv <= {"ask"}:
            a["decides"] = "사용자가 결정"
        elif lv:
            a["decides"] = "데스크: " + ",".join(k for k, v in a["perm"].items() if v == "decide") + \
                " · 사용자: " + ",".join(k for k, v in a["perm"].items() if v != "decide")
        else:
            a["decides"] = "권한표 없음"
        if a["stage"]:
            a["decides"] += f" · 시험 {a['stage']}단계"
    try:
        on = False
        for line in open(LOCAL):
            if "Ask-first areas" in line:
                on = True
                continue
            if on:
                m = re.match(r"^\s+-\s+([^:]+):(.*)$", line)
                if not m:
                    if line.strip() and not line.startswith(" "):
                        break
                    continue
                words = {m.group(1).strip().lower()} | {t.strip("*").lower() for t in re.findall(r"`([^`]+)`", m.group(2))}
                ask.append({"name": m.group(1).strip(), "kind": "ask", "decides": "먼저 묻기 · 사용자가 결정",
                            "words": sorted(w for w in words if len(w) > 2), "paths": []})
    except OSError:
        pass
    return ask + areas


def area_of(x, areas, slug=""):
    hay = " ".join([x.get("title") or "", x.get("cwd") or "", slug]).lower()
    cwd = os.path.expanduser(x.get("cwd") or "")
    for a in areas:
        if a["kind"] == "ask" and any(w in hay for w in a["words"]):
            return a["name"]
        if a["kind"] == "profile" and any(cwd == p or cwd.startswith(p + "/") for p in a["paths"]):
            return a["name"]
    return None


OUTSIDE = "영역 밖"
OFFICE_ART_PREFIX = "office-art-"  # 사무실 창이 역할 그림을 맡기는 Codex pane 의 slug


def tree_data(ss=None, events=None):
    """사용자 → 데스크 → 영역 → 세션(→ 그 세션이 띄운 세션). 세션마다 띄운 주체와 기다리는 대상."""
    ss = ss if ss is not None else sessions()
    desk = desk_panel()
    dlow = (desk or "").lower()
    live = {x["panel"].lower(): x for x in ss}
    links = sib_links(ss)
    areas = load_areas()
    fx = facts(ss, desk)
    try:
        ans = answered(ss)
    except Exception:
        ans = []
    items = load_plan()["items"]
    decided = {}  # panel -> answered?
    for r in ans:
        n = r.get("n") or 0
        if 0 < n <= len(items):
            p = items[n - 1]["panel"].lower()
            decided[p] = decided.get(p, True) and bool(r.get("answered"))
    events = events if events is not None else read_events(time.time() - 2 * 86400)
    reported = {}
    for e in events:
        if e.get("what") == "report" and e.get("panel"):
            reported[e["panel"].lower()] = max(reported.get(e["panel"].lower(), 0), e["at"])

    remember_desk_ref(desk)

    def spawned_by(x):
        ln = links.get(x["panel"])
        if not ln:
            return {"kind": "user", "label": "사용자"}
        if ln["slug"].startswith(OFFICE_ART_PREFIX):
            return {"kind": "office", "label": "사무실 창 (역할 그림 요청)", "slug": ln["slug"]}
        sp = (ln["spawner"] or "").lower()
        if sp and sp == dlow:
            return {"kind": "desk", "label": "데스크", "slug": ln["slug"]}
        kind = "collab" if ln["collab"] else "session"
        if sp in live:
            t = live[sp]["title"] or sp[:8]
            return {"kind": kind, "label": ("/collab: " if ln["collab"] else "세션: ") + t, "panel": live[sp]["panel"],
                    "slug": ln["slug"]}
        if not ln["collab"] and past_desk(ln.get("spawner_ref"), ln.get("ref"), ln["slug"]):
            return {"kind": "desk", "label": "데스크 (지난 데스크)", "slug": ln["slug"]}
        return {"kind": kind, "label": "닫힌 세션" + (" (/collab)" if ln["collab"] else ""), "slug": ln["slug"]}

    def waiting(x):
        p = x["panel"].lower()
        f = fx.get(p, {})
        if p in decided:
            return ({"who": "desk", "label": "데스크의 확인 (결정에 답함)"} if decided[p]
                    else {"who": "user", "label": "사용자의 결정 (결정 필요)"})
        if f.get("question"):
            q = f["question"]
            return {"who": "user", "label": "사용자의 답: " + (q if len(q) <= 60 else q[:59] + "…")}
        if x.get("state") == "working":
            return {"who": "none", "label": "없음 (일하는 중)"}
        rep = reported.get(p, 0)
        if rep and rep >= turns_input(x):
            return {"who": "desk", "label": "데스크의 대조 (완료 보고 보냄)"}
        if f.get("desk_msg_at") and f.get("started") is False:
            return {"who": "none", "label": "없음 (데스크 글이 아직 시작 안 됨)"}
        return {"who": "none", "label": "없음 (쉬는 중)"}

    roles, flags = agent_roles(), agent_flags()
    nodes, meetings = {}, {}
    for x in ss:
        if x["panel"].lower() == dlow:
            continue
        ln = links.get(x["panel"]) or {}
        slug = ln.get("slug", "")
        by = spawned_by(x)
        n = {"panel": x["panel"], "title": x["title"], "name": x["title"], "agent": x["agent"], "state": x["state"],
             "cwd": x["cwd"], "area": area_of(x, areas, slug) or OUTSIDE, "role": flags.get(x.get("session")),
             "spawned_by": by, "waiting": waiting(x), "children": []}
        if by["kind"] in ("session", "collab"):
            n["name"] = slug  # 세션이 띄운 pane 의 제목은 받은 프롬프트로 덮이기 쉽다(위원회 pane: "You are a member…")
        m = MEETING.match(slug)
        if m:  # 위원회 회의: 영역이 아니라 회의마다 회의실 하나. 소집한 세션과는 점선으로 잇는다
            member, rnd, run = m.groups()
            n["name"] = f"{member} · {rnd}"
            n["role"] = n["role"] or ("scout-" + member if "scout-" + member in roles else None)  # 위원 = 그 정의
            room = f"위원회 회의 {run}"
            n["area"], n["meeting"] = room, room
            mt = meetings.setdefault(room, {"rounds": [], "by": by["label"], "topics": []})
            if rnd not in mt["rounds"]:
                mt["rounds"].append(rnd)
            t = meeting_topic(member, rnd, run, ln.get("workdir", ""))
            if rnd in ("egrade", "judge") and mt["topics"]:
                pass  # 심판의 채점은 같은 초안이다: 주제를 늘리지 않는다
            elif t not in mt["topics"] and not any(o.startswith(t) for o in mt["topics"]):
                mt["topics"] = [o for o in mt["topics"] if not t.startswith(o)] + [t]
        nodes[x["panel"].lower()] = n
    roots = []
    for p, n in nodes.items():
        sp = (n["spawned_by"].get("panel") or "").lower()
        if sp in nodes and sp != p and not n.get("meeting"):
            nodes[sp]["children"].append(n)
        else:
            roots.append(n)
    out_areas = []
    rooms = [{"name": k, "kind": "meeting", "topic": " · ".join(v["topics"]),
              "decides": "소집: " + v["by"].replace("세션: ", "") + " · " + "/".join(v["rounds"])}
             for k, v in sorted(meetings.items())]
    for a in areas + rooms + [{"name": OUTSIDE, "kind": "none", "decides": "데스크 기본 규칙 (orch.md)"}]:
        mem = [n for n in roots if n["area"] == a["name"]]
        if mem or a["kind"] not in ("none", "meeting"):
            out_areas.append({"name": a["name"], "kind": a["kind"], "decides": a["decides"], "sessions": mem,
                              **({"topic": a["topic"]} if a.get("topic") else {})})
    dx = live.get(dlow)
    return {"user": "사용자",
            "desk": {"panel": desk, "title": dx["title"] if dx else None, "state": dx["state"] if dx else None}
            if desk else None,
            "areas": out_areas}


def turns_input(x):
    return turns(x)["input"]


def handoffs(evs, data, window=120):
    """다른 에이전트(데스크·세션·사무실 창)가 띄운 pane 의 첫 입력은 사용자가 친 글이 아니라 넘겨받은 일이다
    (agent-scout 의 위원 프롬프트에는 sib 계약 문구가 없어 입력으로 잡힌다). 띄운 뒤 window 초 안의 input 을 handoff 로."""
    by, name = {}, {}

    def walk(ns):
        for n in ns:
            by[n["panel"].lower()] = n["spawned_by"]["kind"]
            if n.get("name") and n["name"] != n["title"]:
                name[n["panel"].lower()] = n["name"]  # 이벤트 줄도 화면의 이름으로(프롬프트로 덮인 제목 대신)
            walk(n["children"])
    for a in data["areas"]:
        walk(a["sessions"])
    born = {}
    for e in evs:
        if e.get("what") == "new":
            p = (e.get("panel") or "").lower()
            born[p] = min(born.get(p, e["at"]), e["at"])
    out = []
    for e in evs:
        p = (e.get("panel") or "").lower()
        if e.get("what") == "input" and by.get(p, "user") != "user" and p in born and 0 <= e["at"] - born[p] < window:
            e = dict(e, what="handoff")
        if p in name and e.get("what") not in ("msg", "read"):
            e = dict(e, title=name[p])
        out.append(e)
    return out


def message_events(since, ss):
    """에이전트 사이의 cmux 메시지(데스크→세션 지시, 세션→데스크 보고, 세션↔세션)를 이벤트로. 보낸 때와 읽힌 때 둘."""
    names = {x["panel"].lower(): x["title"] for x in ss}
    desk = (desk_panel() or "").lower()
    if desk:
        names[desk] = "데스크"
    who = lambda sid, fallback: names.get((sid or "").lower()) or fallback or (sid or "?")[:8]
    out = []
    for m in messages():
        a = who(m.get("sender_surface_id"), m.get("sender_name"))
        b = who(m.get("recipient_surface_id"), None)
        body = " ".join(str(m.get("body", "")).split())
        if m.get("created_at", 0) >= since:
            out.append({"at": m["created_at"], "what": "msg", "panel": m.get("recipient_surface_id"),
                        "from_panel": m.get("sender_surface_id"), "title": f"{a} → {b}", "text": body[:100],
                        "id": m.get("id")})
        if (m.get("read_at") or 0) >= since:
            out.append({"at": m["read_at"], "what": "read", "panel": m.get("recipient_surface_id"),
                        "from_panel": m.get("sender_surface_id"),
                        "title": f"{b} 읽음 ← {a}", "text": body[:60], "id": m.get("id")})
    return out


def snap_events(prev, ss, now):
    """화면이 직접 본 변화: 새 세션, 턴 시작, 턴 끝, 닫힘."""
    out = []
    cur = {x["panel"]: x for x in ss}
    for p, x in cur.items():
        o = prev.get(p)
        if o is None:
            out.append({"at": now, "what": "new", "panel": p, "title": x["title"]})
        elif o["state"] != "working" and x["state"] == "working":
            out.append({"at": now, "what": "start", "panel": p, "title": x["title"]})
        elif o["state"] == "working" and x["state"] != "working":
            out.append({"at": now, "what": "turn_ended", "panel": p, "title": x["title"]})
    for p, o in prev.items():
        if p not in cur:
            out.append({"at": now, "what": "closed", "panel": p, "title": o["title"]})
    return out


def merge_events(evs, window=90):
    """같은 세션의 같은 일이 순찰 기록과 화면 관찰에 둘 다 있으면 하나로(먼저 본 것을 남긴다)."""
    out, seen = [], {}
    for e in sorted(evs, key=lambda e: e["at"]):
        k = (e.get("what"), (e.get("panel") or "").lower(), e.get("id"))
        if k in seen and e["at"] - seen[k] < window:
            continue
        seen[k] = e["at"]
        out.append(e)
    return out


