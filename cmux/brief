ART_BAD = re.compile(r"<script|<image|<foreignobject|<style|@import|url\(\s*['\"]?\s*(?:https?:|data:|//)|"
                     r"href\s*=\s*['\"]\s*(?:https?:|data:|//|javascript:)|\son[a-z]+\s*=", re.I)


def art_ok(path):
    """역할 그림 검사: 4KB 이하의 SVG XML, viewBox 있음, 스크립트·외부 참조·이벤트 속성·글꼴 없음. 통과하면 None, 아니면 이유."""
    import xml.etree.ElementTree as ET
    try:
        raw = open(path, "rb").read()
    except OSError:
        return "없음"
    if len(raw) > 4096:
        return f"너무 큼({len(raw)}B)"
    text = raw.decode("utf-8", "replace")
    if ART_BAD.search(text) or "<text" in text.lower():
        return "금지된 요소"
    try:
        root = ET.fromstring(raw)
    except ET.ParseError as e:
        return f"XML 아님({e})"
    if not root.tag.endswith("svg") or not root.get("viewBox"):
        return "svg·viewBox 아님"
    return None


