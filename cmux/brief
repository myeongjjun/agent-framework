#!/usr/bin/env python3
"""brief — 브리핑 에이전트와 cmux pane 을 잇는 도구.

  brief sessions            열려 있는 에이전트 세션 요약(JSON). panel 이 세션의 고유 키.
                            recap 은 그 세션이 마지막으로 남긴 요약(어디까지 했고 다음이 뭔지).
                            Claude·Codex 가 함께 묶인 세션에는 collab 이름이 붙는다.
                            사실 항목(추측 없이 기록에서 읽은 값): input_at(그 pane 의 마지막 사용자 입력),
                            desk_msg_at·started(데스크가 마지막으로 일을 넘긴 시각과 그 뒤 턴이 시작됐는지),
                            question(마지막 답이 질문으로 끝났고 그 뒤 입력이 없을 때 그 줄),
                            uncommitted·unpushed(cwd 저장소의 미커밋 파일 수·미push 커밋 수).
  brief tree [--json]       에이전트 제어 구조: 사용자 → 데스크 → 영역 → 세션(→ 그 세션이 띄운 세션). 세션마다 띄운
                            주체(sib state)와 기다리는 대상(사용자의 결정·답, 데스크의 대조, 없음), 그리고 최근 이벤트.
  brief tree --watch        같은 화면을 1.5초마다 다시 그린다: 새 세션·턴 시작/끝·사용자 입력·보고·노트·닫힘과
                            에이전트 사이 메시지(보냄·읽음)가 일어나는 대로 그 세션을 강조하고 흐름 줄에 올린다.
  brief tree --toggle       켜기/끄기: 이 pane 오른쪽에 --watch 화면을 열고, 다시 부르면 닫는다(상주 프로세스 없음).
  brief tree --popup        켜기/끄기: 로컬 '사무실' 창(주소창 없는 Chrome 앱 창)을 띄운다. 영역은 방, 세션은 책상의
                            직원(Claude 는 둥근 얼굴·Codex 는 네모 얼굴, 일하면 초록 고리가 돌고, 사용자를 기다리면 ! · 데스크를 기다리면 ?), 메시지·보고·입력은
                            사람 사이를 날아가는 종이로 실시간으로 보인다. 다시 부르면 창과 서버를 끈다.
                          위원회 회의(agent-scout 의 위원 pane)는 회의마다 '위원회 회의 N' 방에 모이고, 방에 주제(발굴,
                          투표 후보, 심사하는 초안 이름: 위원의 task.md 에서 읽음)가 붙는다. 역할
                          (위원 정의, `claude --agent X`)이 있는 직원은 책상에 그 역할의 소품이 놓인다: 소품이 없는
                          역할은 창이 Codex pane 하나에 그려 달라고 맡기고(sib, 하루 한 번), 검사를 통과한 SVG 를
                          ~/.local/share/cmux/office-art/ 에 올린 뒤 그 pane 을 닫는다. 끄기: BRIEF_OFFICE_ART=0.
  brief tree --serve [--port N]  --popup 이 띄우는 서버(127.0.0.1): / 는 화면, /data 는 계속 새로 만든 JSON.
  brief lead <영역> <질문|-> [--kind K] [--ref R] [--json] [--dry-run]
                            영역 담당(Area lead) 호출: 데스크가 영역 세션이 사용자에게 물은 판단 질문을 넘기면, 새 pane
                            없이 한 번 실행돼 그 영역 프로파일(~/.config/cmux/orch-areas.md: 범위·권한표·결정 기록·교훈)
                            만으로 결정과 근거를 돌려주고 Decision log 에 by:lead 로 남긴다. 권한표가 decide 가 아니거나
                            질문이 먼저 묻는 영역·바깥 일·보안·되돌릴 수 없는 일·계약을 건드리면 결정하지 않고 넘긴다
                            (exit 3). 자세한 것은 `brief lead --help`.
  brief teams               collab 묶음 목록(JSON).
  brief desk                데스크(orch) 세션의 panel id(없으면 exit 1). 보고는 `brief report` 로 보낸다.
  brief send <번호|panel|이름> <글|->
                            데스크가 세션에 일·결정을 넘긴다. 쉬는 세션은 입력창에 직접 넣고 턴 시작까지 확인한다
                            (긴 글은 파일에 쓰고 경로 한 줄만 넣는다. 좁은 pane 에서도 들어간다). 일하는 중이거나
                            승인 화면이면 cmux 메시지로 보내고, cmux 가 그 pane 의 에이전트를 모르면(재시작 전 세션)
                            입력 대기열에 넣는다. 첫 단어가 결과다: 전달됨 / 대기열 / 전달 못 함(exit 1).
                            `brief sessions` 에 안 보이는 pane(panel id)에도 보낸다.
  brief report <글|->       데스크에 보고(done-report 등)를 보낸다. 데스크 주소는 보내는 순간에 찾고, 보낸 이는 이
                            세션의 제목과 panel 로 적는다. 보고는 먼저 파일에 남겨, 데스크가 없거나 닫혔거나 메시지를
                            못 읽었으면 다음 데스크가 `brief patrol --read` 에서 `report` 줄로 받는다.
  brief note <한 줄>         목표 밖에서 발견한 일을 고치지 않고 데스크에 넘긴다. 다음 순찰에서 데스크가
                            `결정 필요`에 올리고, 승인되면 새 세션에 배치한다.
  brief plan < plan.json    TODO 목록을 Sessions 패널 맨 위에 올린다.
                            입력: [{"panel": "<panel id>", "do": "다음 한 수"}, ...] (우선순위 순)
  brief add <panel> <할 일>  목록 끝에 항목 하나를 추가한다.
  brief go <번호|panel|이름> 그 세션의 pane 으로 이동하고 깜빡인다. 이름은 제목 일부면 된다.
  brief ping <번호|panel>   이동 없이 깜빡이기만 한다.
  brief done <번호|panel|이름|here>
                            완료 검토를 시작한다: 그 세션의 입력창에 완료 보고 요청을 직접 넣는다(멈춘 세션도
                            바로 턴을 시작한다. 못 넣으면 이유를 바로 알린다). 세션은 한 일·산출물·
                            미커밋·남은 일을 데스크(orch)에 보고하고 열린 채로 기다린다.
                            --verified "<검토 기록>"  데스크가 보고를 실제와 대조한 뒤 부른다: 완료 표시,
                                    기록, pane 닫기 (--keep 을 같이 주면 pane 은 둔다). 입력 칸에 데스크가 넣지 않은
                                    보내지 않은 글이 있으면 닫지 않고 그 글을 보여 준다(exit 1. 사용자가 쓰는 중일 수
                                    있다). 쓰다 만 글이 아님을 확인했을 때만 --drop-unsent 로 넘긴다(--now 도 같다).
                                    Claude Code 의 프롬프트 제안(cmux 입력 상태가 empty)은 보내지 않은 글이 아니다.
                            --now   검토를 건너뛰고 바로 끝낸다(내가 직접 쓸 때만. 일하는 중이면 거부, --force).
                            --undo  완료 표시를 되돌린다.   here 는 지금 이 pane.
  brief patrol              순찰 신호. 지난번 이후 턴이 끝났거나 닫히거나 새로 생긴 세션을 모아 두고,
                            바뀐 것이 있으면 데스크(orch)에 `patrol <건수>` 를 보낸다(기본 10분에 한 번,
                            BRIEF_PATROL_MIN).
                            cmux 자동화가 세션의 턴이 끝날 때와 pane 이 닫힐 때마다 부른다. 데스크 검토 없이
                            닫힌 pane 은 그 자리에서 대조해(cwd 의 미커밋·미push, 마지막 답의 미응답 질문)
                            `brief closed` 에 검토 없이 닫힌 것으로 남긴다.
  brief patrol --input      사용자가 어느 pane 에 입력했다는 신호(cmux 자동화가 UserPromptSubmit 마다 부른다. pane 은
                            이벤트의 surface_id). 몇 초 뒤 그 세션의 대화 기록을 보고 데스크·sib 가 넣은 글이 아니라
                            사용자 입력일 때만 `input` 변화로 쌓는다. 그 pane 에 `결정 필요`가 걸려 있으면 10분 간격을
                            기다리지 않고(1분에 한 번까지) 데스크를 깨운다.
  brief patrol --read       모아 둔 변화를 한 줄에 한 건(JSONL)으로 내보내고 비운다(데스크가 읽는다). 한 번이라도 읽은
                            데스크만 순찰 신호를 받는다. 새 데스크의 첫 --read 는 이전 데스크가 보내고 아직
                            안 읽힌 cmux 메시지를 읽음 처리하고 `retired` 줄로 알린다(닫힌 데스크로 답하지 않게).
                            살아 있는 세션의 줄에는 `brief sessions` 와 같은 사실
                            항목이, 닫힌 세션의 줄에는 닫힐 때의 대조(check) 또는 검토 기록(verified)이 붙는다.
  brief answered            오늘 데스크 문서 `결정 필요`의 줄마다(문서 순서, i) 그 줄이 올라온 뒤 그 세션(TODO 번호 n)의
                            pane 에 사용자 입력이 있었는지(JSON). 있으면 answered·input_at. Desk 패널이 이 값으로
                            그 줄을 "답함, 확인 대기"로 흐리게 그린다(데스크가 문서를 고치기 전에도).
  brief review [일수]        데스크 세션에서 내가 한 말·쓴 명령·그 직전 데스크의 답을 시간순으로 뽑는다
                            (기본 1일, 자기 개선용). 맨 끝에 명령별 사용 횟수.
  brief board [--json]      에이전트 전체 지표. 첫 줄이 핵심 지표 '사용자에게 넘김': 오늘 데스크 문서의 `결정 필요`와
                            `진행 중`에서 사용자의 말을 기다리며 열어 둔 세션 줄을 하루 동안 모은 건수와, 그중 데스크가
                            묻지 않고 했어야 하는 것(배치·대조를 통과한 세션 닫기). 이어서 세션 수·상태, 오늘 완료(검토
                            여부), 결정 대기, 개선 루프 둘(orch 교훈, 차단 훅). 값은 하루 한 줄씩
                            ~/.local/share/cmux/board.jsonl 에 쌓이고(순찰 때 갱신),
                            이틀치부터 줄 끝에 최근 7일 추이 막대가 붙는다.
  brief board --trend [일수] 날짜별 표(기본 14일).
  brief board --set k=v ... [--day YYYY-MM-DD]
                            직접 센 값을 그날 줄에 적는다: corrections(내가 고쳐 말한 횟수), roundtrips(요청당
                            왕복), mismatches(완료 대조에서 어긋난 건수), asked·avoidable(데스크가 아침에 다시 센
                            넘긴 결정과 스스로 할 수 있었던 것). 직접 적은 값은 도구가 다시 세어 덮지 않는다.
  brief view                데스크 워크스페이스 왼쪽에 오늘 데스크 문서를 서식 있는 뷰어로 연다(자동으로는 열지 않는다).
  brief closed              끝낸 세션 기록(검토 내용)과 다시 여는 명령(최근 10개).
  brief closed --unreported 아직 사용자 보고에 들어가지 않은 닫힌 세션 전부. 검토 없이 닫혔는데 미커밋·미push·
                            미응답 질문이 남은 줄은 맨 앞에 `!` 가 붙는다.
  brief audit [--day YYYY-MM-DD] [--all] [--json] [--fresh]
                            닫기 검사: 그날(05시 기준) 닫힌 세션을 데스크가 아닌 도구가 다시 판정한다. 데스크의 검토
                            기록은 근거로 쓰지 않고 세션의 대화 기록(마지막 done-report, 답 없는 질문), 데스크가 닫기
                            직전에 도구가 찍은 입력 칸의 보내지 않은 글, 지금의 git(세션이 고친 파일의 미커밋, 세션이
                            만든 커밋의 미push — ready 보고가 있으면 넘긴 것으로 친다)만 본다. `!` 는 일이 남은 채
                            닫힘. 결과는 `brief board` 의 '닫기 검사' 줄과 `brief closed` 의 '검사:' 줄에도 나온다.
                            호출자가 `sib kill` 로 닫은 일꾼 pane(위원회·그림 일꾼)은 by=caller 로 따로 세고 사용자·
                            데스크의 '일이 남은 채'·'보고 없이' 에 넣지 않는다(~/.local/share/sib/killed.jsonl).
                            `brief board --trend` 의 닫기 검사 열도 같은 판정으로 다시 센 값이다.
                            '끝났는데 열어 둠'도 센다: ready 보고(그 뒤 후속 요청에 묻는 말 없이 답한 턴 포함)나 '남은
                            일 없음' 답, 사용자가 끝내라고 한 뒤의 보고 다음, 사용자 입력 없이 BRIEF_HELD_MIN(기본 60)분
                            넘게 열린 구간. 닫힌 세션의 구간과 지금 열린 세션(오늘만)을 함께 보이고 board 에도 줄이 있다.
                            사용자가 끝내라고 한 뒤의 not-ready 는 일이 남은 채 닫음으로 세지 않는다.
  brief closed --ack        보고에 넣은 뒤 부른다: 마지막 --unreported 로 본 것까지 보고한 것으로 표시한다
                            (그 사이 새로 닫힌 것은 다음 --unreported 에 남는다).
  brief show                현재 목록 출력.
  brief render              Sessions 패널 파일을 다시 생성한다(install.sh 가 호출).
  brief <명령> --help        이 도움말(어느 명령 뒤에 붙여도 보내거나 바꾸지 않는다).
"""
import json, os, re, subprocess, sys, time

CMUX = os.environ.get("BRIEF_CMUX", "/Applications/cmux.app/Contents/Resources/bin/cmux")  # 시험용 재정의
HOME = os.path.expanduser("~")
PLAN = os.path.join(HOME, ".cache/cmux/brief-plan.json")
CLOSED = os.path.join(HOME, ".cache/cmux/brief-closed.jsonl")
CLOSED_MARK = os.path.join(HOME, ".cache/cmux/brief-closed-reported.json")  # 어디까지 사용자에게 보고했는지
def local_env(key, default):
    """환경 변수, 없으면 이 기기 전용 설정(~/.config/cmux/local.env, 레포 밖)의 KEY="값"."""
    if os.environ.get(key):
        return os.environ[key]
    try:
        for line in open(os.path.join(HOME, ".config/cmux/local.env")):
            k, _, v = line.strip().partition("=")
            if k == key and v:
                return v.strip('"')
    except OSError:
        pass
    return default


DESK_DIR = local_env("BRIEF_DESK_DIR", os.path.join(HOME, ".local/share/cmux/desk"))  # 데스크가 뜨는 폴더
PATROL = os.path.join(HOME, ".cache/cmux/brief-patrol.json")
NOTES = os.path.join(HOME, ".cache/cmux/brief-notes.jsonl")  # 세션이 `brief note` 로 데스크에 올린 곁가지
REPORTS = os.path.join(HOME, ".cache/cmux/brief-reports.jsonl")  # `brief report` 로 보낸 보고(데스크가 읽을 때까지)
VIEW = os.path.join(HOME, ".cache/cmux/brief-view.json")
RAISED = os.path.join(HOME, ".cache/cmux/brief-decisions.json")  # 결정 줄 → 처음 본 시각(그 줄이 올라온 때)
INPUT_WAIT = float(os.environ.get("BRIEF_INPUT_WAIT", "3"))  # 입력 신호 뒤 대화 기록이 쓰일 때까지 기다리는 초
INPUT_NOTIFY = 60  # 결정이 걸린 pane 의 입력은 이 간격까지 바로 데스크를 깨운다
NO_MAX = os.path.join(HOME, ".cache/cmux/no-maximize")
PATROL_MIN = float(os.environ.get("BRIEF_PATROL_MIN", "10")) * 60
TEMPLATE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "sidebars/sessions.js")
OUT = os.path.join(HOME, ".config/cmux/sidebars/sessions.js")
MARK = "const PLAN = { at: 0, items: [] }; // @plan"
TEAMS_MARK = "const TEAMS = []; // @teams"
RECAPS_MARK = "const RECAPS = {}; // @recaps"
SIB_STATE = os.environ.get("BRIEF_SIB_STATE", os.path.join(HOME, ".local/share/sib/state"))


def cmux(*args):
    return subprocess.run([CMUX, *args], capture_output=True, text=True, env={**os.environ, "CMUX_QUIET": "1"})


def sessions():
    data = json.loads(cmux("current", "--json", "--limit", "200").stdout)
    out = []
    for it in data["items"]:
        agents = it.get("agents") or []
        proj = (it.get("projections") or [{}])[0]
        if not agents or not proj.get("panel_id"):
            continue
        a = agents[0]
        x = {
            "panel": proj["panel_id"],
            "workspace": proj.get("workspace_id"),
            "title": it.get("label", ""),
            "cwd": (it.get("cwd") or "").replace(HOME, "~"),
            "agent": a.get("kind"),
            "state": a.get("state"),
            "session": a.get("session_id"),
            "last_activity": a.get("last_activity_at"),
        }
        if x["state"] == "working" and x["agent"] == "claude" and turn_ended(x):
            x["state"] = "idle"
        out.append(x)
    out.sort(key=lambda s: s["last_activity"] or "", reverse=True)
    return out


MSG_WINDOW = 48 * 3600  # 이 시간 안에 주고받은 메시지만 연결로 본다


def messages():
    """cmux agent message 기록(모든 surface). 실패하면 빈 목록."""
    try:
        return json.loads(cmux("agent", "inbox", "--json", "--limit", "200").stdout).get("messages", [])
    except (ValueError, AttributeError):
        return []


def retire_desk_messages(desk, st):
    """새 데스크가 처음 순찰을 읽을 때: 이전 데스크가 보냈는데 아직 읽히지 않은 cmux 메시지를 읽음 처리한다.
    그 메시지는 닫힌 데스크의 주소로 답하게 하고(11-23: 답이 not_found 로 실패), 세션이 재시작돼야 읽혀
    며칠 뒤 엉뚱하게 깨어난다. 이전 데스크 = 순찰을 읽은 적 있는 데스크 + 데스크의 글(OURS)을 보낸 pane.
    지금 데스크에게 온 메시지(보고)는 건드리지 않는다. 반환: 읽음 처리한 메시지 id 목록."""
    try:
        msgs = json.loads(cmux("agent", "inbox", "--json", "--limit", "5000").stdout).get("messages", [])
    except (ValueError, AttributeError):
        return []
    low = lambda v: (v or "").lower()
    desks = {low(d) for d in st.get("desks", []) + [st.get("desk")] if d}
    desks |= {low(m.get("sender_surface_id")) for m in msgs if str(m.get("body", "")).startswith(OURS)}
    desks -= {"", desk}
    ids = [m["id"] for m in msgs if m.get("id") and not m.get("read_at") and m.get("state") in ("queued", "delivered")
           and low(m.get("sender_surface_id")) in desks and low(m.get("recipient_surface_id")) != desk]
    if ids:
        r = cmux("rpc", "agent.message.mark_read", json.dumps({"ids": ids}))
        try:
            ids = json.loads(r.stdout).get("read", [])
        except ValueError:
            ids = []
    return ids


def teams(ss=None):
    """함께 일하는 세션 묶음(collab)을 찾는다. 연결은 두 가지다.

    1. sib state(<slug>.env): `sib spawn --worktree` 로 띄운 워커(/collab)와 그것을 띄운
       spawner_surface. 이 연결만 있는 묶음은 claude·codex 가 섞였을 때만 collab 으로 본다
       (worktree 없는 dispatch 까지 넣으면 목록이 묶음으로 뒤덮인다).
    2. cmux agent message: 최근 48시간 안에 보냈고 아직 읽지 않은 메시지(답을 기다리는 중)가 있는
       두 세션. 계열과 무관하게 묶는다. 다 읽힌 대화는 묶지 않는다: 오래전에 메시지를 한 번
       주고받았다는 이유로 묶음이 계속 남지 않게.

    묶음마다 마지막 메시지(last)를 붙여, 누가 답을 기다리는지 패널이 보여 줄 수 있게 한다.
    """
    ss = ss if ss is not None else sessions()
    by_panel = {s["panel"]: s for s in ss}
    surf, names = [], []
    try:
        names = sorted(n for n in os.listdir(SIB_STATE) if n.endswith(".env"))
        # surface.list 는 워크스페이스 하나만 답하므로 전부 돈다.
        surf = []
        for w in all_workspaces():
            surf += json.loads(cmux("rpc", "surface.list", json.dumps({"workspace_id": w["id"]})).stdout)["surfaces"]
    except (OSError, ValueError, KeyError):
        pass
    ref2panel = {x["ref"]: x["id"] for x in surf}
    parent = {}

    def find(x):
        while parent.setdefault(x, x) != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    info = {}  # panel -> {agent, slug}
    for name in names:
        if not name.endswith(".env"):
            continue
        try:
            rec = dict(l.strip().split("=", 1) for l in open(os.path.join(SIB_STATE, name)) if "=" in l)
        except OSError:
            continue
        w = ref2panel.get(rec.get("surface", ""))
        sp = ref2panel.get(rec.get("spawner_surface", ""))
        if w not in by_panel:
            continue  # 워커 pane 이 닫혔다
        if rec.get("worktree_managed") != "1":
            continue  # worktree 없는 dispatch 는 collab 이 아니다
        info[w] = {"agent": rec.get("agent") or by_panel[w]["agent"], "slug": rec.get("slug", "")}
        if sp in by_panel:
            info.setdefault(sp, {"agent": by_panel[sp]["agent"], "slug": ""})
            parent[find(w)] = find(sp)
    # 메시지 연결
    now = time.time()
    talked = set()   # 메시지로 이어진 panel
    last = {}        # 묶음 대표 -> 마지막 메시지 (나중에 대표가 바뀔 수 있어 panel 로 모았다가 옮긴다)
    msgs = []
    for m in messages():
        a, b = m.get("sender_surface_id"), m.get("recipient_surface_id")
        if (a in by_panel and b in by_panel and a != b and m.get("state") != "read"
                and now - (m.get("created_at") or 0) < MSG_WINDOW):
            for x in (a, b):
                info.setdefault(x, {"agent": by_panel[x]["agent"], "slug": ""})
                talked.add(x)
            parent[find(a)] = find(b)
            msgs.append(m)
    for m in msgs:
        root = find(m["sender_surface_id"])
        if root not in last or m["created_at"] > last[root]["at"]:
            body = " ".join(str(m.get("body", "")).split())
            last[root] = {"from": m["sender_surface_id"], "to": m["recipient_surface_id"],
                          "body": body[:120], "state": m.get("state", ""), "at": int(m["created_at"])}
    groups = {}
    for panel in info:
        groups.setdefault(find(panel), []).append(panel)
    out = []
    for root, members in groups.items():
        kinds = {info[m]["agent"] for m in members}
        if len(members) < 2 or not ({"claude", "codex"} <= kinds or talked & set(members)):
            continue
        bases = sorted({re.sub(r"-(claude|codex)$", "", info[m]["slug"]) for m in members if info[m]["slug"]})
        out.append({
            "name": bases[0] if bases else "linked",
            "last": last.get(root),
            "members": [{"panel": m, "agent": info[m]["agent"], "slug": info[m]["slug"]}
                        for m in sorted(members, key=lambda m: (info[m]["slug"] != "", info[m]["agent"]))],
        })
    out.sort(key=lambda g: g["name"])
    return out


def recaps(ss):
    """세션별 최신 요약. Claude Code 가 자리를 비웠을 때 대화 기록에 남기는 away_summary 를 읽는다."""
    import glob
    out = {}
    for x in ss:
        if x["agent"] != "claude" or not x.get("session"):
            continue
        for path in glob.glob(os.path.join(HOME, ".claude/projects/*", x["session"] + ".jsonl")):
            try:
                with open(path, "rb") as f:
                    f.seek(max(0, os.path.getsize(path) - 3_000_000))
                    lines = f.read().decode("utf-8", "ignore").splitlines()
            except OSError:
                continue
            for line in reversed(lines):
                if '"away_summary"' not in line:
                    continue
                try:
                    text = " ".join(str(json.loads(line).get("content", "")).split())
                    text = text.replace("(disable recaps in /config)", "").strip()
                except ValueError:
                    continue
                if text:
                    out[x["panel"].lower()] = text[:300]
                    break
    return out


def tail(path, size=3_000_000):
    """파일 끝 size 바이트의 줄들. 못 읽으면 빈 목록."""
    try:
        with open(path, "rb") as f:
            f.seek(max(0, os.path.getsize(path) - size))
            return f.read().decode("utf-8", "ignore").splitlines()
    except OSError:
        return []


def transcript(x):
    """세션의 대화 기록 파일(Claude: ~/.claude/projects, Codex: ~/.codex/sessions). 없으면 None."""
    import glob
    sid = x.get("session")
    if not sid:
        return None
    pat = (os.path.join(HOME, ".codex/sessions/*/*/*", f"rollout-*{sid}.jsonl") if x.get("agent") == "codex"
           else os.path.join(HOME, ".claude/projects/*", sid + ".jsonl"))
    hits = glob.glob(pat)
    return max(hits, key=os.path.getmtime) if hits else None


def turn_ended(x):
    """Claude 세션의 대화 기록에서 마지막 턴이 끝났는지. cmux 의 working 은 턴이 끝난 뒤에도 묵는다
    (11-22: 한 세션이 턴을 끝낸 2분 뒤부터 4시간 working 으로 보였다. 턴이 끝난 뒤 cmux 의
    Stop 훅 뒤에 도는 것이 상태를 다시 바꾼 것으로 보인다). 끝 = 마지막 user·assistant 줄 뒤에 Claude 가
    쓰는 turn_duration 줄이 있다. 기록이 없거나 못 읽으면 False(cmux 상태를 그대로 쓴다)."""
    path = transcript(x)
    for line in reversed(tail(path, 400_000) if path else []):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("type") == "system" and o.get("subtype") == "turn_duration":
            return True
        if o.get("type") in ("user", "assistant"):
            return False
    return False


def epoch(iso):
    """'2026-11-19T02:01:44.265Z' → epoch 초(소수점 포함: 메시지 읽힌 시각과 같은 초 안의 답을 가른다). 못 읽으면 0."""
    import calendar
    try:
        t = calendar.timegm(time.strptime((iso or "")[:19], "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return 0
    frac = re.match(r"\.(\d+)", (iso or "")[19:])
    return t + (float("0." + frac.group(1)) if frac else 0)


def hhmm(t):
    return time.strftime("%m-%d %H:%M", time.localtime(t)) if t else None


# 데스크·sib 가 세션 입력창에 넣은 글: 사용자 입력이 아니라 데스크가 맡긴 일로 센다.
# desk-message: 는 `brief send` 가 붙인다. 긴 글은 파일 경로 한 줄로 들어가도 머리의 표시가 남는다.
HANDOFF = ("done-request:", "desk-message:", "completion contract (from sib)")
OURS = ("done-request:", "desk-message:", "close-request:")  # 데스크가 입력 칸에 넣는 글의 머리(예전 close-request 포함)
PASTE_TAG = re.compile(r"</?pasted_content[^>]*>")  # 긴 붙여 넣기는 기록에 이 태그로 감싸여 남는다
# '골라'·'선택해' 만으로는 묻는 말이 아니다("제 변경만 골라 커밋했습니다", 11-23 오탐): 부탁하는 꼴일 때만 친다
QUESTION = re.compile(r"[?？]|할까요|주세요|골라\s*줘|선택해\s*줘|고르세요|선택하세요")


def turns(x):
    """대화 기록에서 사실 몇 개: 마지막 사용자 입력, 마지막으로 맡겨진 일(데스크·sib 가 넣은 글),
    마지막 에이전트 활동, 그리고 그 뒤로 입력이 없는 마지막 답이 질문으로 끝났는지.
    시각은 epoch 초(없으면 0)."""
    out = {"input": 0, "handoff": 0, "active": 0, "question": None}
    path = transcript(x)
    if not path:
        return out
    codex = x.get("agent") == "codex"
    last_text = None  # 가장 마지막 에이전트 답의 글 (질문 판정용)
    for line in reversed(tail(path)):
        if codex:
            if '"user"' not in line and '"assistant"' not in line and '"task_started"' not in line:
                continue
        elif '"type":"user"' not in line and '"type":"assistant"' not in line:
            continue
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if codex:
            p = o.get("payload") or {}
            role = p.get("role") if p.get("type") == "message" else ("assistant" if p.get("type") == "task_started" else None)
            body = " ".join(c.get("text", "") for c in p.get("content") or [] if isinstance(c, dict))
            pending_ask = False
        else:
            role = o.get("type")
            c = (o.get("message") or {}).get("content")
            if role == "user" and (o.get("isMeta") or (o.get("origin") or {}).get("kind", "human") != "human"):
                continue
            if isinstance(c, list):
                if any(isinstance(b, dict) and b.get("type") == "tool_result" for b in c):
                    continue  # 도구 결과는 입력이 아니다
                body = " ".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text")
                pending_ask = any(isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") == "AskUserQuestion" for b in c)
            else:
                body, pending_ask = str(c or ""), False
        t = epoch(o.get("timestamp"))
        if role == "assistant":
            if not out["active"]:
                out["active"] = t
            if last_text is None and (body.strip() or pending_ask):
                last_text = "(AskUserQuestion)" if pending_ask and not body.strip() else body
        elif role == "user":
            text = PASTE_TAG.sub("", body).strip()  # sib 브리프처럼 붙여 넣은 글도 입력이다(태그로 시작한다고 빼지 않는다)
            if not text or text.startswith("<") or text.startswith("# AGENTS.md"):
                continue  # 명령·환경 주입
            if any(h in text for h in HANDOFF):
                out["handoff"] = out["handoff"] or t
            elif not out["input"]:
                out["input"] = t
            if last_text is None:
                last_text = ""  # 답보다 입력이 나중이다: 남은 질문 없음
        if out["input"] and out["handoff"] and out["active"] and last_text is not None:
            break
    if last_text:
        tail_lines = [l.strip() for l in last_text.strip().splitlines() if l.strip()][-2:]
        asked = [l for l in tail_lines if QUESTION.search(l)]
        if asked or last_text == "(AskUserQuestion)":
            out["question"] = asked[-1][:160] if asked else last_text
    return out


def git_facts(cwd):
    """cwd 저장소의 미커밋 파일 수와 미push 커밋 수. 저장소가 아니면 빈 dict, upstream 이 없으면 unpushed 없음."""
    d = os.path.expanduser(cwd or "")
    if not d or not os.path.isdir(d):
        return {}
    try:
        r = subprocess.run(["git", "-C", d, "status", "--porcelain"], capture_output=True, text=True, timeout=10)
        if r.returncode:
            return {}
        out = {"uncommitted": len([l for l in r.stdout.splitlines() if l.strip()])}
        r = subprocess.run(["git", "-C", d, "rev-list", "--count", "@{u}..HEAD"], capture_output=True, text=True, timeout=10)
        if r.returncode == 0 and r.stdout.strip().isdigit():
            out["unpushed"] = int(r.stdout.strip())
        return out
    except (OSError, subprocess.TimeoutExpired):
        return {}


def facts(ss, desk=None):
    """세션별 사실 항목(P1). 데스크가 recap·화면을 훑어 추측하지 않고 이 값을 옮긴다.
      input_at     그 pane 에 사용자가 마지막으로 입력한 시각 (데스크·sib 가 넣은 글은 빼고)
      desk_msg_at  데스크가 마지막으로 일을 넘긴 시각 (cmux 메시지, 데스크가 넣은 done-request, sib 브리프)
      started      그 뒤에 세션이 턴을 시작했는지 (메시지가 읽히고 그 뒤에 에이전트 활동이 있음)
      question     마지막 답이 질문으로 끝났고 그 뒤로 사용자 입력이 없으면 그 마지막 줄
      uncommitted  cwd 저장소의 미커밋 파일 수,  unpushed  upstream 에 없는 커밋 수
    반환: {panel(소문자): {...}}"""
    from concurrent.futures import ThreadPoolExecutor
    desk = (desk if desk is not None else desk_panel() or "").lower()
    sent = {}  # panel -> (보낸 시각, 세션에 닿은 시각)
    for m in messages():
        if (m.get("sender_surface_id") or "").lower() != desk or not desk:
            continue
        to = (m.get("recipient_surface_id") or "").lower()
        # 닿은 시각: 읽힌 시각, 없으면 전달된 시각. 멈춘 세션을 깨운 메시지(claude.wake)는 그 턴이 승인 대기 등으로
        # 끝나지 않으면 read_at 이 비어 있어도 이미 턴을 시작시켰다(11-23 Spectacle).
        reached = m.get("read_at") or (m.get("delivered_at") if m.get("state") in ("delivered", "read") else 0) or 0
        if to and (to not in sent or m.get("created_at", 0) > sent[to][0]):
            sent[to] = (m.get("created_at") or 0, reached)
    with ThreadPoolExecutor(8) as pool:
        cwds = sorted({x.get("cwd") or "" for x in ss})
        git = dict(zip(cwds, pool.map(git_facts, cwds)))
        tr = list(pool.map(turns, ss))
    out = {}
    for x, t in zip(ss, tr):
        f = {"input_at": hhmm(t["input"])}
        msg, read = sent.get(x["panel"].lower(), (0, 0))
        if t["handoff"] > msg:  # 입력창에 직접 넣은 글은 넣는 순간 턴이 된다
            msg, read = t["handoff"], t["handoff"]
        if msg:
            f["desk_msg_at"] = hhmm(msg)
            f["started"] = bool(read) and t["active"] > read  # 닿은 뒤에 에이전트 답이 있다
        if t["question"] and x.get("state") != "working":
            f["question"] = t["question"]
        f.update(git.get(x.get("cwd") or "", {}))
        out[x["panel"].lower()] = {k: v for k, v in f.items() if v is not None}
    return out


def load_plan():
    try:
        return json.load(open(PLAN))
    except (OSError, ValueError):
        return {"at": 0, "items": []}


def save_plan(plan):
    os.makedirs(os.path.dirname(PLAN), exist_ok=True)
    json.dump(plan, open(PLAN, "w"), ensure_ascii=False, indent=1)
    render()


def render():
    src = open(TEMPLATE).read()
    if MARK not in src:
        sys.exit("brief: template marker missing in " + TEMPLATE)
    plan = load_plan()
    js = "const PLAN = " + json.dumps(plan, ensure_ascii=False) + ";"
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    if os.path.islink(OUT):
        os.unlink(OUT)
    tmp = OUT + ".tmp"
    if TEAMS_MARK not in src:
        sys.exit("brief: template marker missing in " + TEMPLATE)
    tjs = "const TEAMS = " + json.dumps(teams(), ensure_ascii=False) + ";"
    if RECAPS_MARK not in src:
        sys.exit("brief: template marker missing in " + TEMPLATE)
    rjs = "const RECAPS = " + json.dumps(recaps(sessions()), ensure_ascii=False) + ";"
    open(tmp, "w").write(src.replace(MARK, js).replace(TEAMS_MARK, tjs).replace(RECAPS_MARK, rjs))
    os.replace(tmp, OUT)


def any_pane(panel):
    """cmux 가 에이전트를 모르는 pane(재시작 전부터 떠 있던 세션 등)도 panel id 로 찾는다. 없으면 None."""
    try:
        items = json.loads(cmux("current", "--json", "--limit", "200").stdout)["items"]
    except (ValueError, KeyError):
        return None
    for it in items:
        proj = (it.get("projections") or [{}])[0]
        if (proj.get("panel_id") or "").lower() == panel.lower():
            return {"panel": proj["panel_id"], "workspace": proj.get("workspace_id"), "title": it.get("label", ""),
                    "cwd": (it.get("cwd") or "").replace(HOME, "~"), "agent": None, "state": None, "session": None}
    return None


def resolve(ref, unlisted=False):
    """번호(TODO 목록) 또는 panel id → (panel, workspace, title).
    unlisted: 세션 목록에 없는 pane 도 panel id 로 받는다(`brief send`)."""
    plan = load_plan()
    if ref == "here":
        ref = os.environ.get("CMUX_PANEL_ID") or sys.exit("brief: cmux pane 안이 아닙니다 (CMUX_PANEL_ID 없음)")
    if ref.isdigit():
        i = int(ref) - 1
        if not 0 <= i < len(plan["items"]):
            sys.exit(f"brief: 목록에 {ref}번이 없습니다 (총 {len(plan['items'])}개)")
        ref = plan["items"][i]["panel"]
    ss = sessions()
    for s in ss:
        if s["panel"].lower() == ref.lower():
            return s
    if unlisted and (p := any_pane(ref)):
        return p
    hits = [s for s in ss if ref.lower() in s["title"].lower()]
    if len(hits) == 1:
        return hits[0]
    if hits:
        sys.exit("brief: 여러 세션이 맞습니다. 더 길게 적어 주세요:\n" + "\n".join("  " + s["title"] for s in hits))
    sys.exit("brief: 그 세션의 pane 을 찾지 못했습니다 (닫혔을 수 있음): " + ref)


