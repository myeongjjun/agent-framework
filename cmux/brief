def log_event(what, panel, title, **extra):
    """이벤트 한 줄을 EVENTS 에 남긴다(`brief tree --watch` 가 흐름 줄로 그린다). 실패해도 본래 일은 계속한다."""
    try:
        os.makedirs(os.path.dirname(EVENTS), exist_ok=True)
        if os.path.exists(EVENTS) and os.path.getsize(EVENTS) > 400_000:  # 커지면 최근 절반만 남긴다
            keep = tail(EVENTS, 200_000)[1:]
            with open(EVENTS + ".tmp", "w") as f:
                f.writelines(l + "\n" for l in keep)
            os.replace(EVENTS + ".tmp", EVENTS)
        rec = {"at": time.time(), "what": what, "panel": panel, "title": title}
        rec.update({k: v for k, v in extra.items() if v is not None})
        with open(EVENTS, "a") as f:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError:
        pass


def read_events(since=0):
    out = []
    for l in tail(EVENTS, 200_000):
        try:
            e = json.loads(l)
        except ValueError:
            continue
        if e.get("at", 0) >= since:
            out.append(e)
    return out


def sib_links(ss):
    """sib state 로 누가 누구를 띄웠는지. {worker panel: {"spawner": panel|None, "slug", "collab"}}.
    spawner 가 surface ref 로 남아 있어 cmux 의 surface 목록으로 panel id 로 바꾼다."""
    names, surf = [], []
    try:
        names = sorted(n for n in os.listdir(SIB_STATE) if n.endswith(".env"))
        for w in all_workspaces():
            surf += json.loads(cmux("rpc", "surface.list", json.dumps({"workspace_id": w["id"]})).stdout)["surfaces"]
    except (OSError, ValueError, KeyError):
        pass
    by_low = {s["panel"].lower(): s["panel"] for s in ss}
    ref2panel = {x["ref"]: x["id"] for x in surf if x.get("ref")}
    to_panel = lambda r: ref2panel.get(r) or by_low.get((r or "").lower())
    out = {}
    for name in names:
        try:
            rec = dict(l.strip().split("=", 1) for l in open(os.path.join(SIB_STATE, name)) if "=" in l)
        except OSError:
            continue
        w = to_panel(rec.get("surface", ""))
        if w:
            out[w] = {"spawner": to_panel(rec.get("spawner_surface", "")) or (rec.get("spawner_surface") or None),
                      "slug": rec.get("slug", name[:-4]), "collab": rec.get("worktree_managed") == "1",
                      "ref": rec.get("surface", ""), "spawner_ref": rec.get("spawner_surface", ""),
                      "workdir": rec.get("workdir", "")}
    SURF_REF.update({v.lower(): k for k, v in ref2panel.items()})
    return out


