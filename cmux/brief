def dcut(s, n):
    """화면 폭(한글·이모지는 2칸) n 에 맞춰 자른다."""
    import unicodedata
    w, out = 0, []
    for ch in s:
        cw = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if w + cw > n - 1:
            return "".join(out) + "…"
        w, out = w + cw, out + [ch]
    return s


def fit(line, n):
    """색 코드가 섞인 줄을 화면 폭 n 에 맞춰 자른다(색 코드는 폭 0, 한글·이모지는 2칸). 넘치면 '…' 로 끝내고
    색을 닫는다. (11-24 view-check VC5: '기다림: 사용자의 답: …' 줄이 132~142칸이라 pane 에서 접혀
    트리가 깨졌다. 전문은 --json 과 사무실 창에 그대로 있다.)"""
    import re
    import unicodedata
    parts = re.split(r"(\033\[[0-9;]*m)", line)  # 홀수 자리가 색 코드
    cols = lambda ch: 2 if unicodedata.east_asian_width(ch) in "WF" else 1
    if sum(cols(ch) for t in parts[::2] for ch in t) <= n:
        return line
    out, w = [], 0
    for k, part in enumerate(parts):
        if k % 2:
            out.append(part)
            continue
        for ch in part:
            if w + cols(ch) > n - 1:
                return "".join(out) + "…" + ("\033[0m" if len(parts) > 1 else "")
            w += cols(ch)
            out.append(ch)
    return line


def tree_lines(data, events, now, color=True, width=120, hot=20):
    """트리와 흐름 줄을 글 줄로. hot 초 안에 이벤트가 있었던 세션은 강조하고 그 이벤트를 붙인다."""
    c = (lambda code, s: f"\033[{code}m{s}\033[0m") if color else (lambda code, s: s)
    cut = dcut
    recent = {}
    for e in events:
        for p in (e.get("panel"), e.get("from_panel")):
            if p and now - e["at"] < hot:
                recent[p.lower()] = e
    lines = [c("1", "👤 " + data["user"])]
    d = data["desk"]
    if d:
        lines.append("└─ " + c("1;33", "☀ 데스크") + c("2", f"  {d['title'] or ''} · {d['state'] or '?'}"))
        pre = "   "
    else:
        lines.append("└─ " + c("2", "(데스크 없음: 세션이 사용자에게 바로 보고)"))
        pre = "   "
    WHO = {"user": "1;31", "desk": "1;33", "none": "2"}

    def sess(n, p, last):
        br = "└─ " if last else "├─ "
        e = recent.get(n["panel"].lower())
        icon = STATE.get(n["state"], "·")
        title = cut(n.get("name") or n["title"] or n["panel"][:8], 38)
        head = f"{icon} {title}"
        head = c("1;7", head) if e else (c("1", head) if n["state"] == "working" else head)
        tag = c("1;35", f"  {ICON.get(e['what'], '•')} {LABEL.get(e['what'], e['what'])}") if e else ""
        lines.append(p + br + head + c("2", f"  [{n['agent']}]") + tag)
        sub = p + ("   " if last else "│  ")
        w = n["waiting"]
        info = c("36", "띄움: " + n["spawned_by"]["label"]) + "   " + c(WHO.get(w["who"], "2"), "기다림: " + w["label"])
        lines.append(sub + "   " + info)
        for i, ch in enumerate(n["children"]):
            sess(ch, sub, i == len(n["children"]) - 1)

    for i, a in enumerate(data["areas"]):
        last = i == len(data["areas"]) - 1
        mark = {"ask": "🛑", "profile": "🗂", "meeting": "🏛", "none": "…"}.get(a["kind"], "")
        name = a["name"] + (f" — {a['topic']}" if a.get("topic") else "")  # 위원회 회의는 무슨 회의인지
        lines.append(pre + ("└─ " if last else "├─ ") + c("1;34", f"{mark} {name}") + c("2", f"  · {a['decides']}"))
        p = pre + ("   " if last else "│  ")
        if not a["sessions"]:
            lines.append(p + c("2", "└─ (열린 세션 없음)"))
        for j, n in enumerate(a["sessions"]):
            sess(n, p, j == len(a["sessions"]) - 1)
    return [fit(l, width) for l in lines]


def event_lines(events, now, color=True, n=12, width=120):
    c = (lambda code, s: f"\033[{code}m{s}\033[0m") if color else (lambda code, s: s)
    out = [c("1", "── 실시간 이벤트 " + "─" * 20)]
    if not events:
        out.append(c("2", "  (아직 없음)"))
    for e in sorted(events, key=lambda e: e["at"], reverse=True)[:n]:
        age = now - e["at"]
        t = time.strftime("%H:%M:%S", time.localtime(e["at"]))
        body = f"{ICON.get(e['what'], '•')} {LABEL.get(e['what'], e['what'])}  {e.get('title') or ''}"
        extra = e.get("text") or e.get("note") or ""
        if e["what"] == "closed":
            extra = "대조 후 닫음" if e.get("verified") else ("검토 없이 닫힘" if "verified" in e or "check" in e else "")
        line = f"  {t}  {body}" + (f"  — {extra}" if extra else "")
        line = dcut(line, width)
        out.append(c("1;33", line) if age < 10 else (line if age < 120 else c("2", line)))
    return out


