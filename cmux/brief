def desk_view(ss=None, force=False):
    """데스크 워크스페이스 왼쪽에 오늘 데스크 문서를 서식 있는 뷰어로 띄운다(파일이 바뀌면 저절로 갱신).
    자동으로는 띄우지 않는다: 기본 화면은 넓은 orch pane + 오른쪽 Desk 패널이고, 원할 때 `brief view` 로 연다."""
    desk = (desk_panel() or "").lower()
    me = next((x for x in (ss or sessions()) if x["panel"].lower() == desk), None)
    docs = sorted(f for f in os.listdir(os.path.join(DESK_DIR, "Desk")) if re.fullmatch(r"\d+\.md", f)) \
        if os.path.isdir(os.path.join(DESK_DIR, "Desk")) else []
    if not me or not docs:
        return "데스크나 데스크 문서가 없습니다"
    try:
        seen = json.load(open(VIEW))
    except (OSError, ValueError):
        seen = {}
    if seen.get("workspace") == me["workspace"] and seen.get("doc") == docs[-1] and not force:
        return None
    r = cmux("markdown", "open", os.path.join(DESK_DIR, "Desk", docs[-1]), "--workspace", me["workspace"],
             "--surface", me["panel"], "--direction", "left", "--focus", "false")
    if r.returncode != 0:
        return (r.stderr or r.stdout).strip()
    json.dump({"workspace": me["workspace"], "doc": docs[-1]}, open(VIEW, "w"))
    open(NO_MAX, "w").write(me["workspace"] + "\n")  # 포커스한 pane 을 키우는 자동화가 뷰어를 밀어내지 않게 한다
    return "데스크 문서를 왼쪽에 열었습니다: Desk/" + docs[-1]


LESSONS = os.path.join(HOME, ".config/cmux/orch-lessons.md")
