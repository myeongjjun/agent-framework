#!/usr/bin/env bash
# cmux stub for sib bats tests.
#
# Records every invocation (one line per call) to $CMUX_STUB_LOG and returns
# canned output matching the real cmux CLI's shape, so sib's parsing logic is
# exercised without a live cmux. Behaviour is overridable per-subcommand via
# env vars (see below) to simulate failures.
set -euo pipefail

log="${CMUX_STUB_LOG:-/dev/null}"
echo "cmux $*" >> "$log"

sub="${1:-}"; shift || true

case "$sub" in
  new-pane)
    # real: "OK surface:N workspace:M" (varies); sib greps surface:
    echo "OK ${CMUX_STUB_SURFACE:-surface:90} ${CMUX_STUB_WS:-workspace:99}"
    ;;
  new-split)
    # real: "OK surface:N workspace:M"
    echo "OK ${CMUX_STUB_SURFACE:-surface:91} ${CMUX_STUB_WS:-workspace:7}"
    ;;
  workspace)
    # `workspace list` — nothing open in the stub (kill's post-close check);
    # `workspace create` prints "OK workspace:N" like new-workspace.
    [[ "${1:-}" == list ]] && exit 0
    echo "OK ${CMUX_STUB_WS:-workspace:42}"
    ;;
  new-workspace)
    # `workspace create` and legacy `new-workspace` both print "OK workspace:N"
    echo "OK ${CMUX_STUB_WS:-workspace:42}"
    ;;
  list-pane-surfaces)
    echo "* ${CMUX_STUB_SURFACE:-surface:92}  sib-test  [selected]"
    ;;
  sidebar-state)
    # emit a cwd= line so workspace_cwd() can adopt the target workspace's dir
    echo "tab=STUBTAB"
    echo "cwd=${CMUX_STUB_WS_CWD:-/stub/workspace/cwd}"
    echo "focused_cwd=${CMUX_STUB_WS_CWD:-/stub/workspace/cwd}"
    ;;
  close-surface|close-workspace)
    # Real cmux: `--force` is a bare flag; a value after it ("--force true")
    # is an unexpected argument and the close fails.
    prev=""; for a in "$@"; do
      [[ "${prev}" == --force && "${a}" != --* ]] && { echo "Error: ${sub}: unexpected argument ${a}" >&2; exit 2; }
      prev="${a}"
    done
    # CMUX_STUB_CLOSE_LIVE=1 simulates a live process: only a forced close works.
    [[ "${CMUX_STUB_CLOSE_LIVE:-0}" == 1 && " $* " != *" --force "* ]] \
      && { echo "Error: confirmation_required" >&2; exit 1; }
    [[ "${sub}" == close-workspace ]] && exit 0
    # CMUX_STUB_CLOSE_FAIL=1 simulates cmux refusing the close. Otherwise
    # record the surface as gone so a later read-screen on it fails, the
    # way sib kill's post-close check sees a really closed pane.
    [[ "${CMUX_STUB_CLOSE_FAIL:-0}" == 1 ]] && exit 1
    while (($#)); do [[ "$1" == --surface ]] && { touch "${log}.closed-$2"; break; }; shift; done
    ;;
  send|send-key)
    # no stdout needed; the log line above is the assertion target. Count
    # sends and enters so read-screen can change what the pane shows after
    # them (CMUX_STUB_SCREEN_AFTER_SENDS / _AFTER_ENTERS below).
    [[ "$sub" == send ]] && echo x >> "${log}.sends"
    [[ "$sub" == send-key && " $* " == *" enter "* ]] && echo x >> "${log}.enters"
    :
    ;;
  read-screen)
    for a in "$@"; do [[ -e "${log}.closed-${a}" ]] && exit 1; done
    # Boot-wait loop looks for the ready marker at line start (+ claude's rule
    # line). The prompt-submit logic then looks for (a) the prompt text (head
    # and tail) + absence of "tab to queue message", and
    # (b) a work signal ("working") after enter. Emit a screen that satisfies
    # all three by default. Override via CMUX_STUB_SCREEN to simulate states
    # (e.g. a queued codex pane).
    # Staged screens: after N enters show CMUX_STUB_SCREEN3, else after N
    # sends show CMUX_STUB_SCREEN2 (e.g. the text appears only once typed).
    sends=$( (cat "${log}.sends" 2>/dev/null || true) | wc -l | tr -d ' ')
    enters=$( (cat "${log}.enters" 2>/dev/null || true) | wc -l | tr -d ' ')
    if [[ -n "${CMUX_STUB_SCREEN_AFTER_ENTERS:-}" ]] && (( enters >= CMUX_STUB_SCREEN_AFTER_ENTERS )); then
      printf '%s\n' "${CMUX_STUB_SCREEN3}"
    elif [[ -n "${CMUX_STUB_SCREEN_AFTER_SENDS:-}" ]] && (( sends >= CMUX_STUB_SCREEN_AFTER_SENDS )); then
      printf '%s\n' "${CMUX_STUB_SCREEN2}"
    elif [[ -n "${CMUX_STUB_SCREEN:-}" ]]; then
      printf '%s\n' "${CMUX_STUB_SCREEN}"
    else
      printf '%s\n' "${CMUX_STUB_READY:-❯}"
      printf '──────────────────────\n'   # claude's input-box rule line
      printf '%s\n' "${CMUX_STUB_PROMPT_ECHO:-the task prompt}"
      printf 'working (esc to interrupt)\n'
    fi
    ;;
  *)
    : # tolerate anything else silently
    ;;
esac
