#!/usr/bin/env bash
# cmux stub for sib bats tests.
#
# Records every invocation (one line per call) to $CMUX_STUB_LOG and returns
# canned output matching the real cmux CLI's shape, so sib's parsing logic is
# exercised without a live cmux. Behaviour is overridable per-subcommand via
# env vars (see below) to simulate failures.
set -euo pipefail

log="${CMUX_STUB_LOG:-/dev/null}"
echo "cmux $*" >> "$log"

sub="${1:-}"; shift || true

case "$sub" in
  new-pane)
    # real: "OK surface:N workspace:M" (varies); sib greps surface:
    echo "OK ${CMUX_STUB_SURFACE:-surface:90} ${CMUX_STUB_WS:-workspace:99}"
    ;;
  new-split)
    # real: "OK surface:N workspace:M"
    echo "OK ${CMUX_STUB_SURFACE:-surface:91} ${CMUX_STUB_WS:-workspace:7}"
    ;;
  new-workspace|workspace)
    # `workspace create` and legacy `new-workspace` both print "OK workspace:N"
    echo "OK ${CMUX_STUB_WS:-workspace:42}"
    ;;
  list-pane-surfaces)
    echo "* ${CMUX_STUB_SURFACE:-surface:92}  sib-test  [selected]"
    ;;
  sidebar-state)
    # emit a cwd= line so workspace_cwd() can adopt the target workspace's dir
    echo "tab=STUBTAB"
    echo "cwd=${CMUX_STUB_WS_CWD:-/stub/workspace/cwd}"
    echo "focused_cwd=${CMUX_STUB_WS_CWD:-/stub/workspace/cwd}"
    ;;
  send|send-key|close-surface|close-workspace)
    : # no stdout needed; the log line above is the assertion target
    ;;
  read-screen)
    # Boot-wait loop looks for the ready marker. The prompt-submit logic then
    # looks for (a) the prompt text + absence of "tab to queue message", and
    # (b) a work signal ("working") after enter. Emit a screen that satisfies
    # all three by default. Override via CMUX_STUB_SCREEN to simulate states
    # (e.g. a queued codex pane).
    if [[ -n "${CMUX_STUB_SCREEN:-}" ]]; then
      printf '%s\n' "${CMUX_STUB_SCREEN}"
    else
      printf '%s\n' "${CMUX_STUB_READY:-❯}"
      printf '%s\n' "${CMUX_STUB_PROMPT_ECHO:-the task prompt}"
      printf 'working (esc to interrupt)\n'
    fi
    ;;
  *)
    : # tolerate anything else silently
    ;;
esac
