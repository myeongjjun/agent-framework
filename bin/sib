#!/usr/bin/env bash
# sib — spawn & manage interactive sibling agent sessions WITHOUT the orchestrator.
#
# Thin wrapper over cmux (panes); git worktree is opt-in (`--worktree`).
# The agent runs directly in a cmux pane (closing the pane ends it). Run from
# inside a cmux pane (uses $CMUX_WORKSPACE_ID).
#
# By default, the sibling runs in the *same* working directory as the caller —
# a single agent moving to a fresh pane to keep the parent session free. Opt
# into `--worktree` when two siblings must edit in parallel (e.g. /collab's
# dual-agent same-task pattern) so their changes do not collide.
#
# Placement: by default the sibling splits the caller's current workspace.
# Use `--workdir <path>` to start it in a different directory, `--workspace
# <id|ref>` to split a specific (already-open) workspace, or `--new-workspace`
# to create a dedicated workspace rooted at the chosen workdir. These let a
# caller put work where it belongs instead of dumping every sibling into the
# base session's pane (see /dispatch workspace targeting).
#
# Subcommands:
#   sib spawn <slug> [--codex] [--yolo] [--base <branch>] [--worktree]
#             [--workdir <path>] [--workspace <id|ref> | --new-workspace]
#             [--takeover] [-- <prompt...>]
#   sib list
#   sib send <slug> <text...>
#   sib kill <slug> [--keep-worktree]
#
# Talk to a sibling by focusing its cmux pane and typing, or `sib send <slug> "..."`.
# Trade-off vs zmx: no detached persistence — the agent lives only while its pane is open.
set -euo pipefail
# Normalise PATH so cmux/git resolve regardless of the caller's login shell.
# SIB_EXTRA_PATH is prepended first: a seam for injecting an alternate
# toolchain (and for tests that stub cmux/git). Empty by default.
export PATH="${SIB_EXTRA_PATH:+${SIB_EXTRA_PATH}:}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sib"
WT_ROOT="${STATE_DIR}/worktrees"
mkdir -p "${STATE_DIR}/state" "${WT_ROOT}"

die() { echo "sib: $*" >&2; exit 1; }
need_cmux() { [[ -n "${CMUX_WORKSPACE_ID:-}" ]] || die "not inside a cmux pane (CMUX_WORKSPACE_ID unset)"; }
surface_alive() { cmux read-screen --surface "$1" --workspace "$2" --lines 1 >/dev/null 2>&1; }
# Working directory of a cmux workspace (its `cwd=` from sidebar-state). cmux
# tree omits cwd; sidebar-state is the supported source. Empty if unknown.
workspace_cwd() { cmux sidebar-state --workspace "$1" 2>/dev/null | sed -n 's/^cwd=//p' | head -1; }

cmd="${1:-}"; shift || true

case "${cmd}" in
spawn)
  slug="${1:?sib spawn <slug> ...}"; shift
  [[ "${slug}" =~ ^[a-z0-9-]+$ ]] || die "slug must be lowercase-kebab"
  need_cmux
  # Default: normal permission gates (interactive sibling you supervise in the pane).
  # --yolo opts into autonomous mode (skip gates) — only for unattended work.
  agent="claude"; yolo=0
  base="HEAD"; do_worktree=0; takeover=0; prompt=""
  workdir=""; target_ws=""; new_ws=0
  while (($#)); do case "$1" in
    --codex)            agent="codex" ;;
    --yolo)             yolo=1 ;;
    --base)             shift; base="${1:?--base needs branch}" ;;
    --worktree)         do_worktree=1 ;;
    --workdir|--cwd)    shift; workdir="${1:?--workdir needs a path}" ;;
    --workspace)        shift; target_ws="${1:?--workspace needs an id|ref}" ;;
    --new-workspace)    new_ws=1 ;;
    --takeover)         takeover=1 ;;
    --)                 shift; prompt="$*"; break ;;
    *)                  die "unknown spawn arg: $1" ;;
  esac; shift || true; done
  [[ -n "${target_ws}" ]] && (( new_ws )) && die "--workspace and --new-workspace are mutually exclusive"
  if [[ "${agent}" == "codex" ]]; then
    agent_cmd="codex"; (( yolo )) && agent_cmd="codex --dangerously-bypass-approvals-and-sandbox"
    ready_marker="›"
  else
    agent_cmd="claude"; (( yolo )) && agent_cmd="claude --dangerously-skip-permissions"
    ready_marker="❯"
  fi

  [[ -f "${STATE_DIR}/state/${slug}.env" ]] && die "sib '${slug}' already exists (sib kill ${slug} first)"

  # Resolve the sibling's start directory.
  # Precedence: --worktree (managed checkout) wins over --workdir, which wins
  # over the caller's PWD. --worktree implies a git-managed path, so combining
  # it with --workdir is contradictory.
  if (( do_worktree )) && [[ -n "${workdir}" ]]; then
    die "--worktree manages its own path; do not combine with --workdir"
  fi
  # Default start dir: caller's PWD. An explicit --workdir wins. Failing that,
  # targeting an existing workspace (--workspace W) means "run where W lives" —
  # adopt W's cwd so the pane and the agent's directory agree. (Without this,
  # the pane lands in W but the agent starts in the caller's PWD.)
  start_dir="${PWD}"
  if [[ -n "${workdir}" ]]; then
    start_dir="${workdir}"
  elif [[ -n "${target_ws}" ]] && (( ! do_worktree )); then
    ws_cwd="$(workspace_cwd "${target_ws}")"
    [[ -n "${ws_cwd}" ]] && start_dir="${ws_cwd}"
  fi
  if (( do_worktree )); then
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not in a git repo (--worktree requires one)"
    repo="$(basename "$(git rev-parse --show-toplevel)")"
    wt="${WT_ROOT}/${repo}-${slug}"
    [[ -e "${wt}" ]] && die "worktree exists: ${wt}"
    git worktree add -b "sib/${slug}" "${wt}" "${base}" >/dev/null
    start_dir="${wt}"
  fi
  [[ -d "${start_dir}" ]] || die "start dir does not exist: ${start_dir}"

  # Place the sibling pane. Three modes:
  #   default        — split the caller's current workspace (legacy behaviour)
  #   --workspace W  — split an already-open workspace W
  #   --new-workspace— create a dedicated workspace rooted at start_dir
  if (( new_ws )); then
    # cmux new-workspace --cwd boots a shell in start_dir; we then grab its
    # surface so the agent launch + later `sib send`/`kill` can target it.
    wsout="$(cmux new-workspace --name "sib-${slug}" --cwd "${start_dir}" --focus false 2>&1)"
    ws="$(grep -oE 'workspace:[^[:space:]]+' <<<"${wsout}" | head -1)"
    [[ -n "${ws}" ]] || { echo "${wsout}" >&2; die "failed to create workspace"; }
    surface="$(cmux list-pane-surfaces --workspace "${ws}" 2>/dev/null | grep -oE 'surface:[^[:space:]]+' | head -1)"
    [[ -n "${surface}" ]] || die "created workspace ${ws} but found no surface"
  elif [[ -n "${target_ws}" ]]; then
    ws="${target_ws}"
    out="$(cmux new-split right --workspace "${ws}" --focus false 2>&1)"
    surface="$(grep -oE 'surface:[^[:space:]]+' <<<"${out}" | head -1)"
    [[ -n "${surface}" ]] || { echo "${out}" >&2; die "failed to split workspace ${ws}"; }
  else
    ws="${CMUX_WORKSPACE_ID}"
    out="$(cmux new-pane --type terminal --direction right --workspace "${ws}")"
    surface="$(grep -oE 'surface:[^[:space:]]+' <<<"${out}" | head -1)"
    [[ -n "${surface}" ]] || { echo "${out}" >&2; die "failed to create pane"; }
  fi

  # Launch the agent directly in the new pane (exec → closing pane ends it; no zmx).
  cmux send --surface "${surface}" --workspace "${ws}" "cd $(printf %q "${start_dir}") && exec ${agent_cmd}"
  cmux send-key --surface "${surface}" --workspace "${ws}" enter

  # Persist state. `worktree=` keeps its historical name (it is the sibling's
  # start dir whether or not a worktree was created); `worktree_managed`
  # records whether sib owns a git worktree to clean up on kill. `workdir=`
  # records the resolved start dir explicitly for newer consumers.
  { echo "slug=${slug}"; echo "agent=${agent}";
    echo "surface=${surface}"; echo "workspace=${ws}"; echo "worktree=${start_dir}";
    echo "workdir=${start_dir}"; echo "worktree_managed=${do_worktree}";
    echo "workspace_managed=${new_ws}"; } > "${STATE_DIR}/state/${slug}.env"

  # Wait for the agent's input prompt to appear. The marker (❯/›) means the
  # input box is *drawn* — not that input is accepted yet. See cmux-cli-
  # reference §9 for the full trap analysis.
  booted=0
  for i in $(seq 1 50); do
    if cmux read-screen --surface "${surface}" --workspace "${ws}" --lines 60 2>/dev/null | grep -qF "${ready_marker}"; then
      booted=1; break
    fi
    # Adaptive poll: fast (~1s total) at first so a quick boot is caught almost
    # immediately, then back off to 0.5s (≈20s ceiling) for a slow cold start.
    if (( i <= 10 )); then sleep 0.1; else sleep 0.5; fi
  done
  (( takeover )) && prompt="/takeover"
  if [[ -n "${prompt}" ]]; then
    (( booted )) || sleep 3
    # Put the prompt in the input box first (no enter yet).
    cmux send --surface "${surface}" --workspace "${ws}" "${prompt}"
    # Confirm the text landed, then submit. Two traps this guards against:
    #   1) wrap (claude + codex) — a narrow split pane soft-wraps the input, so
    #      the first 24 chars can straddle a line break and `grep -F` never
    #      matches them on one line. The loop then spins to its 30s cap before
    #      submitting (measured: a 27-char codex prompt took 42s). Fix: strip
    #      spaces+newlines from BOTH the screen and the needle so the match is
    #      wrap-immune while keeping 24-char specificity (low false-match risk).
    #   2) codex queue — codex queues input while MCP servers load
    #      ("tab to queue message"); an enter sent then is swallowed. Only the
    #      codex branch waits the notice out (regression-critical); claude has
    #      no input queue, so it submits as soon as the text is visible.
    needle="$(printf '%s' "${prompt:0:24}" | tr -d ' \n')"
    for i in $(seq 1 60); do
      scr="$(cmux read-screen --surface "${surface}" --workspace "${ws}" --lines 40 2>/dev/null || true)"
      scr_ns="$(printf '%s' "${scr}" | tr -d ' \n')"
      if grep -qF "${needle}" <<<"${scr_ns}"; then
        if [[ "${agent}" == "codex" ]]; then
          grep -qF "tab to queue message" <<<"${scr}" || break
        else
          break
        fi
      fi
      # Adaptive poll: fast (~1s total) at first to catch a quick render, then
      # back off to 0.5s so a slow boot still resolves without busy-looping.
      if (( i <= 10 )); then sleep 0.1; else sleep 0.5; fi
    done
    cmux send-key --surface "${surface}" --workspace "${ws}" enter
    # Confirm submission; if no work signal appeared (queue cleared a beat
    # late, autocomplete ate the first enter), send one more enter.
    sleep 1
    if ! cmux read-screen --surface "${surface}" --workspace "${ws}" --lines 20 2>/dev/null \
         | grep -qiE 'working|esc to interrupt'; then
      cmux send-key --surface "${surface}" --workspace "${ws}" enter
    fi
  fi

  echo "✓ sib '${slug}' (${agent}) → ${ws} ${surface} $([[ ${booted} == 1 ]] && echo '[booted]' || echo '[booting…]')"
  echo "  workdir: ${start_dir}$( (( new_ws )) && echo '  (dedicated workspace)'; (( do_worktree )) && echo '  (worktree)')"
  echo "  talk: focus the pane, or  sib send ${slug} \"...\""
  ;;

list)
  shopt -s nullglob
  printf '%-16s %-8s %-12s %s\n' SLUG AGENT SURFACE WORKTREE
  for f in "${STATE_DIR}"/state/*.env; do
    # shellcheck source=/dev/null  # runtime state file; fields set by spawn
    # shellcheck disable=SC2154    # slug/agent/surface/workspace/worktree come from the sourced file
    ( . "$f"; st=$(surface_alive "${surface}" "${workspace}" && echo up || echo dead)
      printf '%-16s %-8s %-12s %s (%s)\n' "$slug" "$agent" "$surface" "$worktree" "$st" )
  done
  ;;

send)
  slug="${1:?sib send <slug> <text>}"; shift
  f="${STATE_DIR}/state/${slug}.env"; [[ -f "$f" ]] || die "no such sib: ${slug}"
  # shellcheck source=/dev/null  # runtime state file; fields set by spawn
  . "$f"
  surface_alive "${surface}" "${workspace}" || die "sib '${slug}' pane is gone (sib kill ${slug} to clean up)"
  cmux send --surface "${surface}" --workspace "${workspace}" "$*"
  cmux send-key --surface "${surface}" --workspace "${workspace}" enter
  echo "→ sent to ${slug}"
  ;;

kill)
  slug="${1:?sib kill <slug>}"; shift
  keep_wt=0; [[ "${1:-}" == "--keep-worktree" ]] && keep_wt=1
  f="${STATE_DIR}/state/${slug}.env"; [[ -f "$f" ]] || die "no such sib: ${slug}"
  workspace_managed=0  # default for state files written before this field existed
  # shellcheck source=/dev/null  # runtime state file; fields set by spawn
  . "$f"
  # End the agent by tearing down its surface. A sib-created dedicated
  # workspace holds only this one surface, and cmux refuses to close the last
  # surface — close the whole workspace instead. Otherwise just close the pane.
  if (( workspace_managed )); then
    cmux close-workspace --workspace "${workspace}" 2>/dev/null || true
  else
    cmux close-surface --surface "${surface}" --workspace "${workspace}" 2>/dev/null || true
  fi
  # shellcheck disable=SC2154  # worktree_managed/worktree set by the sourced state file
  if (( worktree_managed )) && (( ! keep_wt )); then
    git worktree remove --force "${worktree}" 2>/dev/null || true
    git branch -D "sib/${slug}" 2>/dev/null || true
  fi
  rm -f "$f"
  echo "✓ killed ${slug}"
  ;;

*)
  sed -n '2,18p' "$0" >&2; exit 1 ;;
esac
