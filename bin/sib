#!/usr/bin/env bash
# sib — spawn & manage interactive sibling agent sessions WITHOUT the orchestrator.
#
# Thin wrapper over cmux (panes); git worktree is opt-in (`--worktree`).
# The agent runs directly in a cmux pane (closing the pane ends it). Run from
# inside a cmux pane (uses $CMUX_WORKSPACE_ID).
#
# By default, the sibling runs in the *same* working directory as the caller —
# a single agent moving to a fresh pane to keep the parent session free. Opt
# into `--worktree` when two siblings must edit in parallel (e.g. /collab's
# dual-agent same-task pattern) so their changes do not collide.
#
# Placement: by default the sibling splits the caller's current workspace.
# Use `--workdir <path>` to start it in a different directory, `--workspace
# <id|ref>` to split a specific (already-open) workspace, or `--new-workspace`
# to create a dedicated workspace rooted at the chosen workdir. These let a
# caller put work where it belongs instead of dumping every sibling into the
# base session's pane (see /dispatch workspace targeting).
#
# Subcommands:
#   sib spawn <slug> [--codex] [--model <m>] [--yolo] [--base <branch>] [--worktree]
#             [--workdir <path>] [--workspace <id|ref> | --new-workspace]
#             [--no-report] [-- <prompt...>]
#   sib list          (also prunes state of panes that are gone)
#   sib send <slug> [--queue] <text...>
#   sib kill <slug> [--keep-worktree]
#
# Talk to a sibling by focusing its cmux pane and typing, or `sib send <slug> "..."`.
# Trade-off vs zmx: no detached persistence — the agent lives only while its pane is open.
set -euo pipefail
# Normalise PATH so cmux/git resolve regardless of the caller's login shell.
# SIB_EXTRA_PATH is prepended first: a seam for injecting an alternate
# toolchain (and for tests that stub cmux/git). Empty by default.
export PATH="${SIB_EXTRA_PATH:+${SIB_EXTRA_PATH}:}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/sib"
WT_ROOT="${STATE_DIR}/worktrees"
mkdir -p "${STATE_DIR}/state" "${WT_ROOT}"

die() { echo "sib: $*" >&2; exit 1; }
# First `<kind>:<ref>` token (workspace:N, surface:N) in stdin; empty, never a
# failure, when there is none. A bare `x="$(... | grep | head -1)"` under
# `set -euo pipefail` ended the script with exit 1 and no output when grep
# found nothing (11-24: the silent "sib spawn failed (exit 1, no output)").
first_ref() { { grep -oE "$1:[^[:space:]]+" || true; } | head -1; }

# The one deliverer of text to an agent pane: /pane-msg's pane-deliver.sh
# (docs/agent-control-one-path.md §5 step 3). sib, `brief send` and /pane-msg
# all use it. The repo copy next to this script wins over the installed one.
deliverer() {
  local src="$0" l d
  while [[ -L "${src}" ]]; do
    l="$(readlink "${src}")"; [[ "${l}" == /* ]] && src="${l}" || src="$(dirname "${src}")/${l}"
  done
  for d in "$(dirname "${src}")/../skills/pane-msg/scripts" "${HOME}/.claude/skills/pane-msg/scripts"; do
    [[ -x "${d}/pane-deliver.sh" ]] && { echo "${d}/pane-deliver.sh"; return 0; }
  done
  return 1
}
need_cmux() { [[ -n "${CMUX_WORKSPACE_ID:-}" ]] || die "not inside a cmux pane (CMUX_WORKSPACE_ID unset)"; }
surface_alive() { cmux read-screen --surface "$1" --workspace "$2" --lines 1 >/dev/null 2>&1; }
# Working directory of a cmux workspace (its `cwd=` from sidebar-state). cmux
# tree omits cwd; sidebar-state is the supported source. Empty if unknown.
workspace_cwd() {
  local o; o="$(cmux sidebar-state --workspace "$1" 2>/dev/null)" || return 0
  { sed -n 's/^cwd=//p' | head -1; } <<<"${o}" || true
}

# Drop the state file of a sibling whose pane is gone (closed by `brief done`,
# by hand, or by a cmux restart) — otherwise state/ only ever grows and a dead
# slug blocks re-spawning under the same name. A sib-managed worktree is never
# removed here: that state is kept so `sib kill <slug>` can clean it up.
# Prints "pruned" / "kept-worktree" / nothing (alive or cmux unreachable).
prune_if_dead() {
  local f="$1" surface workspace worktree_managed
  # `sib list` passes "grace": a state file written in the last minute belongs
  # to a spawn that may still be bringing its pane up — leave it alone.
  [[ "${2:-}" == grace && -n "$(find "$f" -mmin -1 2>/dev/null)" ]] && return 0
  # Read only the fields needed: spawn calls this mid-setup, so loading the
  # whole file would overwrite its own slug/agent.
  surface="$(state_get "$f" surface)"; workspace="$(state_get "$f" workspace)"
  worktree_managed="$(state_get "$f" worktree_managed)"; : "${worktree_managed:=0}"
  surface_alive "${surface}" "${workspace}" && return 0
  # Only trust "dead" when cmux itself answers — a broken socket must not
  # wipe the state of live siblings.
  cmux workspace list >/dev/null 2>&1 || return 0
  if (( worktree_managed )); then echo kept-worktree; else rm -f "$f"; echo pruned; fi
}

# Pre-trust allowlisted start dirs so a claude sibling does not stop at Claude
# Code's "trust this folder" dialog (nobody is at a desk-spawned pane to answer
# it). The allowlist is user-owned: one pattern per line in $SIB_TRUST_FILE,
# '~/' expands to $HOME, '#' starts a comment, '*' matches within ONE path
# segment (so '~/dev/*' covers ~/dev/x but not ~/dev/x/y). Only dirs under
# $HOME are eligible. Anything not listed keeps the dialog — sib then reports
# it instead of claiming the session is ready.
SIB_TRUST_FILE="${SIB_TRUST_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sib/trusted-dirs}"
# Echoes: "already" | "added" | nothing (not eligible / could not write).
trust_allowlisted() {
  local dir="$1" line pat hit=0 cfg tmp home
  # $dir is physical (pwd -P); compare it with the physical $HOME too, or a
  # HOME under a symlink (macOS /var → /private/var) never matches.
  home="$(cd "${HOME}" 2>/dev/null && pwd -P)" || return 0
  [[ -f "${SIB_TRUST_FILE}" && "${dir}" == "${home}"/* ]] || return 0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
    [[ -n "${line}" ]] || continue
    [[ "${line}" == \~/* ]] && line="${home}/${line#\~/}"
    pat="${line%/}"
    # Same depth first, so '*' cannot swallow a '/'.
    local ds="${dir//[^\/]/}" ps="${pat//[^\/]/}"
    # shellcheck disable=SC2053  # $pat is intentionally a glob
    if [[ ${#ds} -eq ${#ps} && "${dir}" == ${pat} ]]; then hit=1; break; fi
  done < "${SIB_TRUST_FILE}"
  (( hit )) || return 0
  command -v jq >/dev/null 2>&1 || return 0
  cfg="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"
  [[ -f "${cfg}" ]] || return 0
  if jq -e --arg d "${dir}" '.projects[$d].hasTrustDialogAccepted == true' "${cfg}" >/dev/null 2>&1; then
    echo already; return 0
  fi
  tmp="$(mktemp "${cfg}.sib.XXXXXX")" || return 0
  if jq --arg d "${dir}" \
       '.projects[$d] = ((.projects[$d] // {}) + {hasTrustDialogAccepted: true})' \
       "${cfg}" > "${tmp}" 2>/dev/null && [[ -s "${tmp}" ]]; then
    chmod 600 "${tmp}" && mv -f "${tmp}" "${cfg}" && echo added && return 0
  fi
  rm -f "${tmp}"
}

# State files are plain `key=value` lines with RAW values (a workdir may
# contain spaces). Read them field by field — never `source` them, which
# word-splits an unquoted path into a command.
state_get() { { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; } || true; }
load_state() {
  slug="$(state_get "$1" slug)"; agent="$(state_get "$1" agent)"
  surface="$(state_get "$1" surface)"; workspace="$(state_get "$1" workspace)"
  worktree="$(state_get "$1" worktree)"
  worktree_managed="$(state_get "$1" worktree_managed)"
  workspace_managed="$(state_get "$1" workspace_managed)"
  # defaults for state files written before these fields existed
  : "${worktree_managed:=0}" "${workspace_managed:=0}"
}
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d'; }

cmd="${1:-}"; shift || true
# Help anywhere in front of a slug: `sib --help`, `sib spawn --help`, ...
# (a slug of `--help` used to pass the kebab check and spawn a session).
case "${cmd}" in -h|--help|help) usage; exit 0 ;; esac
case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# Last line of defence: no failure path may end sib without a reason on
# stderr. Expected failures call die (with a message); this catches the rest.
trap 'echo "sib: ${cmd:-?}: unexpected failure (exit $?) at line ${LINENO}: ${BASH_COMMAND}" >&2' ERR

case "${cmd}" in
spawn)
  slug="${1:?sib spawn <slug> ...}"; shift
  [[ "${slug}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "slug must be lowercase-kebab (and not start with '-'): ${slug}"
  need_cmux
  # Default: normal permission gates (interactive sibling you supervise in the pane).
  # --yolo opts into autonomous mode (skip gates) — only for unattended work.
  agent="claude"; yolo=0
  base="HEAD"; do_worktree=0; prompt=""
  workdir=""; target_ws=""; new_ws=0; report=1; model=""
  while (($#)); do case "$1" in
    --codex)            agent="codex" ;;
    --model)            shift; model="${1:?--model needs a model name}" ;;
    --yolo)             yolo=1 ;;
    --base)             shift; base="${1:?--base needs branch}" ;;
    --worktree)         do_worktree=1 ;;
    --workdir|--cwd)    shift; workdir="${1:?--workdir needs a path}" ;;
    --workspace)        shift; target_ws="${1:?--workspace needs an id|ref}" ;;
    --new-workspace)    new_ws=1 ;;
    --report)           report=1 ;;   # default; kept for older callers
    --no-report)        report=0 ;;
    --)                 shift; prompt="$*"; break ;;
    *)                  die "unknown spawn arg: $1" ;;
  esac; shift || true; done
  [[ -n "${target_ws}" ]] && (( new_ws )) && die "--workspace and --new-workspace are mutually exclusive"
  if [[ "${agent}" == "codex" ]]; then
    # --approve-for-me (approvals_reviewer=auto_review): Codex's sandbox blocks
    # network, so every kubectl/gh/database read escalates; without this each
    # one waits on the user pressing y. The auto-reviewer approves escalations
    # it judges in-policy and asks the user only on rejection — Codex's
    # counterpart to Claude's auto mode. ~/.codex/hooks.json guard hooks still
    # run first (prod kubectl writes, database DDL, ...).
    agent_cmd="codex --approve-for-me"
    (( yolo )) && agent_cmd="codex --dangerously-bypass-approvals-and-sandbox"
    ready_marker="›"
  else
    agent_cmd="claude"; (( yolo )) && agent_cmd="claude --dangerously-skip-permissions"
    ready_marker="❯"
  fi
  # Same flag for both agents: claude --model <m> / codex -m <m>.
  if [[ -n "${model}" ]]; then
    [[ "${model}" =~ ^[A-Za-z0-9._:-]+$ ]] || die "--model must be a plain model name: ${model}"
    if [[ "${agent}" == "codex" ]]; then agent_cmd+=" -m ${model}"; else agent_cmd+=" --model ${model}"; fi
  fi

  if [[ -f "${STATE_DIR}/state/${slug}.env" ]]; then
    [[ "$(prune_if_dead "${STATE_DIR}/state/${slug}.env")" == pruned ]] \
      || die "sib '${slug}' already exists (sib kill ${slug} first)"
  fi

  # Completion contract (default on; --no-report or --worktree turns it off).
  # The sibling stays inside its task, hands findings outside it to the desk
  # with `brief note`, and reports to the desk (orch) when the task is done;
  # the desk cross-checks the report and closes the pane. This is what keeps
  # finished siblings from piling up and one session from absorbing many tasks.
  # It lives here, not in /dispatch, because callers often run sib directly.
  # --worktree siblings are /collab workers: the collab caller owns them.
  (( do_worktree )) && report=0
  if (( report )) && [[ -n "${prompt}" ]]; then
    prompt="${prompt}

--- completion contract (from sib) --- Scope: this session does one task — the one above; if it has a 'Done when:' line, that is where it ends. Anything you find outside it (unrelated bugs, docs to fix, follow-up ideas) you do not fix and do not list as remaining: register each with \`brief note \"<one line: what and where>\"\` and carry on. When the task is finished — or nothing is left that you can do without the user — report once and stay open: run \`git status --short\` and \`git log -3 --oneline\` in every directory you edited, then send \`brief report \"done-report: ready|not-ready ...\"\` with one line each: did / artifacts (absolute paths, commits, links) / uncommitted · unpushed / running (background jobs, pending questions) / remaining (what is left of this task, or none). Use not-ready when anything the user asked for is left undone. brief report finds the desk at send time and keeps the report even when no desk is open; only if the command itself is missing or errors, print the same report in this pane instead. Never close your own pane: the desk checks the report against reality and closes it."
  fi

  # Resolve the sibling's start directory.
  # Precedence: --worktree (managed checkout) wins over --workdir, which wins
  # over the caller's PWD. --worktree implies a git-managed path, so combining
  # it with --workdir is contradictory.
  if (( do_worktree )) && [[ -n "${workdir}" ]]; then
    die "--worktree manages its own path; do not combine with --workdir"
  fi
  # Default start dir: caller's PWD. An explicit --workdir wins. Failing that,
  # targeting an existing workspace (--workspace W) means "run where W lives" —
  # adopt W's cwd so the pane and the agent's directory agree. (Without this,
  # the pane lands in W but the agent starts in the caller's PWD.)
  start_dir="${PWD}"
  if [[ -n "${workdir}" ]]; then
    start_dir="${workdir}"
  elif [[ -n "${target_ws}" ]] && (( ! do_worktree )); then
    ws_cwd="$(workspace_cwd "${target_ws}")"
    [[ -n "${ws_cwd}" ]] && start_dir="${ws_cwd}"
  fi
  if (( do_worktree )); then
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not in a git repo (--worktree requires one)"
    repo="$(basename "$(git rev-parse --show-toplevel)")"
    wt="${WT_ROOT}/${repo}-${slug}"
    [[ -e "${wt}" ]] && die "worktree exists: ${wt}"
    git worktree add -b "sib/${slug}" "${wt}" "${base}" >/dev/null
    start_dir="${wt}"
  fi
  [[ -d "${start_dir}" ]] || die "start dir does not exist: ${start_dir}"
  # Claude keys trust by its physical cwd, so resolve symlinks first.
  trust=""
  if [[ "${agent}" == "claude" ]]; then
    trust="$(trust_allowlisted "$(cd "${start_dir}" && pwd -P)")"
  fi

  # A spawn that fails before its agent is launched and recorded removes the
  # workspace or pane it created — otherwise every failed --new-workspace
  # attempt left an empty workspace behind (11-24: three closed by hand).
  # Cleared once the state file is written: from then on `sib kill` owns it.
  cleanup_ws="" cleanup_surface=""
  spawn_cleanup() {
    local rc=$?
    (( rc == 0 )) && return 0
    if [[ -n "${cleanup_ws}" ]]; then
      cmux close-workspace --workspace "${cleanup_ws}" >/dev/null 2>&1 \
        || cmux close-workspace --workspace "${cleanup_ws}" --force >/dev/null 2>&1 \
        && echo "  closed workspace ${cleanup_ws} that this spawn created" >&2 \
        || echo "  could not close workspace ${cleanup_ws} that this spawn created — close it in cmux" >&2
    elif [[ -n "${cleanup_surface}" ]]; then
      cmux close-surface --surface "${cleanup_surface}" --workspace "${ws}" >/dev/null 2>&1 \
        || cmux close-surface --surface "${cleanup_surface}" --workspace "${ws}" --force >/dev/null 2>&1 \
        && echo "  closed pane ${cleanup_surface} that this spawn created" >&2 \
        || echo "  could not close pane ${cleanup_surface} that this spawn created — close it in cmux" >&2
    fi
    return 0
  }
  trap spawn_cleanup EXIT

  # A failed split must say why. Under `set -e` a bare `out="$(cmux ...)"`
  # exited 1 with cmux's message captured and never shown (11-23: a
  # workspace too full to split again ended the spawn with no output).
  split_failed() {
    [[ -n "$2" ]] && echo "$2" >&2
    die "cannot add a pane to workspace $1 — it may have no room for another split; close a pane there, or use --new-workspace"
  }
  # Place the sibling pane. Three modes:
  #   default        — split the caller's current workspace
  #   --workspace W  — split an already-open workspace W
  #   --new-workspace— create a dedicated workspace rooted at start_dir
  if (( new_ws )); then
    # cmux new-workspace --cwd boots a shell in start_dir; we then grab its
    # surface so the agent launch + later `sib send`/`kill` can target it.
    wsout="$(cmux new-workspace --name "sib-${slug}" --cwd "${start_dir}" --focus false 2>&1)" \
      || { echo "${wsout}" >&2; die "failed to create workspace"; }
    ws="$(first_ref workspace <<<"${wsout}")"
    [[ -n "${ws}" ]] || { echo "${wsout}" >&2; die "failed to create workspace"; }
    cleanup_ws="${ws}"
    # A fresh workspace may not answer for its surface at once (under load
    # cmux returns not_found for a moment): retry for ~3s, then say why.
    surface="" lsout=""
    for i in $(seq 1 12); do
      lsout="$(cmux list-pane-surfaces --workspace "${ws}" 2>&1)" \
        && surface="$(first_ref surface <<<"${lsout}")"
      [[ -n "${surface}" ]] && break
      sleep 0.25
    done
    [[ -n "${surface}" ]] || { echo "${lsout}" >&2; die "created workspace ${ws} but found no surface in it"; }
  elif [[ -n "${target_ws}" ]]; then
    ws="${target_ws}"
    out="$(cmux new-split right --workspace "${ws}" --focus false 2>&1)" || split_failed "${ws}" "${out}"
    surface="$(first_ref surface <<<"${out}")"
    [[ -n "${surface}" ]] || split_failed "${ws}" "${out}"
    cleanup_surface="${surface}"
  else
    ws="${CMUX_WORKSPACE_ID}"
    out="$(cmux new-pane --type terminal --direction right --workspace "${ws}" 2>&1)" || split_failed "${ws}" "${out}"
    surface="$(first_ref surface <<<"${out}")"
    [[ -n "${surface}" ]] || split_failed "${ws}" "${out}"
    cleanup_surface="${surface}"
  fi

  # Launch the agent directly in the new pane (exec → closing pane ends it; no zmx).
  # A failed launch must say why (and the cleanup trap closes the pane).
  # shellcheck disable=SC2015  # the || branch is meant for either send failing
  out="$(cmux send --surface "${surface}" --workspace "${ws}" "cd $(printf %q "${start_dir}") && exec ${agent_cmd}" 2>&1)" \
    && out="$(cmux send-key --surface "${surface}" --workspace "${ws}" enter 2>&1)" \
    || { [[ -n "${out}" ]] && echo "${out}" >&2; die "could not start ${agent} in ${ws} ${surface}"; }

  # Record who spawned this sibling (the caller's own pane, from cmux
  # identify). Gives "reply to my spawner" a deterministic address —
  # /pane-msg's pane-resolve.sh resolves it via --spawner-of <slug>.
  # Best-effort: empty when jq or identify is unavailable.
  spawner_surface="" spawner_workspace=""
  if command -v jq >/dev/null 2>&1; then
    ident="$(cmux identify --json 2>/dev/null || true)"
    spawner_surface="$(jq -r '.caller.surface_ref // empty' <<<"${ident}" 2>/dev/null || true)"
    spawner_workspace="$(jq -r '.caller.workspace_ref // empty' <<<"${ident}" 2>/dev/null || true)"
  fi

  # Persist state. `worktree=` keeps its historical name (it is the sibling's
  # start dir whether or not a worktree was created); `worktree_managed`
  # records whether sib owns a git worktree to clean up on kill. `workdir=`
  # records the resolved start dir explicitly for newer consumers.
  { echo "slug=${slug}"; echo "agent=${agent}";
    echo "surface=${surface}"; echo "workspace=${ws}"; echo "worktree=${start_dir}";
    echo "workdir=${start_dir}"; echo "worktree_managed=${do_worktree}";
    echo "workspace_managed=${new_ws}";
    echo "spawner_surface=${spawner_surface}";
    echo "spawner_workspace=${spawner_workspace}"; } > "${STATE_DIR}/state/.${slug}.env.tmp"
  # Atomic: a concurrent `sib list` must never read a half-written file
  # (an empty surface= reads as "pane gone" and the state was pruned).
  mv -f "${STATE_DIR}/state/.${slug}.env.tmp" "${STATE_DIR}/state/${slug}.env"
  cleanup_ws="" cleanup_surface=""

  # Wait for the agent's own input box. Matching the marker anywhere on screen
  # is not enough: a shell prompt can use the same glyph (starship's default
  # `❯`), so the old check fired on the pane's shell before `exec` took over.
  # Text typed then lands in a pty still in canonical mode, which caps a
  # pending line at MAX_CANON (1024 bytes on macOS): the prompt was cut at
  # 1024 bytes and the submit enter was dropped (2026-10-29 incident). So
  # require the marker at line start, plus claude's input-box rule line.
  agent_ui_ready() {
    local scr
    scr="$(cmux read-screen --surface "${surface}" --workspace "${ws}" --lines 60 2>/dev/null)" || return 1
    if [[ "${agent}" == "codex" ]]; then
      # Not a numbered option ('› 1. Update now'): that is a start-screen list.
      grep -qE "^[[:space:]]*${ready_marker}[[:space:]]*(\$|[^[:space:]0-9]|[0-9]+([^.0-9]|\$))" <<<"${scr}"
    else
      # (claude follows the marker with U+00A0, not a space — anchor only.)
      grep -q "^${ready_marker}" <<<"${scr}" && grep -qF '──────────' <<<"${scr}"
    fi
  }
  # A start screen that blocks the pane until a human answers it. Prints its
  # name. Claude: the folder-trust dialog. Codex: the update screen and the
  # hooks-review screen. Each is an option list drawn with the input box's
  # own marker, and any key picks an option: Enter on the update screen runs
  # `brew upgrade` and ends the pane; on the hooks screen it may trust hooks.
  start_screen() {
    local scr
    scr="$(cmux read-screen --surface "${surface}" --workspace "${ws}" --lines 60 2>/dev/null)" || return 1
    if [[ "${agent}" == "claude" ]]; then
      grep -qiE 'trust this folder|do you trust the files' <<<"${scr}" && { echo trust; return 0; }
    else
      grep -qF 'Update available' <<<"${scr}" && grep -qE 'Update now|Skip until next version' <<<"${scr}" \
        && { echo "update screen (Update available: Update now / Skip)"; return 0; }
      grep -qE 'Hooks need review|Trust all and continue' <<<"${scr}" \
        && { echo "hooks-review screen (Hooks need review: Trust all / Continue without trusting)"; return 0; }
    fi
    return 1
  }
  booted=0; trust_blocked=0; blocked_by=""
  for i in $(seq 1 70); do
    # Start screens first: their option list starts with the input marker and
    # may sit under a rule line, so it can look like the input box.
    if blocked_by="$(start_screen)"; then
      [[ "${blocked_by}" == trust ]] && trust_blocked=1
      break
    fi
    if agent_ui_ready; then
      booted=1; break
    fi
    # Adaptive poll: fast (~1s total) at first so a quick boot is caught almost
    # immediately, then back off to 0.5s (≈30s ceiling) for a slow cold start.
    if (( i <= 10 )); then sleep 0.1; else sleep 0.5; fi
  done
  if (( trust_blocked )); then
    echo "✗ sib '${slug}' (${agent}) → ${ws} ${surface} — waiting at Claude's trust-folder dialog" >&2
    echo "  ${start_dir} is not in ${SIB_TRUST_FILE}; confirm in the pane, or add it there (user decision)" >&2
    [[ -n "${prompt}" ]] && echo "  prompt not sent; after confirming: sib send ${slug} \"...\"" >&2
    exit 6
  fi
  if [[ -n "${blocked_by}" ]]; then
    echo "✗ sib '${slug}' (${agent}) → ${ws} ${surface} — waiting at Codex's ${blocked_by}" >&2
    echo "  no key was sent to it; answer it in the pane (user decision) — the pane stays open" >&2
    [[ -n "${prompt}" ]] && echo "  prompt not sent; after answering: sib send ${slug} \"...\"" >&2
    exit 6
  fi
  delivery=""
  if [[ -n "${prompt}" ]] && (( ! booted )); then
    # Typing into a pane whose agent never drew its input box is the
    # truncation path above — do not. The pane stays up for a manual retry.
    delivery="not sent: agent input box never appeared (~30s)"
  elif [[ -n "${prompt}" ]]; then
    # The first prompt goes through the one deliverer, like every later
    # message (docs/agent-control-one-path.md §5 step 3): same landed check,
    # same submit check. It stays inline (no file pointer): it is the task.
    # --queue: a fresh session's own start-up work must not block its task.
    deliver="$(deliverer)" || die "pane-deliver.sh not found (L1 install: skills/pane-msg)"
    if out="$(PANE_DELIVER_INLINE_MAX=1000000 "${deliver}" --surface "${surface}" --workspace "${ws}" \
                --queue -- "${prompt}" 2>&1)"; then
      :
    else
      rc=$?
      why="$(grep -E '^(UNCONFIRMED|REFUSED|pane-deliver):' <<<"${out}" | tail -1)"
      why="${why:-$(tail -1 <<<"${out}")}"
      delivery="${why#UNCONFIRMED: }"
      (( rc == 5 )) || delivery="not sent (pane-deliver exit ${rc}): ${why}"
    fi
  fi

  if [[ -n "${delivery}" ]]; then
    echo "✗ sib '${slug}' (${agent}) → ${ws} ${surface} — prompt ${delivery}" >&2
    echo "  retry: sib send ${slug} \"...\"   or  sib kill ${slug}" >&2
    exit 5
  fi
  echo "✓ sib '${slug}' (${agent}) → ${ws} ${surface} $([[ ${booted} == 1 ]] && echo '[booted]' || echo '[booting…]')"
  echo "  workdir: ${start_dir}$( (( new_ws )) && echo '  (dedicated workspace)'; (( do_worktree )) && echo '  (worktree)')"
  [[ "${trust}" == added ]] && echo "  trust: pre-trusted from ${SIB_TRUST_FILE}"
  echo "  talk: focus the pane, or  sib send ${slug} \"...\""
  ;;

list)
  shopt -s nullglob
  printf '%-16s %-8s %-12s %s\n' SLUG AGENT SURFACE WORKTREE
  for f in "${STATE_DIR}"/state/*.env; do
    case "$(prune_if_dead "$f" grace)" in
      pruned) echo "  (pruned $(basename "$f" .env): pane gone)" >&2; continue ;;
    esac
    ( load_state "$f"; st=$(surface_alive "${surface}" "${workspace}" && echo up || echo dead)
      printf '%-16s %-8s %-12s %s (%s)\n' "$slug" "$agent" "$surface" "$worktree" "$st" )
  done
  ;;

send)
  slug="${1:?sib send <slug> [--queue] <text>}"; shift
  queue_flag=""
  [[ "${1:-}" == "--queue" ]] && { queue_flag="--queue"; shift; }
  f="${STATE_DIR}/state/${slug}.env"; [[ -f "$f" ]] || die "no such sib: ${slug}"
  load_state "$f"
  surface_alive "${surface}" "${workspace}" || die "sib '${slug}' pane is gone (sib kill ${slug} to clean up)"
  # The one deliverer (no plain-send fallback: a second path skips the
  # busy/approval gates and the landed and submit checks). A busy pane is
  # REFUSED (exit 4) unless --queue.
  deliver="$(deliverer)" || die "pane-deliver.sh not found (L1 install: skills/pane-msg)"
  echo "→ ${slug}:"
  # shellcheck disable=SC2086  # queue_flag is intentionally word-split (one optional flag)
  exec "${deliver}" --surface "${surface}" --workspace "${workspace}" ${queue_flag} -- "$*"
  ;;

kill)
  slug="${1:?sib kill <slug>}"; shift
  keep_wt=0; [[ "${1:-}" == "--keep-worktree" ]] && keep_wt=1
  f="${STATE_DIR}/state/${slug}.env"; [[ -f "$f" ]] || die "no such sib: ${slug}"
  load_state "$f"
  # The pane's id (the panel id `brief` keys its close records by), read while the pane is still open.
  panel=""
  if command -v jq >/dev/null 2>&1; then
    panel="$(cmux rpc surface.list "{\"workspace_id\":\"${workspace}\"}" 2>/dev/null \
      | jq -r --arg r "${surface}" '.surfaces[]? | select(.ref == $r) | .id' 2>/dev/null | head -1 || true)"
  fi
  # End the agent by tearing down its surface. A sib-created dedicated
  # workspace holds only this one surface, and cmux refuses to close the last
  # surface — close the whole workspace instead. Otherwise just close the pane.
  # cmux asks for confirmation before closing a surface with a live process
  # (`confirmation_required`); kill is that confirmation, so retry with
  # `--force` (a bare flag — cmux rejects `--force true` as an unexpected
  # argument, which made the retry a silent no-op). Then verify, so a swallowed close error never
  # reports `✓ killed` while the agent pane is still open.
  if (( workspace_managed )); then
    cmux close-workspace --workspace "${workspace}" >/dev/null 2>&1 \
      || cmux close-workspace --workspace "${workspace}" --force >/dev/null 2>&1 || true
    cmux workspace list 2>/dev/null | grep -qwF -- "${workspace}" \
      && die "workspace ${workspace} is still open — state kept; close it in cmux, then re-run sib kill ${slug}"
  else
    cmux close-surface --surface "${surface}" --workspace "${workspace}" >/dev/null 2>&1 \
      || cmux close-surface --surface "${surface}" --workspace "${workspace}" --force >/dev/null 2>&1 || true
    surface_alive "${surface}" "${workspace}" \
      && die "pane ${surface} is still open — state kept; close it in cmux, then re-run sib kill ${slug}"
  fi
  if (( worktree_managed )) && (( ! keep_wt )); then
    git worktree remove --force "${worktree}" 2>/dev/null || true
    git branch -D "sib/${slug}" 2>/dev/null || true
  fi
  # The caller closed its worker: record it so `brief audit` does not count this close against the user
  # or the desk as a pane closed without a report. Best-effort: a failed write never fails the kill.
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg slug "${slug}" --arg panel "${panel}" --arg surface "${surface}" --arg workspace "${workspace}" \
      --arg workdir "${worktree:-}" --arg by "${CMUX_PANEL_ID:-}" --argjson at "$(date +%s)" \
      '{at: $at, slug: $slug, panel: $panel, surface: $surface, workspace: $workspace, workdir: $workdir, by: $by}' \
      >> "${STATE_DIR}/killed.jsonl" 2>/dev/null || true
  fi
  rm -f "$f"
  echo "✓ killed ${slug}"
  ;;

*)
  usage >&2; exit 1 ;;
esac
