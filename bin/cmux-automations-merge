#!/usr/bin/env python3
"""cmux-automations-merge — merge a layer's automation rules into ~/.cmuxterm/automations.json.

cmux reads a single automations file, but rules come from several layers
(L1 agent-framework, dotfiles, L2 persona). Each layer ships a fragment
({"version": 1, "rules": [...]}) and merges it by rule id: rules with the
same id are replaced in place, new ids are appended, every other rule is
left untouched. Re-running is a no-op.

Usage:
  cmux-automations-merge <fragment.json> [--target PATH] [--dry-run]
  cmux-automations-merge --remove <id> [<id> ...] [--target PATH]

If the target is a symlink (legacy: dotfiles linked its whole file), its
content is read and the link is replaced by a regular file.
"""
import json
import os
import sys
import tempfile

DEFAULT_TARGET = os.path.expanduser("~/.cmuxterm/automations.json")


def load(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        return {"version": 1, "rules": []}
    if not isinstance(data.get("rules"), list):
        sys.exit(f"[automations-merge] {path}: no 'rules' array")
    return data


def write(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.islink(path):
        os.unlink(path)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".automations.")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def main(argv):
    target, dry, remove, fragment = DEFAULT_TARGET, False, None, None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--target" and i + 1 < len(argv):
            target = argv[i + 1]
            i += 1
        elif a == "--dry-run":
            dry = True
        elif a == "--remove":
            remove = []
            while i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                remove.append(argv[i + 1])
                i += 1
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        elif a.startswith("--"):
            print(f"[automations-merge] unknown flag: {a}", file=sys.stderr)
            return 1
        else:
            fragment = a
        i += 1
    target = os.path.abspath(os.path.expanduser(target))
    if remove is None and not fragment:
        print(__doc__, file=sys.stderr)
        return 1

    data = load(target)
    rules = data["rules"]
    if remove is not None:
        before = len(rules)
        data["rules"] = [r for r in rules if r.get("id") not in remove]
        changed = len(data["rules"]) != before
    else:
        incoming = load(fragment)["rules"]
        index = {r.get("id"): i for i, r in enumerate(rules)}
        changed = False
        for rule in incoming:
            rid = rule.get("id")
            if not rid:
                sys.exit(f"[automations-merge] {fragment}: rule without id")
            if rid in index:
                if rules[index[rid]] != rule:
                    rules[index[rid]] = rule
                    changed = True
            else:
                index[rid] = len(rules)
                rules.append(rule)
                changed = True

    if not changed and not os.path.islink(target) and os.path.exists(target):
        print(f"[automations-merge] {target}: already current")
        return 0
    if dry:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return 0
    write(target, data)
    print(f"[automations-merge] {target}: updated")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
